<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/ad-slot', { slotId: 'top-leaderboard' }) %>

<div class="wrap layout">
  <main id="main">
    <div class="article" style="padding:0;overflow:hidden">
      <div style="background:var(--ink);color:#fff;padding:14px 20px;display:flex;align-items:center;gap:10px">
        <span class="pill-live"><i></i> <%= locale === 'en' ? 'LIVE' : 'লাইভ' %></span>
        <b><%= locale === 'en' ? 'NewsPulse 24 — Live broadcast' : 'নিউজপালস ২৪ — সরাসরি সম্প্রচার' %></b>
      </div>
      <% if (embed) { %>
        <iframe data-src="<%= embed %>" title="NewsPulse 24 Live" style="width:100%;aspect-ratio:16/9;border:0"
                allow="accelerometer; clipboard-write; encrypted-media; picture-in-picture" allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"></iframe>
      <% } else { %>
        <div style="aspect-ratio:16/9;display:grid;place-items:center;background:linear-gradient(135deg,var(--ink-2),var(--red-700));color:#fff;text-align:center;padding:20px">
          <div>
            <p style="font-size:18px;margin:0 0 6px"><%= locale === 'en' ? 'Live stream is not configured yet.' : 'লাইভ সম্প্রচার এখনো যুক্ত করা হয়নি।' %></p>
            <p class="muted small" style="margin:0"><%= locale === 'en' ? 'Add the stream URL in Admin → Settings → Live TV.' : 'অ্যাডমিন → সেটিংস → লাইভ টিভি-তে লিংক যুক্ত করুন।' %></p>
          </div>
        </div>
      <% } %>
    </div>

    <%- include('partials/ad-slot', { slotId: 'after-article' }) %>

    <% if (trending.length) { %>
      <div class="section-head"><h2><%= locale === 'en' ? 'Also happening now' : 'এখন যা ঘটছে' %></h2></div>
      <div class="grid grid--3">
        <% trending.forEach(function (a) { %>
          <%- include('partials/article-card', { a: a, isCompact: true }) %>
        <% }); %>
      </div>
    <% } %>
  </main>

  <aside class="sidebar">
    <%- include('partials/ad-slot', { slotId: 'sidebar-top' }) %>
    <div class="widget">
      <div class="widget__head">📺 <%= locale === 'en' ? 'Watch & subscribe' : 'দেখুন ও সাবস্ক্রাইব' %></div>
      <div class="widget__body">
        <p class="small muted" style="margin-top:0"><%= locale === 'en' ? 'Never miss a bulletin — subscribe on YouTube and follow us for breaking alerts.' : 'কোনো বুলেটিন মিস করবেন না — ইউটিউবে সাবস্ক্রাইব করুন।' %></p>
        <div class="row" style="gap:8px">
          <% if (site.youtube_url) { %><a class="btn" href="<%= h.safeUrl(site.youtube_url) %>" target="_blank" rel="noopener">YouTube</a><% } %>
          <% if (site.facebook_url) { %><a class="btn btn--ghost" href="<%= h.safeUrl(site.facebook_url) %>" target="_blank" rel="noopener">Facebook</a><% } %>
        </div>
      </div>
    </div>
    <%- include('partials/ad-slot', { slotId: 'sidebar-sticky' }) %>
  </aside>
</div>

<%- include('partials/footer') %>
