<%
  const now = new Date(Date.now() + 6 * 3600 * 1000);
  const bnMonths = ['জানুয়ারি','ফেব্রুয়ারি','মার্চ','এপ্রিল','মে','জুন','জুলাই','আগস্ট','সেপ্টেম্বর','অক্টোবর','নভেম্বর','ডিসেম্বর'];
  const bnDays = ['রবিবার','সোমবার','মঙ্গলবার','বুধবার','বৃহস্পতিবার','শুক্রবার','শনিবার'];
  const toBn = (s) => String(s).replace(/\d/g, (d) => '০১২৪৫৬৭৮৯'[d]);
  const dateBn = bnDays[now.getUTCDay()] + ', ' + toBn(now.getUTCDate()) + ' ' + bnMonths[now.getUTCMonth()] + ' ' + toBn(now.getUTCFullYear());
  const dateEn = now.toUTCString().split(' 00:')[0];
  const hh = now.getUTCHours() % 12 || 12;
  const mm = String(now.getUTCMinutes()).padStart(2, '0');
  const ampm = now.getUTCHours() < 12 ? 'AM' : 'PM';
  const timeStr = toBn(hh) + ':' + toBn(mm) + ' ' + ampm;
%>

<header class="masthead">
  <div class="wrap masthead__in">
    <a class="brand" href="/" aria-label="<%= site.site_name_en %>">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6">
          <circle cx="12" cy="12" r="9"/>
          <path d="M3 12h18M12 3c2.6 2.6 3.9 5.7 3.9 9S14.6 18.4 12 21c-2.6-2.6-3.9-5.7-3.9-9S9.4 5.6 12 3z"/>
        </svg>
      </span>
      <span class="brand__text">
        <span class="brand__name">News<span>Pulse</span> <em>24</em></span>
        <span class="brand__sub"><%= locale === 'en' ? site.tagline_en : site.tagline_bn %></span>
      </span>
    </a>

    <form class="masthead__search" id="searchForm" role="search" action="/search" method="get">
      <label class="sr-only" for="siteSearch"><%= locale === 'en' ? 'Search news' : 'সংবাদ খুঁজুন' %></label>
      <input id="siteSearch" name="q" type="search" placeholder="<%= locale === 'en' ? 'Search news, topics, people…' : 'সংবাদ, বিষয়, মানুষ খুঁজুন…' %>" autocomplete="off">
      <button type="submit" aria-label="<%= locale === 'en' ? 'Search' : 'খুঁজুন' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      </button>
    </form>

    <div class="masthead__right">
      <button class="icon-btn" id="themeToggle" type="button" aria-label="Toggle theme">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>

      <a class="icon-btn bell" href="/live" aria-label="<%= locale === 'en' ? 'Live and alerts' : 'লাইভ ও নোটিফিকেশন' %>">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 8-3 8h18s-3-1-3-8"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
        <i class="bell__dot" aria-hidden="true"></i>
      </a>

      <a class="signin hide-sm" href="/admin/login"><%= locale === 'en' ? 'Sign In' : 'সাইন ইন' %></a>
      <a class="btn-admin" href="#newsletter"><%= locale === 'en' ? 'Subscribe' : 'সাবস্ক্রাইব' %></a>

      <button class="icon-btn burger" id="burger" type="button" aria-label="Menu" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>

<nav class="navbar" aria-label="Primary">
  <div class="wrap">
    <div class="navbar__in">
      <a class="navbar__home" href="/" <%= currentPath === '/' ? 'aria-current="page"' : '' %>>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3l9 8h-3v9h-5v-6H11v6H6v-9H3z"/></svg>
        <%= locale === 'en' ? 'Home' : 'প্রচ্ছদ' %>
      </a>
      <% categories.forEach(function (c) { %>
      <a href="/category/<%= c.slug %>" <%= currentPath === '/category/' + c.slug ? 'aria-current="page"' : '' %>><%= locale === 'en' ? c.name_en : c.name_bn %></a>
      <% }); %>
      <a class="navbar__live" href="/live" <%= currentPath === '/live' ? 'aria-current="page"' : '' %>>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="2" fill="currentColor"/><path d="M7.8 16.2a6 6 0 0 1 0-8.4M16.2 7.8a6 6 0 0 1 0 8.4M4.9 19.1a10 10 0 0 1 0-14.2M19.1 4.9a10 10 0 0 1 0 14.2"/></svg>
        <%= locale === 'en' ? 'Live TV' : 'লাইভ টিভি' %>
      </a>
    </div>
  </div>
</nav>

<% if (tickerEnabled && ticker && ticker.length) { %>
<div class="ticker" role="region" aria-label="<%= locale === 'en' ? 'Breaking news ticker' : 'ব্রেকিং নিউজ' %>">
  <span class="ticker__label"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/></svg> <%= locale === 'en' ? 'BREAKING' : 'ব্রেকিং' %></span>
  <div class="ticker__viewport">
    <div class="ticker__track" data-duration="<%= site.ticker_speed || 45 %>">
      <% ticker.forEach(function (t) { %>
      <a href="<%= t.slug ? '/news/' + t.slug : '#' %>">
        <% const cat = locale === 'en' ? (t.category_en || t.category_bn) : t.category_bn; %>
        <% if (cat) { %><span class="tag"><%= cat %></span><% } %>
        <%= locale === 'en' ? (t.text_en || t.text_bn) : (t.text_bn || t.text_en) %>
      </a>
      <% }); %>
      <%# Rendered twice for a seamless infinite loop. %>
      <% ticker.forEach(function (t) { %>
      <a href="<%= t.slug ? '/news/' + t.slug : '#' %>" aria-hidden="true" tabindex="-1">
        <% const cat = locale === 'en' ? (t.category_en || t.category_bn) : t.category_bn; %>
        <% if (cat) { %><span class="tag"><%= cat %></span><% } %>
        <%= locale === 'en' ? (t.text_en || t.text_bn) : (t.text_bn || t.text_en) %>
      </a>
      <% }); %>
    </div>
  </div>
  <span class="ticker__date hide-sm"><%= locale === 'en' ? dateEn : dateBn %> <i>|</i> <%= timeStr %></span>
</div>
<% } %>
