<%- include('_shell-open') %>

<div class="grid-side">
  <div>
    <div class="panel">
      <div class="panel__head">👤 <%= locale === 'en' ? 'My account' : 'আমার অ্যাকাউন্ট' %></div>
      <div class="panel__body">
        <div class="row" style="gap:14px">
          <span class="article__author" style="gap:12px"><span class="avatar" style="width:52px;height:52px;font-size:20px"><%= String(account.name).slice(0, 1).toUpperCase() %></span></span>
          <div>
            <b><%= account.name %></b>
            <div class="small muted"><%= account.email %></div>
            <div class="row" style="gap:6px;margin-top:6px">
              <span class="tag tag--ink"><%= roles[account.role] ? roles[account.role].label : account.role %></span>
              <span class="tag tag--<%= account.two_factor_on ? 'ok' : 'warn' %>">2FA <%= account.two_factor_on ? (locale === 'en' ? 'on' : 'চালু') : (locale === 'en' ? 'off' : 'বন্ধ') %></span>
              <% if (account.last_login_at) { %><span class="tag"><%= locale === 'en' ? 'last login' : 'শেষ লগইন' %> <%= h.timeAgo(account.last_login_at, locale) %> <%= account.last_login_ip || '' %></span><% } %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="panel">
      <div class="panel__head">🔑 <%= locale === 'en' ? 'Change password' : 'পাসওয়ার্ড পরিবর্তন' %></div>
      <div class="panel__body">
        <form method="post" action="/admin/account/password">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field"><label for="current"><%= locale === 'en' ? 'Current password' : 'বর্তমান পাসওয়ার্ড' %></label><input id="current" name="current" type="password" required autocomplete="current-password"></div>
          <div class="field"><label for="next"><%= locale === 'en' ? 'New password' : 'নতুন পাসওয়ার্ড' %></label><input id="next" name="next" type="password" required autocomplete="new-password" minlength="10">
            <span class="hint"><%= locale === 'en' ? 'Minimum 10 characters with a letter and a number. Changing it signs out every other device.' : 'কমপক্ষে ১০ অক্ষর, অক্ষর ও সংখ্যা। বদলালে অন্য সব ডিভাইস থেকে লগআউট হবে।' %></span>
          </div>
          <button class="btn" type="submit"><%= locale === 'en' ? 'Update password' : 'পাসওয়ার্ড হালনাগাদ' %></button>
        </form>
      </div>
    </div>

    <div class="panel">
      <div class="panel__head">🛡 <%= locale === 'en' ? 'Two-factor authentication' : 'টু-ফ্যাক্টর অথেনটিকেশন' %></div>
      <div class="panel__body">
        <% if (account.two_factor_on) { %>
          <p class="tag tag--ok" style="display:inline-block;margin-bottom:12px">✓ <%= locale === 'en' ? '2FA is enabled on this account' : 'এই অ্যাকাউন্টে ২এফএ চালু আছে' %></p>
          <form method="post" action="/admin/account/2fa/disable">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field"><label for="disablePw"><%= locale === 'en' ? 'Confirm with your password' : 'পাসওয়ার্ড দিয়ে নিশ্চিত করুন' %></label><input id="disablePw" name="current" type="password" required autocomplete="current-password"></div>
            <button class="btn btn--danger btn--sm" type="submit"><%= locale === 'en' ? 'Disable 2FA' : '২এফএ বন্ধ করুন' %></button>
          </form>
        <% } else { %>
          <p class="small" style="margin-top:0"><%= locale === 'en' ? 'Add a second factor with any authenticator app (Google Authenticator, Authy, 1Password).' : 'যেকোনো অথেনটিকেটর অ্যাপ দিয়ে দ্বিতীয় স্তর যোগ করুন।' %></p>

          <% if (otpauthUrl) { %>
            <ol class="small" style="line-height:2;padding-left:18px">
              <li><%= locale === 'en' ? 'Add this secret to your authenticator app:' : 'এই সিক্রেট অ্যাপে যোগ করুন:' %><br><code style="font-size:15px;letter-spacing:.12em" data-copy="<%= pendingSecret %>"><%= pendingSecret %></code> <button class="btn btn--ghost btn--sm" type="button" data-copy="<%= pendingSecret %>"><%= locale === 'en' ? 'Copy' : 'কপি' %></button></li>
              <li><%= locale === 'en' ? 'Or open this link on your phone:' : 'অথবা ফোনে এই লিংক খুলুন:' %><br><input readonly value="<%= otpauthUrl %>" style="width:100%;font-size:11px;padding:6px;border:1px solid var(--line);border-radius:6px"></li>
              <li><%= locale === 'en' ? 'Store the secret, then confirm with a code below.' : 'সিক্রেট সংরক্ষণ করুন, তারপর নিচে কোড দিয়ে নিশ্চিত করুন।' %></li>
            </ol>
            <form method="post" action="/admin/account/2fa/setup">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="secret" value="<%= pendingSecret %>">
              <button class="btn btn--ghost btn--sm" type="submit"><%= locale === 'en' ? '1. Store this secret' : '১. সিক্রেট সংরক্ষণ' %></button>
            </form>
            <form method="post" action="/admin/account/2fa/enable" class="row" style="gap:8px;margin-top:10px">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input name="token" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="000000" required style="width:130px;padding:8px 11px;border:1px solid var(--line);border-radius:7px;text-align:center;letter-spacing:.3em;font-family:var(--font-en)">
              <button class="btn btn--sm" type="submit"><%= locale === 'en' ? '2. Verify & enable' : '২. যাচাই ও চালু' %></button>
            </form>
          <% } else { %>
            <a class="btn" href="?setup2fa=1"><%= locale === 'en' ? 'Set up 2FA' : '২এফএ সেটআপ শুরু' %></a>
          <% } %>
        <% } %>
        <p class="small muted" style="margin-top:12px">
          <%= locale === 'en'
            ? 'Implemented directly on node:crypto (RFC 6238, SHA-1, 30 s, 6 digits) — no third-party 2FA dependency to audit.'
            : 'সরাসরি node:crypto দিয়ে বাস্তবায়িত (RFC 6238, SHA-1, ৩০ সে., ৬ সংখ্যা) — কোনো থার্ড-পার্টি ২এফএ লাইব্রেরি নেই।' %>
        </p>
      </div>
    </div>
  </div>

  <div>
    <div class="panel">
      <div class="panel__head">🖥 <%= locale === 'en' ? 'My sessions' : 'আমার সেশন' %></div>
      <div class="panel__body tight table-wrap">
        <table class="tbl">
          <tbody>
            <% sessions.forEach(function (s) { %>
              <tr>
                <td>
                  <div class="small"><%= (s.user_agent || '').slice(0, 46) %></div>
                  <div class="small muted"><%= locale === 'en' ? 'active' : 'সক্রিয়' %> <%= h.timeAgo(s.last_seen_at, locale) %><% if (s.id === undefined) { %><% } %></div>
                </td>
              </tr>
            <% }); %>
            <% if (!sessions.length) { %><tr><td class="muted">—</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="panel">
      <div class="panel__head">🧭 <%= locale === 'en' ? 'What I can do' : 'আমার অনুমতি' %></div>
      <div class="panel__body small">
        <% (roles[account.role] ? roles[account.role].permissions : []).forEach(function (p) { %>
          <span class="tag" style="margin:0 4px 6px 0"><%= p %></span>
        <% }); %>
      </div>
    </div>
  </div>
</div>

<%- include('_shell-close') %>
