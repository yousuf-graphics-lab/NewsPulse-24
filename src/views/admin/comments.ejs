<%- include('_shell-open') %>

<div class="panel">
  <div class="panel__head">
    💬 <%= locale === 'en' ? 'Comment moderation' : 'মন্তব্য পর্যালোচনা' %>
    <span class="spacer"></span>
    <% counts.forEach(function (c) { %>
      <a class="tag tag--<%= c.status === status ? 'red' : c.status === 'approved' ? 'ok' : 'warn' %>" href="?status=<%= c.status %>"><%= c.status %>: <%= h.bnNumber(c.n) %></a>
    <% }); %>
  </div>
  <div class="panel__body tight table-wrap">
    <table class="tbl">
      <thead><tr>
        <th><%= locale === 'en' ? 'Comment' : 'মন্তব্য' %></th>
        <th><%= locale === 'en' ? 'Story' : 'সংবাদ' %></th>
        <th><%= locale === 'en' ? 'From' : 'উৎস' %></th>
        <th><%= locale === 'en' ? 'When' : 'সময়' %></th>
        <th></th>
      </tr></thead>
      <tbody>
        <% rows.forEach(function (c) { %>
          <tr>
            <td style="max-width:420px">
              <b><%= c.name %></b><% if (c.email) { %> <span class="small muted">(<%= c.email %>)</span><% } %>
              <p class="small" style="margin:4px 0 0"><%- c.body %></p>
            </td>
            <td><a href="/news/<%= c.slug %>" target="_blank" rel="noopener" class="small"><%= c.title_bn.slice(0, 40) %>…</a></td>
            <td class="small muted"><%= c.country || '—' %><br><span title="<%= c.user_agent %>"><%= (c.user_agent || '').slice(0, 22) %>…</span></td>
            <td class="small muted"><%= h.timeAgo(c.created_at, locale) %></td>
            <td class="actions">
              <% if (c.status !== 'approved') { %>
                <form method="post" action="/admin/comments/<%= c.id %>/status" style="display:inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="approved">
                  <button class="btn btn--ok btn--sm" type="submit"><%= locale === 'en' ? 'Approve' : 'অনুমোদন' %></button>
                </form>
              <% } %>
              <% if (c.status !== 'spam') { %>
                <form method="post" action="/admin/comments/<%= c.id %>/status" style="display:inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="spam">
                  <button class="btn btn--ghost btn--sm" type="submit"><%= locale === 'en' ? 'Spam' : 'স্প্যাম' %></button>
                </form>
              <% } %>
              <% if (c.status !== 'rejected') { %>
                <form method="post" action="/admin/comments/<%= c.id %>/status" style="display:inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="rejected">
                  <button class="btn btn--danger btn--sm" type="submit"><%= locale === 'en' ? 'Reject' : 'বাতিল' %></button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
        <% if (!rows.length) { %><tr><td colspan="5" class="muted"><%= locale === 'en' ? 'Nothing in this queue.' : 'এই সারিতে কিছু নেই।' %></td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('_shell-close') %>
