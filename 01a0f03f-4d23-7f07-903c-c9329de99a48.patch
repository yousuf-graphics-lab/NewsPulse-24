+        </div>
+      </div>
+
+<%- include('_shell-close') %>
diff --git a/src/views/admin/articles.ejs b/src/views/admin/articles.ejs
new file mode 100644
index 0000000..8a81870
--- /dev/null
+++ b/src/views/admin/articles.ejs
@@ -0,0 +1,82 @@
+<%- include('_shell-open') %>
+
+<div class="panel">
+  <div class="panel__head">
+    📰 <%= locale === 'en' ? 'All stories' : 'সব সংবাদ' %>
+    <span class="sub"><%= h.bnNumber(total) %> <%= locale === 'en' ? 'total' : 'টি' %></span>
+    <span class="spacer"></span>
+    <% if (can('article.create')) { %><a class="btn btn--sm" href="/admin/articles/new">+ <%= locale === 'en' ? 'New story' : 'নতুন সংবাদ' %></a><% } %>
+  </div>
+  <div class="panel__body">
+    <form method="get" class="row" style="gap:8px;margin-bottom:14px">
+      <input type="search" name="q" value="<%= q %>" placeholder="<%= locale === 'en' ? 'Search headline…' : 'শিরোনাম খুঁজুন…' %>" style="flex:1;padding:8px 11px;border:1px solid var(--line);border-radius:7px">
+      <select name="status" style="padding:8px 11px;border:1px solid var(--line);border-radius:7px">
+        <option value=""><%= locale === 'en' ? 'All statuses' : 'সব স্ট্যাটাস' %></option>
+        <% ['draft', 'pending', 'published', 'archived'].forEach(function (s) { %>
+          <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s %></option>
+        <% }); %>
+      </select>
+      <button class="btn btn--ghost btn--sm" type="submit"><%= locale === 'en' ? 'Filter' : 'ফিল্টার' %></button>
+      <% if (q || status) { %><a class="btn btn--ghost btn--sm" href="/admin/articles"><%= locale === 'en' ? 'Clear' : 'রিসেট' %></a><% } %>
+    </form>
+
+    <div class="row" style="gap:6px;margin-bottom:14px">
+      <% counts.forEach(function (c) { %>
+        <span class="tag tag--<%= c.status === 'published' ? 'ok' : c.status === 'draft' ? 'warn' : 'ink' %>"><%= c.status %>: <%= h.bnNumber(c.n) %></span>
+      <% }); %>
+    </div>
+
+    <div class="table-wrap">
+      <table class="tbl">
+        <thead>
+          <tr>
+            <th><%= locale === 'en' ? 'Story' : 'সংবাদ' %></th>
+            <th><%= locale === 'en' ? 'Category' : 'বিভাগ' %></th>
+            <th><%= locale === 'en' ? 'Status' : 'স্ট্যাটাস' %></th>
+            <th class="num"><%= locale === 'en' ? 'Views' : 'ভিউ' %></th>
+            <th class="num"><%= locale === 'en' ? 'Comments' : 'মন্তব্য' %></th>
+            <th><%= locale === 'en' ? 'Updated' : 'হালনাগাদ' %></th>
+            <th></th>
+          </tr>
+        </thead>
+        <tbody>
+          <% rows.forEach(function (a) { %>
+            <tr>
+              <td style="max-width:460px">
+                <a href="/admin/articles/<%= a.id %>/edit" style="font-weight:600"><%= a.title_bn %></a>
+                <div class="row" style="gap:5px;margin-top:4px">
+                  <% if (a.is_breaking) { %><span class="tag tag--red"><%= locale === 'en' ? 'breaking' : 'ব্রেকিং' %></span><% } %>
+                  <% if (a.is_featured) { %><span class="tag tag--warn">featured</span><% } %>
+                  <% if (a.is_sponsored) { %><span class="tag">sponsored</span><% } %>
+                  <% if (a.is_demo) { %><span class="tag tag--warn">demo</span><% } %>
+                  <a class="small muted" href="/news/<%= a.slug %>" target="_blank" rel="noopener">↗ /news/<%= a.slug.length > 30 ? a.slug.slice(0, 30) + '…' : a.slug %></a>
+                </div>
+              </td>
+              <td><span class="tag"><%= a.category_bn || '—' %></span></td>
+              <td>
+                <span class="tag tag--<%= a.status === 'published' ? 'ok' : a.status === 'draft' ? 'warn' : 'ink' %>"><%= a.status %></span>
+              </td>
+              <td class="num"><%= h.bnNumber(a.views) %></td>
+              <td class="num"><%= h.bnNumber(a.comments_count) %></td>
+              <td class="small muted"><%= h.timeAgo(a.updated_at, locale) %></td>
+              <td class="actions">
+                <a class="btn btn--ghost btn--sm" href="/admin/articles/<%= a.id %>/edit"><%= locale === 'en' ? 'Edit' : 'সম্পাদনা' %></a>
+                <% if (can('article.delete')) { %>
+                  <form method="post" action="/admin/articles/<%= a.id %>/delete" data-confirm="<%= locale === 'en' ? 'Delete this story permanently?' : 'সংবাদটি স্থায়ীভাবে মুছে ফেলবেন?' %>" style="display:inline">
+                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
+                    <button class="btn btn--danger btn--sm" type="submit">✕</button>
+                  </form>
+                <% } %>
+              </td>
+            </tr>
+          <% }); %>
+          <% if (!rows.length) { %><tr><td colspan="7" class="muted"><%= locale === 'en' ? 'Nothing here yet.' : 'এখনো কিছু নেই।' %></td></tr><% } %>
+        </tbody>
+      </table>
+    </div>
+
+    <%- include('../partials/pagination', { page: page, totalPages: totalPages, baseUrl: '/admin/articles?q=' + encodeURIComponent(q) + '&status=' + status }) %>
+  </div>
+</div>
+
+<%- include('_shell-close') %>
diff --git a/src/views/admin/assistant.ejs b/src/views/admin/assistant.ejs
new file mode 100644
index 0000000..fdc5683
--- /dev/null
+++ b/src/views/admin/assistant.ejs
@@ -0,0 +1,61 @@
+<%- include('_shell-open') %>
+
+<div class="cards">
+  <div class="stat"><span class="label"><%= locale === 'en' ? 'Questions (30d)' : 'প্রশ্ন (৩০দি)' %></span><span class="value"><%= h.bnNumber(stats.total) %></span></div>
+  <div class="stat alt"><span class="label"><%= locale === 'en' ? 'Avg response' : 'গড় সময়' %></span><span class="value"><%= h.bnNumber(stats.avgMs) %>ms</span></div>
+  <div class="stat alt"><span class="label"><%= locale === 'en' ? 'Engine' : 'ইঞ্জিন' %></span>
+    <span class="value" style="font-size:18px"><%= provider ? provider.key : 'local' %></span>
+    <span class="muted small"><%= provider ? provider.model : (locale === 'en' ? 'no API key — grounded local engine' : 'কি নেই — লোকাল ইঞ্জিন') %></span>
+  </div>
+  <div class="stat alt"><span class="label"><%= locale === 'en' ? 'Languages used' : 'ব্যবহৃত ভাষা' %></span>
+    <span class="value" style="font-size:16px">
+      <% stats.byLang.forEach(function (l) { %><span class="tag"><%= l.lang %>: <%= h.bnNumber(l.n) %></span> <% }); %>
+      <% if (!stats.byLang.length) { %>—<% } %>
+    </span>
+  </div>
+</div>
+
+<div class="grid-2">
+  <div class="panel">
+    <div class="panel__head">✨ <%= locale === 'en' ? 'How the assistant behaves' : 'অ্যাসিস্ট যেভাবে কাজ করে' %></div>
+    <div class="panel__body small">
+      <ul style="margin:0;padding-left:18px;line-height:1.9">
+        <li><b><%= locale === 'en' ? 'Language mirroring' : 'ভাষা অনুসরণ' %></b> — <%= locale === 'en' ? 'Bangla in, Bangla out; English in, English out; Banglish in, Banglish out (Bangla written in Latin letters).' : 'বাংলা প্রশ্নে বাংলা, ইংরেজিতে ইংরেজি, বাংলাইশে বাংলাইশ উত্তর।' %></li>
+        <li><b><%= locale === 'en' ? 'Grounded answers' : 'তথ্যভিত্তিক উত্তর' %></b> — <%= locale === 'en' ? 'the model receives the live trending digest and must not invent headlines.' : 'মডেলকে লাইভ ট্রেন্ডিং ডাইজেস্ট দেওয়া হয়; কল্পনা করে সংবাদ বলা নিষেধ।' %></li>
+        <li><b><%= locale === 'en' ? 'Injection defence' : 'ইনজেকশন সুরক্ষা' %></b> — <%= locale === 'en' ? 'prompt-injection attempts are stripped and logged as `ai_prompt_injection`.' : 'প্রম্পট-ইনজেকশন চেষ্টা সরিয়ে ফেলা হয় এবং লগ করা হয়।' %></li>
+        <li><b><%= locale === 'en' ? 'Rate limiting' : 'রেট লিমিট' %></b> — <%= locale === 'en' ? 'per-IP cap (AI_RATE_LIMIT, default 20 per 10 minutes).' : 'প্রতি আইপিতে সীমা (ডিফল্ট ১০ মিনিটে ২০টি)।' %></li>
+        <li><b><%= locale === 'en' ? 'No PII' : 'ব্যক্তিগত তথ্য নয়' %></b> — <%= locale === 'en' ? 'IPs are hashed before storage; only a visitor id links turns together.' : 'আইপি হ্যাশ করা হয়; শুধু ভিজিটর আইডি দিয়ে টার্ন যুক্ত থাকে।' %></li>
+      </ul>
+
+      <h4 style="margin:16px 0 6px"><%= locale === 'en' ? 'Connect a model' : 'মডেল যুক্ত করা' %></h4>
+      <pre style="background:var(--paper-2);padding:12px;border-radius:8px;overflow:auto;font-size:12px;line-height:1.6">AI_PROVIDER=groq
+AI_API_KEY=your_key_here
+AI_MODEL=llama-3.3-70b-versatile</pre>
+      <p class="muted" style="margin:8px 0 0"><%= locale === 'en' ? 'Providers supported: openai, groq, gemini, openrouter, or any OpenAI-compatible endpoint via AI_BASE_URL.' : 'সমর্থিত: openai, groq, gemini, openrouter, অথবা AI_BASE_URL দিয়ে যেকোনো OpenAI-সামঞ্জস্যপূর্ণ এন্ডপয়েন্ট।' %></p>
+    </div>
+  </div>
+
+  <div class="panel">
+    <div class="panel__head">🧾 <%= locale === 'en' ? 'Recent conversations' : 'সাম্প্রতিক কথোপকথন' %></div>
+    <div class="panel__body tight table-wrap">
+      <table class="tbl">
+        <thead><tr><th><%= locale === 'en' ? 'When' : 'সময়' %></th><th>Chat</th><th>Role</th><th><%= locale === 'en' ? 'Message' : 'বার্তা' %></th><th>Lang</th><th>Engine</th></tr></thead>
+        <tbody>
+          <% recent.forEach(function (m) { %>
+            <tr>
+              <td class="small muted"><%= h.timeAgo(m.created_at, locale) %></td>
+              <td class="small"><code><%= String(m.chat_id).slice(0, 8) %></code></td>
+              <td><span class="tag tag--<%= m.role === 'user' ? 'ink' : 'ok' %>"><%= m.role %></span></td>
+              <td class="small" style="max-width:420px"><%= m.content.slice(0, 160) %><%= m.content.length > 160 ? '…' : '' %></td>
+              <td class="small"><%= m.lang || '—' %></td>
+              <td class="small"><%= m.engine || '—' %></td>
+            </tr>
+          <% }); %>
+          <% if (!recent.length) { %><tr><td colspan="6" class="muted"><%= locale === 'en' ? 'No conversations yet.' : 'এখনো কোনো কথোপকথন নেই।' %></td></tr><% } %>
+        </tbody>
+      </table>
+    </div>
+  </div>
+</div>
+
+<%- include('_shell-close') %>
diff --git a/src/views/admin/comments.ejs b/src/views/admin/comments.ejs
new file mode 100644
index 0000000..5f06540
--- /dev/null
+++ b/src/views/admin/comments.ejs
@@ -0,0 +1,58 @@
+<%- include('_shell-open') %>
+
+<div class="panel">
+  <div class="panel__head">
+    💬 <%= locale === 'en' ? 'Comment moderation' : 'মন্তব্য পর্যালোচনা' %>
+    <span class="spacer"></span>
+    <% counts.forEach(function (c) { %>
+      <a class="tag tag--<%= c.status === status ? 'red' : c.status === 'approved' ? 'ok' : 'warn' %>" href="?status=<%= c.status %>"><%= c.status %>: <%= h.bnNumber(c.n) %></a>
+    <% }); %>
+  </div>
+  <div class="panel__body tight table-wrap">
+    <table class="tbl">
+      <thead><tr>
+        <th><%= locale === 'en' ? 'Comment' : 'মন্তব্য' %></th>
+        <th><%= locale === 'en' ? 'Story' : 'সংবাদ' %></th>
+        <th><%= locale === 'en' ? 'From' : 'উৎস' %></th>
+        <th><%= locale === 'en' ? 'When' : 'সময়' %></th>
+        <th></th>
+      </tr></thead>
+      <tbody>
+        <% rows.forEach(function (c) { %>
+          <tr>
+            <td style="max-width:420px">
+              <b><%= c.name %></b><% if (c.email) { %> <span class="small muted">(<%= c.email %>)</span><% } %>
+              <p class="small" style="margin:4px 0 0"><%- c.body %></p>
+            </td>
+            <td><a href="/news/<%= c.slug %>" target="_blank" rel="noopener" class="small"><%= c.title_bn.slice(0, 40) %>…</a></td>
+            <td class="small muted"><%= c.country || '—' %><br><span title="<%= c.user_agent %>"><%= (c.user_agent || '').slice(0, 22) %>…</span></td>
+            <td class="small muted"><%= h.timeAgo(c.created_at, locale) %></td>
+            <td class="actions">
+              <% if (c.status !== 'approved') { %>
+                <form method="post" action="/admin/comments/<%= c.id %>/status" style="display:inline">
+                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="approved">
+                  <button class="btn btn--ok btn--sm" type="submit"><%= locale === 'en' ? 'Approve' : 'অনুমোদন' %></button>
+                </form>
+              <% } %>
+              <% if (c.status !== 'spam') { %>
+                <form method="post" action="/admin/comments/<%= c.id %>/status" style="display:inline">
+                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="spam">
+                  <button class="btn btn--ghost btn--sm" type="submit"><%= locale === 'en' ? 'Spam' : 'স্প্যাম' %></button>
+                </form>
+              <% } %>
+              <% if (c.status !== 'rejected') { %>
+                <form method="post" action="/admin/comments/<%= c.id %>/status" style="display:inline">
+                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="rejected">
+                  <button class="btn btn--danger btn--sm" type="submit"><%= locale === 'en' ? 'Reject' : 'বাতিল' %></button>
+                </form>
+              <% } %>
+            </td>
+          </tr>
+        <% }); %>
+        <% if (!rows.length) { %><tr><td colspan="5" class="muted"><%= locale === 'en' ? 'Nothing in this queue.' : 'এই সারিতে কিছু নেই।' %></td></tr><% } %>
+      </tbody>
+    </table>
+  </div>
+</div>
+
+<%- include('_shell-close') %>
diff --git a/src/views/admin/dashboard.ejs b/src/views/admin/dashboard.ejs
new file mode 100644
index 0000000..e8abc94
--- /dev/null
+++ b/src/views/admin/dashboard.ejs
@@ -0,0 +1,201 @@
+<%- include('_shell-open') %>
+
+<div class="cards">
+  <div class="stat">
+    <span class="label"><%= locale === 'en' ? 'Pageviews' : 'পেজভিউ' %> (<%= h.bnNumber(days) %><%= locale === 'en' ? 'd' : 'দি' %>)</span>
+    <span class="value" id="statPageviews"><%= h.bnNumber(overview.pageviews) %></span>
+    <span class="delta <%= overview.pageviewsDelta >= 0 ? 'up' : 'down' %>"><%= overview.pageviewsDelta >= 0 ? '▲' : '▼' %> <%= Math.abs(overview.pageviewsDelta) %>% <%= locale === 'en' ? 'vs previous' : 'আগের তুলনায়' %></span>
+  </div>
+  <div class="stat">
+    <span class="label"><%= locale === 'en' ? 'Unique visitors' : 'ইউনিক ভিজিটর' %></span>
+    <span class="value" id="statVisitors"><%= h.bnNumber(overview.visitors) %></span>
+    <span class="delta <%= overview.visitorsDelta >= 0 ? 'up' : 'down' %>"><%= overview.visitorsDelta >= 0 ? '▲' : '▼' %> <%= Math.abs(overview.visitorsDelta) %>%</span>
+  </div>
+  <div class="stat alt">
+    <span class="label"><%= locale === 'en' ? 'Today' : 'আজ' %></span>
+    <span class="value"><%= h.bnNumber(overview.todayPageviews) %></span>
+    <span class="muted small"><%= h.bnNumber(overview.todayVisitors) %> <%= locale === 'en' ? 'visitors so far' : 'ভিজিটর' %></span>
+  </div>
+  <div class="stat">
+    <span class="label"><%= locale === 'en' ? 'Ad impressions' : 'বিজ্ঞাপন ইমপ্রেশন' %></span>
+    <span class="value"><%= h.bnNumber(overview.ads.impressions) %></span>
+    <span class="muted small">CTR <%= overview.ads.ctr.toFixed(2) %>% · <%= h.bnNumber(overview.ads.clicks) %> <%= locale === 'en' ? 'clicks' : 'ক্লিক' %></span>
+  </div>
+  <div class="stat alt">
+    <span class="label"><%= locale === 'en' ? 'Subscribers' : 'সাবস্ক্রাইবার' %></span>
+    <span class="value"><%= h.bnNumber(overview.subscribers.active) %></span>
+    <span class="muted small"><%= h.bnNumber(overview.subscribers.pending) %> <%= locale === 'en' ? 'pending' : 'পেন্ডিং' %></span>
+  </div>
+  <div class="stat alt">
+    <span class="label"><%= locale === 'en' ? 'Published stories' : 'প্রকাশিত সংবাদ' %></span>
+    <span class="value"><%= h.bnNumber(overview.content.published || 0) %></span>
+    <span class="muted small"><%= h.bnNumber(overview.content.drafts || 0) %> <%= locale === 'en' ? 'drafts' : 'ড্রাফট' %> · <%= h.bnNumber(overview.pendingComments) %> <%= locale === 'en' ? 'comments to review' : 'মন্তব্য অপেক্ষমাণ' %></span>
+  </div>
+  <div class="stat alt">
+    <span class="label"><%= locale === 'en' ? 'AI chats' : 'এআই চ্যাট' %></span>
+    <span class="value"><%= h.bnNumber(overview.assistant.total) %></span>
+    <span class="muted small"><%= locale === 'en' ? 'avg' : 'গড়' %> <%= h.bnNumber(overview.assistant.avgMs) %>ms</span>
+  </div>
+</div>
+
+<div class="grid-side">
+  <div>
+    <div class="panel">
+      <div class="panel__head">
+        📈 <%= locale === 'en' ? 'Traffic' : 'ট্রাফিক' %>
+        <span class="sub"><%= locale === 'en' ? 'last' : 'গত' %> <%= h.bnNumber(days) %> <%= locale === 'en' ? 'days' : 'দিন' %></span>
+        <span class="spacer"></span>
+        <a class="btn btn--ghost btn--sm" href="?days=7">৭</a>
+        <a class="btn btn--ghost btn--sm" href="?days=30">৩০</a>
+        <a class="btn btn--ghost btn--sm" href="?days=90">৯০</a>
+      </div>
+      <div class="panel__body">
+        <div class="chart" data-series='<%- JSON.stringify(timeSeries.map(function (r) { return { l: r.day.slice(5), v: r.pageviews }; })) %>'></div>
+      </div>
+    </div>
+
+    <div class="grid-2">
+      <div class="panel">
+        <div class="panel__head">🌍 <%= locale === 'en' ? 'Visitors by country' : 'দেশ অনুযায়ী ভিজিটর' %></div>
+        <div class="panel__body tight table-wrap">
+          <table class="tbl">
+            <thead><tr><th><%= locale === 'en' ? 'Country' : 'দেশ' %></th><th class="num"><%= locale === 'en' ? 'Views' : 'ভিউ' %></th><th class="num"><%= locale === 'en' ? 'Visitors' : 'ভিজিটর' %></th></tr></thead>
+            <tbody>
+              <% if (!countries.length) { %><tr><td colspan="3" class="muted"><%= locale === 'en' ? 'No data yet.' : 'এখনো তথ্য নেই।' %></td></tr><% } %>
+              <% countries.forEach(function (c) { %>
+                <tr>
+                  <td><%= c.country === 'local' ? (locale === 'en' ? 'Local network' : 'লোকাল নেটওয়ার্ক') : c.country %></td>
+                  <td class="num"><%= h.bnNumber(c.pageviews) %></td>
+                  <td class="num"><%= h.bnNumber(c.visitors) %></td>
+                </tr>
+              <% }); %>
+            </tbody>
+          </table>
+        </div>
+      </div>
+
+      <div class="panel">
+        <div class="panel__head">📱 <%= locale === 'en' ? 'Device & source' : 'ডিভাইস ও উৎস' %></div>
+        <div class="panel__body">
+          <div class="donut">
+            <% const devTotal = devices.reduce(function (s, d) { return s + d.pageviews; }, 0) || 1; %>
+            <% devices.forEach(function (d) { %>
+              <div class="row">
+                <span><%= d.device %></span>
+                <span class="track"><span class="fill" style="width:<%= Math.round((d.pageviews / devTotal) * 100) %>%;background:var(--ink)"></span></span>
+                <span class="val"><%= Math.round((d.pageviews / devTotal) * 100) %>%</span>
+              </div>
+            <% }); %>
+          </div>
+          <hr style="border:0;border-top:1px solid var(--line);margin:14px 0">
+          <div class="donut">
+            <% const srcTotal = sources.reduce(function (s, d) { return s + d.n; }, 0) || 1; %>
+            <% sources.slice(0, 6).forEach(function (d) { %>
+              <div class="row">
+                <span><%= d.source %></span>
+                <span class="track"><span class="fill" style="width:<%= Math.round((d.n / srcTotal) * 100) %>%"></span></span>
+                <span class="val"><%= h.bnNumber(d.n) %></span>
+              </div>
+            <% }); %>
+          </div>
+        </div>
+      </div>
+    </div>
+
+    <div class="panel">
+      <div class="panel__head">🏆 <%= locale === 'en' ? 'Top stories' : 'সর্বাধিক পঠিত সংবাদ' %></div>
+      <div class="panel__body tight table-wrap">
+        <table class="tbl">
+          <thead><tr><th><%= locale === 'en' ? 'Story' : 'সংবাদ' %></th><th><%= locale === 'en' ? 'Category' : 'বিভাগ' %></th><th class="num"><%= locale === 'en' ? 'Period' : 'সময়কাল' %></th><th class="num"><%= locale === 'en' ? 'Total' : 'মোট' %></th></tr></thead>
+          <tbody>
+            <% topArticles.slice(0, 10).forEach(function (a) { %>
+              <tr>
+                <td><a href="/news/<%= a.slug %>" target="_blank" rel="noopener"><%= a.title_bn.length > 62 ? a.title_bn.slice(0, 62) + '…' : a.title_bn %></a></td>
+                <td><span class="tag"><%= a.category_bn || '—' %></span></td>
+                <td class="num"><%= h.bnNumber(a.period_views) %></td>
+                <td class="num"><%= h.bnNumber(a.views) %></td>
+              </tr>
+            <% }); %>
+            <% if (!topArticles.length) { %><tr><td colspan="4" class="muted"><%= locale === 'en' ? 'No data yet.' : 'এখনো তথ্য নেই।' %></td></tr><% } %>
+          </tbody>
+        </table>
+      </div>
+    </div>
+  </div>
+
+  <div>
+    <div class="panel">
+      <div class="panel__head">🟢 <%= locale === 'en' ? 'Live now' : 'এখন লাইভ' %> <span class="sub" id="liveStamp"></span></div>
+      <div class="panel__body tight table-wrap">
+        <table class="tbl" id="liveNow" data-days="<%= days %>">
+          <thead><tr><th><%= locale === 'en' ? 'Page' : 'পেজ' %></th><th class="num"><%= locale === 'en' ? 'Hits' : 'হিট' %></th></tr></thead>
+          <tbody id="liveRows">
+            <% live.forEach(function (l) { %>
+              <tr><td><%= l.path %></td><td class="num"><%= h.bnNumber(l.hits) %></td></tr>
+            <% }); %>
+            <% if (!live.length) { %><tr><td colspan="2" class="muted"><%= locale === 'en' ? 'No visitors in the last 10 minutes.' : 'গত ১০ মিনিটে কোনো ভিজিটর নেই।' %></td></tr><% } %>
+          </tbody>
+        </table>
+      </div>
+    </div>
+
+    <div class="panel">
+      <div class="panel__head">💰 <%= locale === 'en' ? 'Revenue snapshot' : 'আয়ের চিত্র' %></div>
+      <div class="panel__body">
+        <div class="donut">
+          <% const slotMax = Math.max.apply(null, overview.ads.bySlot.map(function (s) { return s.impressions; }).concat([1])) || 1; %>
+          <% overview.ads.bySlot.slice(0, 6).forEach(function (s) { %>
+            <div class="row">
+              <span style="font-size:12px"><%= s.slot %></span>
+              <span class="track"><span class="fill" style="width:<%= Math.round((s.impressions / slotMax) * 100) %>%"></span></span>
+              <span class="val"><%= h.bnNumber(s.impressions) %></span>
+            </div>
+          <% }); %>
+          <% if (!overview.ads.bySlot.length) { %><p class="muted small" style="margin:0"><%= locale === 'en' ? 'No ad events recorded yet.' : 'এখনো কোনো বিজ্ঞাপন ইভেন্ট নেই।' %></p><% } %>
+        </div>
+        <p class="small muted" style="margin:12px 0 0">
+          <%= locale === 'en' ? 'Estimated eCPM revenue depends on your network. Track impressions and CTR here, then reconcile with the network dashboard.' : 'প্রকৃত আয় নির্ভর করে আপনার নেটওয়ার্কের ওপর। এখানে ইমপ্রেশন ও CTR ট্র্যাক করুন, তারপর নেটওয়ার্ক ড্যাশবোর্ডের সঙ্গে মিলিয়ে নিন।' %>
+        </p>
+        <a class="btn btn--ghost btn--sm" href="/admin/ads" style="margin-top:10px"><%= locale === 'en' ? 'Manage ads' : 'বিজ্ঞাপন ব্যবস্থাপনা' %> →</a>
+      </div>
+    </div>
+
+    <div class="panel">
+      <div class="panel__head">💬 <%= locale === 'en' ? 'Comments awaiting review' : 'অপেক্ষমাণ মন্তব্য' %></div>
+      <div class="panel__body">
+        <% if (!commentsToReview.length) { %>
+          <p class="muted small" style="margin:0">✓ <%= locale === 'en' ? 'Nothing to review.' : 'কিছু নেই।' %></p>
+        <% } else { %>
+          <% commentsToReview.forEach(function (c) { %>
+            <div style="border-bottom:1px solid var(--line);padding:9px 0">
+              <b><%= c.name %></b> <span class="muted small">→ <%= c.title_bn.slice(0, 34) %>…</span>
+              <p class="small" style="margin:4px 0 0"><%= c.body.slice(0, 110) %>…</p>
+            </div>
+          <% }); %>
+          <a class="btn btn--sm" href="/admin/comments" style="margin-top:10px"><%= locale === 'en' ? 'Moderate' : 'পর্যালোচনা' %> →</a>
+        <% } %>
+      </div>
+    </div>
+
+    <div class="panel">
+      <div class="panel__head">🧾 <%= locale === 'en' ? 'Recent activity' : 'সাম্প্রতিক কার্যক্রম' %></div>
+      <div class="panel__body tight table-wrap">
+        <table class="tbl">
+          <tbody>
+            <% audit.forEach(function (a) { %>
+              <tr>
+                <td>
+                  <span class="tag tag--ink"><%= a.action %></span>
+                  <div class="small muted"><%= a.actor %> · <%= h.timeAgo(a.created_at, locale) %></div>
+                </td>
+              </tr>
+            <% }); %>
+            <% if (!audit.length) { %><tr><td class="muted"><%= locale === 'en' ? 'No activity yet.' : 'এখনো কিছু নেই।' %></td></tr><% } %>
+          </tbody>
+        </table>
+      </div>
+    </div>
+  </div>
+</div>
+
+<%- include('_shell-close') %>
diff --git a/src/views/admin/login.ejs b/src/views/admin/login.ejs
new file mode 100644
index 0000000..9878682
--- /dev/null
+++ b/src/views/admin/login.ejs
@@ -0,0 +1,58 @@
+<!doctype html>
+<html lang="bn">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="robots" content="noindex, nofollow, noarchive">
+  <meta name="referrer" content="no-referrer">
+  <title>সাইন ইন · নিউজপালস ২৪ অ্যাডমিন</title>
+  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@600;800&display=swap" media="print" onload="this.media='all'">
+  <link rel="stylesheet" href="/assets/css/admin.css?v=1.0.0">
+  <link rel="icon" href="/assets/logo.svg" type="image/svg+xml">
+</head>
+<body>
+<div class="login-wrap">
+  <div class="login-card">
+    <div class="brand">
+      <span class="mark" aria-hidden="true">
+        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.6 3.9 5.7 3.9 9S14.6 18.4 12 21c-2.6-2.6-3.9-5.7-3.9-9S9.4 5.6 12 3z"/></svg>
+      </span>
+      <span>
+        <h1>News<span style="color:var(--red)">Pulse</span> 24</h1>
+        <p class="sub">নিউজরুম কন্ট্রোল রুম · Admin</p>
+      </span>
+    </div>
+
+    <% if (typeof isDev !== 'undefined' && isDev) { %>
+    <div class="flash" style="background:#12211a;border:1px solid #1d4c31;color:#8ee3b0">
+      🧪 <b>Dev mode</b> — আইডি: <code>admin@newspulse24.com</code> · পাসওয়ার্ড: <code>NewsPulse#2026x</code>
+      <span class="muted" style="display:block;font-size:12px;margin-top:4px">প্রোডাকশনে এই বক্স দেখা যায় না; আপনার <code>.env</code>-এর মান ব্যবহার করুন।</span>
+    </div>
+    <% } %>
+
+    <% if (error) { %><div class="flash flash--err">⚠ <%= error %></div><% } %>
+
+    <form method="post" action="/admin/login" novalidate>
+      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
+      <input type="hidden" name="next" value="<%= next %>">
+      <div class="field">
+        <label for="email">ইমেইল</label>
+        <input id="email" name="email" type="email" required autocomplete="username" autofocus maxlength="160">
+      </div>
+      <div class="field">
+        <label for="password">পাসওয়ার্ড</label>
+        <input id="password" name="password" type="password" required autocomplete="current-password" maxlength="200">
+      </div>
+      <button class="btn" type="submit">সাইন ইন →</button>
+    </form>
+
+    <div class="security-note">
+      🛡️ এই লগইন ব্রুট-ফোর্স সুরক্ষিত: <b>৫টি</b> ব্যর্থ চেষ্টার পর অ্যাকাউন্ট ১৫ মিনিট লক হয়, সব চেষ্টা সিকিউরিটি লগে যায় এবং প্রতিটি সেশন হ্যাশ করা টোকেন দিয়ে যাচাই করা হয়।
+      <% if (typeof settings !== 'undefined' && settings.require2faForAdmins) { %><br>এই সাইটে অ্যাডমিনদের জন্য টু-ফ্যাক্টর বাধ্যতামূলক।<% } %>
+    </div>
+
+    <div class="foot"><a href="/" style="color:var(--red-700)">← ওয়েবসাইটে ফিরে যান</a></div>
+  </div>
+</div>
+</body>
+</html>
diff --git a/src/views/admin/media.ejs b/src/views/admin/media.ejs
new file mode 100644
index 0000000..68d3ef3
--- /dev/null
+++ b/src/views/admin/media.ejs
@@ -0,0 +1,47 @@
+<%- include('_shell-open') %>
+
+<div class="panel">
+  <div class="panel__head">
+    🖼️ <%= locale === 'en' ? 'Media library' : 'মিডিয়া লাইব্রেরি' %>
+    <span class="sub"><%= h.bnNumber(items.length) %> <%= locale === 'en' ? 'files' : 'টি ফাইল' %> · <%= (totals.bytes / 1048576).toFixed(2) %> MB</span>
+  </div>
+  <div class="panel__body">
+    <% if (can('media.upload')) { %>
+      <form method="post" action="/admin/media" enctype="multipart/form-data" style="margin-bottom:18px">
+        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
+        <div class="dropzone" data-dropzone>
+          <b><%= locale === 'en' ? 'Drop an image here, or click to choose' : 'ছবি টেনে আনুন, অথবা ক্লিক করে বাছুন' %></b>
+          <p class="small" style="margin:6px 0 0">
+            JPG · PNG · WEBP · GIF · AVIF — <%= locale === 'en' ? 'max' : 'সর্বোচ্চ' %> 8 MB.
+            <%= locale === 'en' ? 'SVG is refused (it can carry script); every file is verified by its magic bytes.' : 'SVG গ্রহণ করা হয় না; প্রতিটি ফাইলের প্রকৃত টাইপ যাচাই করা হয়।' %>
+          </p>
+          <input type="file" name="file" accept=".jpg,.jpeg,.png,.webp,.gif,.avif" hidden>
+        </div>
+        <div class="field" style="margin-top:10px">
+          <label for="alt"><%= locale === 'en' ? 'Alt text (accessibility + SEO)' : 'Alt টেক্সট' %></label>
+          <input id="alt" name="alt" maxlength="300">
+        </div>
+      </form>
+    <% } %>
+
+    <div class="media-grid">
+      <% items.forEach(function (m) { %>
+        <div class="media-item">
+          <img src="<%= m.url %>" alt="<%= m.alt || '' %>" loading="lazy">
+          <div class="meta">
+            <code data-copy="<%= m.url %>" title="<%= locale === 'en' ? 'Click to copy URL' : 'কপি করতে ক্লিক করুন' %>"><%= m.url.slice(-18) %></code>
+            <% if (can('media.delete')) { %>
+              <form method="post" action="/admin/media/<%= m.id %>/delete" data-confirm="<%= locale === 'en' ? 'Delete this file?' : 'ফাইলটি মুছবেন?' %>" style="display:inline">
+                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
+                <button class="btn btn--danger btn--sm" type="submit" style="padding:2px 7px">✕</button>
+              </form>
+            <% } %>
+          </div>
+        </div>
+      <% }); %>
+      <% if (!items.length) { %><p class="muted"><%= locale === 'en' ? 'No uploads yet.' : 'এখনো কোনো আপলোড নেই।' %></p><% } %>
+    </div>
+  </div>
+</div>
+
+<%- include('_shell-close') %>
diff --git a/src/views/admin/newsletter.ejs b/src/views/admin/newsletter.ejs
new file mode 100644
index 0000000..83e8929
--- /dev/null
+++ b/src/views/admin/newsletter.ejs
@@ -0,0 +1,95 @@
+<%- include('_shell-open') %>
+
+<div class="cards">
+  <div class="stat"><span class="label"><%= locale === 'en' ? 'Active subscribers' : 'সক্রিয় সাবস্ক্রাইবার' %></span><span class="value"><%= h.bnNumber(stats.active) %></span></div>
+  <div class="stat alt"><span class="label"><%= locale === 'en' ? 'Pending confirmation' : 'নিশ্চিতকরণ বাকি' %></span><span class="value"><%= h.bnNumber(stats.pending) %></span></div>
+  <div class="stat alt"><span class="label"><%= locale === 'en' ? 'Unsubscribed' : 'আনসাবস্ক্রাইব' %></span><span class="value"><%= h.bnNumber(stats.unsubscribed) %></span></div>
+  <div class="stat alt"><span class="label"><%= locale === 'en' ? 'Campaigns' : 'ক্যাম্পেইন' %></span><span class="value"><%= h.bnNumber(stats.campaigns) %></span>
+    <span class="muted small"><%= stats.lastSent ? h.formatDate(stats.lastSent, locale) : (locale === 'en' ? 'never sent' : 'এখনো পাঠানো হয়নি') %></span>
+  </div>
+</div>
+
+<div class="grid-side">
+  <div>
+    <div class="panel">
+      <div class="panel__head">✉️ <%= locale === 'en' ? 'Create a campaign' : 'নতুন ক্যাম্পেইন' %></div>
+      <div class="panel__body">
+        <form method="post" action="/admin/newsletter/campaign">
+          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
+          <div class="field"><label for="subject"><%= locale === 'en' ? 'Subject' : 'বিষয়' %></label><input id="subject" name="subject" required maxlength="200" value="<%= locale === 'en' ? 'Today at NewsPulse 24' : 'আজকের নিউজপালস ২৪' %>"></div>
+          <div class="field"><label for="preview"><%= locale === 'en' ? 'Preview text' : 'প্রিভিউ টেক্সট' %></label><input id="preview" name="preview" maxlength="300"></div>
+          <div class="field">
+            <label for="body"><%= locale === 'en' ? 'Body (HTML)' : 'বিষয়বস্তু (HTML)' %></label>
+            <textarea id="body" name="body" style="min-height:180px"></textarea>
+            <span class="hint"><%= locale === 'en' ? 'Use {{unsubscribe}} to insert the per-reader unsubscribe link.' : '{{unsubscribe}} লিখলে প্রতিটি পাঠকের আনসাবস্ক্রাইব লিংক বসবে।' %></span>
+          </div>
+          <div class="row">
+            <button class="btn" type="submit" name="send" value="0"><%= locale === 'en' ? 'Save as draft' : 'ড্রাফট সংরক্ষণ' %></button>
+            <button class="btn btn--ink" type="submit" name="send" value="1"><%= locale === 'en' ? 'Send to today’s digest' : 'আজকের ডাইজেস্ট পাঠান' %></button>
+          </div>
+          <p class="small muted" style="margin:10px 0 0">
+            <%= locale === 'en' ? 'Tip: leave the body empty and choose the digest option to send the day’s most-read stories automatically.' : 'টিপ: বডি খালি রেখে ডাইজেস্ট অপশন নিলে দিনের সর্বাধিক পঠিত সংবাদ স্বয়ংক্রিয়ভাবে যাবে।' %>
+          </p>
+        </form>
+        <button class="btn btn--ghost btn--sm" id="previewNewsletter" type="button" style="margin-top:10px"><%= locale === 'en' ? 'Preview the digest' : 'ডাইজেস্ট প্রিভিউ দেখুন' %></button>
+        <div id="newsletterPreview" hidden style="border:1px solid var(--line);border-radius:8px;padding:12px;margin-top:10px;background:#fff"><%- digestPreview %></div>
+      </div>
+    </div>
+
+    <div class="panel">
+      <div class="panel__head">📤 <%= locale === 'en' ? 'Campaigns' : 'ক্যাম্পেইন' %></div>
+      <div class="panel__body tight table-wrap">
+        <table class="tbl">
+          <thead><tr><th><%= locale === 'en' ? 'Subject' : 'বিষয়' %></th><th><%= locale === 'en' ? 'Status' : 'স্ট্যাটাস' %></th><th class="num"><%= locale === 'en' ? 'Recipients' : 'প্রাপক' %></th><th><%= locale === 'en' ? 'Sent' : 'পাঠানো' %></th><th></th></tr></thead>
+          <tbody>
+            <% campaigns.forEach(function (c) { %>
+              <tr>
+                <td><%= c.subject %></td>
+                <td><span class="tag tag--<%= c.status === 'sent' ? 'ok' : 'warn' %>"><%= c.status %></span></td>
+                <td class="num"><%= h.bnNumber(c.recipients) %></td>
+                <td class="small muted"><%= c.sent_at ? h.formatDate(c.sent_at, locale) : '—' %></td>
+                <td class="actions">
+                  <% if (c.status !== 'sent') { %>
+                    <form method="post" action="/admin/newsletter/<%= c.id %>/send" style="display:inline">
+                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
+                      <button class="btn btn--sm" type="submit"><%= locale === 'en' ? 'Send' : 'পাঠান' %></button>
+                    </form>
+                  <% } %>
+                </td>
+              </tr>
+            <% }); %>
+            <% if (!campaigns.length) { %><tr><td colspan="5" class="muted"><%= locale === 'en' ? 'No campaigns yet.' : 'এখনো কোনো ক্যাম্পেইন নেই।' %></td></tr><% } %>
+          </tbody>
+        </table>
+      </div>
+    </div>
+  </div>
+
+  <div>
+    <div class="panel">
+      <div class="panel__head">👥 <%= locale === 'en' ? 'Subscribers' : 'সাবস্ক্রাইবার' %></div>
+      <div class="panel__body tight table-wrap">
+        <table class="tbl">
+          <thead><tr><th><%= locale === 'en' ? 'Email' : 'ইমেইল' %></th><th><%= locale === 'en' ? 'Status' : 'স্ট্যাটাস' %></th><th></th></tr></thead>
+          <tbody>
+            <% subscribers.forEach(function (s) { %>
+              <tr>
+                <td class="small"><%= s.email %><br><span class="muted"><%= s.lang %> · <%= s.country || '—' %></span></td>
+                <td><span class="tag tag--<%= s.status === 'active' ? 'ok' : 'warn' %>"><%= s.status %></span></td>
+                <td>
+                  <form method="post" action="/admin/newsletter/<%= s.id %>/delete" data-confirm="<%= locale === 'en' ? 'Remove this subscriber?' : 'সাবস্ক্রাইবার মুছবেন?' %>" style="display:inline">
+                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
+                    <button class="btn btn--danger btn--sm" type="submit">✕</button>
+                  </form>
+                </td>
+              </tr>
+            <% }); %>
+            <% if (!subscribers.length) { %><tr><td colspan="3" class="muted"><%= locale === 'en' ? 'No subscribers yet.' : 'এখনো কেউ সাবস্ক্রাইব করেনি।' %></td></tr><% } %>
+          </tbody>
+        </table>
+      </div>
+    </div>
+  </div>
+</div>
+
+<%- include('_shell-close') %>
diff --git a/src/views/admin/pages.ejs b/src/views/admin/pages.ejs
new file mode 100644
index 0000000..0bbdde3
--- /dev/null
+++ b/src/views/admin/pages.ejs
@@ -0,0 +1,71 @@
+<%- include('_shell-open') %>
+
+<div class="grid-side">
+  <div>
+    <div class="panel">
+      <div class="panel__head">📄 <%= locale === 'en' ? 'Static pages' : 'স্ট্যাটিক পেজ' %></div>
+      <div class="panel__body tight table-wrap">
+        <table class="tbl">
+          <thead><tr><th><%= locale === 'en' ? 'Page' : 'পেজ' %></th><th>URL</th><th><%= locale === 'en' ? 'Updated' : 'হালনাগাদ' %></th><th></th></tr></thead>
+          <tbody>
+            <% rows.forEach(function (p) { %>
+              <tr>
+                <td><%= p.title_bn %></td>
+                <td><a href="/page/<%= p.slug %>" target="_blank" rel="noopener">/page/<%= p.slug %></a></td>
+                <td class="small muted"><%= h.timeAgo(p.updated_at, locale) %></td>
+                <td class="actions">
+                  <a class="btn btn--ghost btn--sm" href="?slug=<%= p.slug %>"><%= locale === 'en' ? 'Edit' : 'সম্পাদনা' %></a>
+                  <form method="post" action="/admin/pages/<%= p.slug %>/delete" data-confirm="<%= locale === 'en' ? 'Delete this page?' : 'পেজ মুছবেন?' %>" style="display:inline">
+                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
+                    <button class="btn btn--danger btn--sm" type="submit">✕</button>
+                  </form>
+                </td>
+              </tr>
+            <% }); %>
+          </tbody>
+        </table>
+      </div>
+    </div>
+
+    <div class="panel">
+      <div class="panel__head">✍️ <%= editing ? (locale === 'en' ? 'Edit page' : 'পেজ সম্পাদনা') : (locale === 'en' ? 'New page' : 'নতুন পেজ') %></div>
+      <div class="panel__body">
+        <form method="post" action="/admin/pages">
+          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
+          <div class="field-row">
+            <div class="field"><label for="title_bn"><%= locale === 'en' ? 'Title (বাংলা) *' : 'শিরোনাম (বাংলা) *' %></label><input id="title_bn" name="title_bn" required maxlength="160" value="<%= editing ? editing.title_bn : '' %>"></div>
+            <div class="field"><label for="title_en"><%= locale === 'en' ? 'Title (English)' : 'শিরোনাম (ইংরেজি)' %></label><input id="title_en" name="title_en" maxlength="160" value="<%= editing ? (editing.title_en || '') : '' %>"></div>
+          </div>
+          <div class="field">
+            <label for="slug">Slug *</label>
+            <input id="slug" name="slug" required maxlength="80" value="<%= editing ? editing.slug : '' %>">
+            <span class="hint">/page/<span><%= editing ? editing.slug : 'slug' %></span></span>
+          </div>
+          <div class="field">
+            <label for="body_bn"><%= locale === 'en' ? 'Body (HTML, sanitised)' : 'মূল লেখা (HTML)' %></label>
+            <textarea id="body_bn" name="body_bn" style="min-height:260px"><%= editing ? editing.body_bn : '' %></textarea>
+          </div>
+          <button class="btn" type="submit"><%= locale === 'en' ? 'Save page' : 'পেজ সংরক্ষণ' %></button>
+        </form>
+      </div>
+    </div>
+  </div>
+
+  <div>
+    <div class="panel">
+      <div class="panel__head">💡 <%= locale === 'en' ? 'Suggested pages' : 'প্রস্তাবিত পেজ' %></div>
+      <div class="panel__body small">
+        <ul style="margin:0;padding-left:18px;line-height:2">
+          <li><b>about</b> — <%= locale === 'en' ? 'who you are, ownership, funding' : 'পরিচয়, মালিকানা, অর্থায়ন' %></li>
+          <li><b>editorial-policy</b> — <%= locale === 'en' ? 'verification, corrections, ad separation' : 'যাচাই, সংশোধন, বিজ্ঞাপন বিভাজন' %></li>
+          <li><b>privacy-policy</b> — <%= locale === 'en' ? 'cookies, data, retention' : 'কুকি, তথ্য, সংরক্ষণ' %></li>
+          <li><b>terms</b> — <%= locale === 'en' ? 'reuse rights, comment rules' : 'পুনঃব্যবহার, মন্তব্যের নিয়ম' %></li>
+          <li><b>contact</b> — <%= locale === 'en' ? 'newsroom, tips, ads' : 'সংবাদ কক্ষ, টিপস, বিজ্ঞাপন' %></li>
+        </ul>
+        <p class="muted" style="margin-top:12px"><%= locale === 'en' ? 'All five ship with the install and can be rewritten here.' : 'এই পাঁচটি ইনস্টলের সঙ্গে আসে, এখান থেকে বদলানো যাবে।' %></p>
+      </div>
+    </div>
+  </div>
+</div>
+
+<%- include('_shell-close') %>
diff --git a/src/views/admin/polls.ejs b/src/views/admin/polls.ejs
new file mode 100644
index 0000000..09f1d83
--- /dev/null
+++ b/src/views/admin/polls.ejs
@@ -0,0 +1,63 @@
+<%- include('_shell-open') %>
+
+<div class="grid-side">
+  <div>
+    <div class="panel">
+      <div class="panel__head">📊 <%= locale === 'en' ? 'Polls' : 'পোল' %></div>
+      <div class="panel__body tight table-wrap">
+        <table class="tbl">
+          <thead><tr><th><%= locale === 'en' ? 'Question' : 'প্রশ্ন' %></th><th><%= locale === 'en' ? 'Results' : 'ফলাফল' %></th><th><%= locale === 'en' ? 'Status' : 'স্ট্যাটাস' %></th><th></th></tr></thead>
+          <tbody>
+            <% rows.forEach(function (p) { %>
+              <% const total = p.options.reduce(function (s, o) { return s + (o.votes || 0); }, 0) || 1; %>
+              <tr>
+                <td><b><%= p.question_bn %></b><% if (p.question_en) { %><div class="small muted"><%= p.question_en %></div><% } %></td>
+                <td style="min-width:260px">
+                  <% p.options.forEach(function (o) { %>
+                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">
+                      <span style="flex:1;font-size:13px"><%= o.bn %></span>
+                      <span class="track" style="width:90px;height:7px;background:var(--paper-2);border-radius:99px;display:inline-block;overflow:hidden">
