+# ============================================================================
+#  NewsPulse 24 — environment template
+#  Copy to `.env` and fill in. NEVER commit the real .env (it is git-ignored).
+#  Every value below has a safe default, so the app boots with zero config.
+# ============================================================================
+
+# ---- Runtime ---------------------------------------------------------------
+NODE_ENV=development
+PORT=3000
+# Public origin is used for absolute URLs in RSS / JSON-LD / sitemaps.
+PUBLIC_URL=http://localhost:3000
+# Set true when running behind nginx / Cloudflare so X-Forwarded-* is trusted.
+TRUST_PROXY=true
+
+# ---- Secrets ---------------------------------------------------------------
+# 64+ random chars. Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
+SESSION_SECRET=
+CSRF_SECRET=
+# Salt used to pseudonymise visitor IPs before they ever touch the database.
+IP_HASH_PEPPER=
+
+# ---- Database (SQLite by default; swap the driver for Postgres later) -------
+DB_FILE=./data/newspulse24.db
+
+# ---- Bootstrap super-admin (used only by `npm run admin:create`) -----------
+ADMIN_EMAIL=admin@newspulse24.com
+ADMIN_PASSWORD=
+ADMIN_NAME=Site Owner
+
+# ---- Security tuning --------------------------------------------------------
+LOGIN_MAX_ATTEMPTS=5
+LOGIN_LOCK_MINUTES=15
+SESSION_IDLE_MINUTES=120
+SESSION_ABSOLUTE_HOURS=24
+REQUIRE_2FA_FOR_ADMINS=false
+
+# ---- AI news assistant ------------------------------------------------------
+# provider: none | openai | groq | gemini | openrouter | custom (OpenAI-compatible)
+AI_PROVIDER=none
+AI_API_KEY=
+AI_MODEL=
+AI_BASE_URL=
+AI_MAX_TOKENS=700
+AI_TEMPERATURE=0.4
+# Requests per IP per 10 minutes
+AI_RATE_LIMIT=20
+
+# ---- Newsletter -------------------------------------------------------------
+# smtp | log  (log prints the message instead of sending — safe for local dev)
+MAIL_DRIVER=log
+SMTP_HOST=
+SMTP_PORT=587
+SMTP_SECURE=false
+SMTP_USER=
+SMTP_PASS=
+MAIL_FROM="NewsPulse 24 <no-reply@newspulse24.com>"
+
+# ---- GeoIP (optional, powers the country analytics) -------------------------
+# 1) Cloudflare/CDN header name that already carries the country, if any
+GEO_HEADER=cf-ipcountry
+# 2) Path to a MaxMind GeoLite2-City.mmdb file (optional but best)
+GEO_MMDB_PATH=
+# 3) Last-resort online lookup: none | ipwhois  (only used when 1 & 2 fail)
+GEO_ONLINE=none
+
+# ---- Ads --------------------------------------------------------------------
+ADS_ENABLED=true
+# Comma-separated domains allowed to run scripts inside sandboxed ad frames.
+AD_SCRIPT_ALLOWLIST=pagead2.googlesyndication.com,tpc.googlesyndication.com,cdn.ampproject.org
