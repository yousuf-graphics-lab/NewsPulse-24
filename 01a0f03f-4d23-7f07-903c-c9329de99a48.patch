+<%
+  const now = new Date(Date.now() + 6 * 3600 * 1000);
+  const bnMonths = ['জানুয়ারি','ফেব্রুয়ারি','মার্চ','এপ্রিল','মে','জুন','জুলাই','আগস্ট','সেপ্টেম্বর','অক্টোবর','নভেম্বর','ডিসেম্বর'];
+  const bnDays = ['রবিবার','সোমবার','মঙ্গলবার','বুধবার','বৃহস্পতিবার','শুক্রবার','শনিবার'];
+  const toBn = (s) => String(s).replace(/\d/g, (d) => '০১২৪৫৬৭৮৯'[d]);
+  const dateBn = bnDays[now.getUTCDay()] + ', ' + toBn(now.getUTCDate()) + ' ' + bnMonths[now.getUTCMonth()] + ' ' + toBn(now.getUTCFullYear());
+  const dateEn = now.toUTCString().split(' 00:')[0];
+  const hh = now.getUTCHours() % 12 || 12;
+  const mm = String(now.getUTCMinutes()).padStart(2, '0');
+  const ampm = now.getUTCHours() < 12 ? 'AM' : 'PM';
+  const timeStr = toBn(hh) + ':' + toBn(mm) + ' ' + ampm;
+%>
