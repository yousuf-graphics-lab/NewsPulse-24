+        </div>
+      </div>
+
+      <div class="panel">
+        <div class="panel__head">🖼 <%= locale === 'en' ? 'Cover image' : 'কভার ছবি' %></div>
+        <div class="panel__body">
+          <div class="field">
+            <label for="cover_image"><%= locale === 'en' ? 'Image URL' : 'ছবির লিংক' %></label>
+            <input id="cover_image" name="cover_image" maxlength="600" value="<%= val('cover_image') %>">
+            <span class="hint"><%= locale === 'en' ? 'Pick from the library below, or paste a URL.' : 'নিচের লাইব্রেরি থেকে বাছুন, অথবা লিংক দিন।' %></span>
+          </div>
+          <% if (val('cover_image')) { %><img src="<%= h.safeUrl(val('cover_image')) %>" alt="" style="width:100%;border-radius:8px;margin-bottom:10px"><% } %>
+          <div class="field-row">
+            <div class="field"><label for="cover_caption"><%= locale === 'en' ? 'Caption' : 'ক্যাপশন' %></label><input id="cover_caption" name="cover_caption" maxlength="300" value="<%= val('cover_caption') %>"></div>
+            <div class="field"><label for="cover_credit"><%= locale === 'en' ? 'Credit' : 'ক্রেডিট' %></label><input id="cover_credit" name="cover_credit" maxlength="120" value="<%= val('cover_credit') %>"></div>
+          </div>
