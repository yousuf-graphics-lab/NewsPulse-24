+    const { lastInsertRowid } = db.run(
+      `INSERT INTO authors (name, slug, designation, bio) VALUES (?,?,?,?)`,
+      [a.name, a.slug, a.designation, a.bio],
+    );
+    ids.push(lastInsertRowid);
+  }
+  return ids;
+}
