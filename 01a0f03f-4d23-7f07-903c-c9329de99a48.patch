+            <div class="field"><label for="source_url"><%= locale === 'en' ? 'Source URL' : 'সূত্রের লিংক' %></label><input id="source_url" name="source_url" maxlength="600" value="<%= val('source_url') %>"></div>
+          </div>
+        </div>
+      </div>
+
+      <% if (article && can('article.delete')) { %>
+        <div class="panel">
+          <div class="panel__head" style="color:var(--red)">⚠ <%= locale === 'en' ? 'Danger zone' : 'সতর্কতা' %></div>
+          <div class="panel__body">
+            <form method="post" action="/admin/articles/<%= article.id %>/delete" data-confirm="<%= locale === 'en' ? 'Permanently delete this story and its comments?' : 'সংবাদ ও এর মন্তব্য স্থায়ীভাবে মুছবেন?' %>">
+              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
+              <button class="btn btn--danger" type="submit" style="width:100%"><%= locale === 'en' ? 'Delete story' : 'সংবাদ মুছুন' %></button>
+            </form>
+            <p class="small muted" style="margin:10px 0 0"><%= locale === 'en' ? 'Consider “archived” instead — it keeps the URL and the correction history.' : 'বিকল্প হিসেবে “archived” ব্যবহার করুন — এতে URL ও সংশোধনের ইতিহাস থাকে।' %></p>
+          </div>
+        </div>
+      <% } %>
+    </div>
+  </div>
+</form>
+
+      <div class="panel">
+        <div class="panel__head">🛡️ <%= locale === 'en' ? 'Corrections & transparency' : 'সংশোধনী ও স্বচ্ছতা' %></div>
+        <div class="panel__body">
+          <% if (corrections.length) { %>
+            <ul style="margin-top:0">
+              <% corrections.forEach(function (c) { %>
+                <li style="margin-bottom:8px"><span class="tag tag--red"><%= c.kind %></span> <%= c.note %> <span class="muted small">— <%= h.formatDate(c.created_at, locale) %></span></li>
