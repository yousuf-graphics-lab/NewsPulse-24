+  <div class="stat alt"><span class="label"><%= locale === 'en' ? 'Distinct signals' : 'ধরন' %></span><span class="value"><%= h.bnNumber(kinds.length) %></span></div>
+  <div class="stat alt"><span class="label"><%= locale === 'en' ? 'Environment' : 'পরিবেশ' %></span><span class="value" style="font-size:18px"><%= process.env.NODE_ENV || 'development' %></span>
+    <span class="muted small"><%= locale === 'en' ? 'CSP nonce + HSTS + SameSite=strict are enforced.' : 'CSP ননস, HSTS ও SameSite=strict চালু।' %></span>
+  </div>
+</div>
+
+<div class="grid-2">
