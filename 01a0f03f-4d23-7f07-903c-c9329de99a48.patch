+    const d = req.validated;
+    const problems = auth.passwordProblems(d.password);
+    if (problems.length) return badRequest(req, res, problems[0]);
+    if (db.get(`SELECT id FROM users WHERE lower(email) = lower(?)`, [d.email])) {
