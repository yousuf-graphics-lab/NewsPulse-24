+        <div class="panel__head">💾 <%= locale === 'en' ? 'Backup' : 'ব্যাকআপ' %></div>
+        <div class="panel__body">
+          <p class="small muted" style="margin-top:0"><%= locale === 'en' ? 'Takes a consistent SQLite snapshot into ./backups.' : './backups ফোল্ডারে SQLite স্ন্যাপশট নেয়।' %></p>
+          <button class="btn btn--ink" type="submit" form="backupForm"><%= locale === 'en' ? 'Backup now' : 'এখনই ব্যাকআপ' %></button>
+        </div>
+      </div>
+    </div>
+  </div>
+</form>
+
+<form method="post" action="/admin/backup" id="backupForm">
+  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
+</form>
+
+<%- include('_shell-close') %>
diff --git a/src/views/admin/ticker.ejs b/src/views/admin/ticker.ejs
new file mode 100644
index 0000000..4f1f137
--- /dev/null
+++ b/src/views/admin/ticker.ejs
@@ -0,0 +1,78 @@
+<%- include('_shell-open') %>
+
+<div class="grid-side">
+  <div>
+    <div class="panel">
+      <div class="panel__head">⚡ <%= locale === 'en' ? 'Ticker items (in priority order)' : 'টিকার আইটেম (অগ্রাধিকার অনুযায়ী)' %></div>
+      <div class="panel__body tight table-wrap">
+        <table class="tbl">
+          <thead><tr><th>#</th><th><%= locale === 'en' ? 'Headline' : 'শিরোনাম' %></th><th><%= locale === 'en' ? 'Linked story' : 'সংযুক্ত সংবাদ' %></th><th><%= locale === 'en' ? 'Active' : 'সক্রিয়' %></th><th></th></tr></thead>
+          <tbody>
+            <% rows.forEach(function (t) { %>
+              <tr>
+                <td class="num"><%= t.priority %></td>
+                <td><%= t.text_bn %><% if (t.text_en) { %><div class="small muted"><%= t.text_en %></div><% } %></td>
+                <td class="small"><% if (t.slug) { %><a href="/news/<%= t.slug %>" target="_blank" rel="noopener"><%= (t.article_title || '').slice(0, 34) %>…</a><% } else { %>—<% } %></td>
+                <td><span class="tag tag--<%= t.active ? 'ok' : 'warn' %>"><%= t.active ? (locale === 'en' ? 'live' : 'চালু') : (locale === 'en' ? 'off' : 'বন্ধ') %></span></td>
+                <td class="actions">
+                  <form method="post" action="/admin/ticker/<%= t.id %>/toggle" style="display:inline">
+                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
+                    <button class="btn btn--ghost btn--sm" type="submit"><%= t.active ? '⏸' : '▶' %></button>
+                  </form>
+                  <form method="post" action="/admin/ticker/<%= t.id %>/delete" data-confirm="<%= locale === 'en' ? 'Remove from ticker?' : 'টিকার থেকে সরাবেন?' %>" style="display:inline">
+                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
+                    <button class="btn btn--danger btn--sm" type="submit">✕</button>
+                  </form>
+                </td>
+              </tr>
+            <% }); %>
+            <% if (!rows.length) { %><tr><td colspan="5" class="muted"><%= locale === 'en' ? 'Ticker is empty — it will fall back to stories flagged “breaking”.' : 'টিকার খালি — “ব্রেকিং” চিহ্নিত সংবাদ দেখানো হবে।' %></td></tr><% } %>
+          </tbody>
+        </table>
+      </div>
+    </div>
+
+    <div class="panel">
+      <div class="panel__head">➕ <%= locale === 'en' ? 'Add to ticker' : 'টিকারে যোগ' %></div>
+      <div class="panel__body">
+        <form method="post" action="/admin/ticker">
+          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
+          <div class="field"><label for="text_bn"><%= locale === 'en' ? 'Headline (বাংলা) *' : 'শিরোনাম (বাংলা) *' %></label><input id="text_bn" name="text_bn" required maxlength="200"></div>
+          <div class="field"><label for="text_en"><%= locale === 'en' ? 'Headline (English)' : 'শিরোনাম (ইংরেজি)' %></label><input id="text_en" name="text_en" maxlength="200"></div>
+          <div class="field-row-3">
+            <div class="field"><label for="article_id"><%= locale === 'en' ? 'Link to story' : 'সংবাদ লিংক' %></label>
+              <select id="article_id" name="article_id">
+                <option value="">— <%= locale === 'en' ? 'none' : 'কিছু না' %> —</option>
+                <% breaking.forEach(function (b) { %>
+                  <option value="<%= b.id %>"><%= b.title_bn.slice(0, 50) %></option>
+                <% }); %>
+              </select>
+            </div>
+            <div class="field"><label for="priority"><%= locale === 'en' ? 'Priority' : 'অগ্রাধিকার' %></label><input id="priority" name="priority" type="number" min="1" max="999" value="50"></div>
+            <div class="field"><label for="ends_at"><%= locale === 'en' ? 'Expires (UTC)' : 'মেয়াদ শেষ' %></label><input id="ends_at" name="ends_at" placeholder="2026-01-01T00:00:00Z"></div>
+          </div>
+          <label class="check"><input type="checkbox" name="active" value="1" checked> <%= locale === 'en' ? 'Show immediately' : 'এখনই দেখান' %></label>
+          <button class="btn" type="submit"><%= locale === 'en' ? 'Add to ticker' : 'টিকারে যোগ করুন' %></button>
+        </form>
+      </div>
+    </div>
+  </div>
+
+  <div>
+    <div class="panel">
+      <div class="panel__head">🔴 <%= locale === 'en' ? 'Stories flagged breaking' : 'ব্রেকিং চিহ্নিত সংবাদ' %></div>
+      <div class="panel__body small">
+        <% if (!breaking.length) { %><p class="muted" style="margin:0"><%= locale === 'en' ? 'None right now.' : 'এখন কোনোটি নেই।' %></p><% } %>
+        <% breaking.forEach(function (b) { %>
+          <div style="border-bottom:1px solid var(--line);padding:8px 0">
+            <a href="/news/<%= b.slug %>" target="_blank" rel="noopener"><%= b.title_bn %></a>
+            <div class="muted"><%= h.timeAgo(b.published_at, locale) %></div>
+          </div>
+        <% }); %>
+        <p class="muted" style="margin-top:12px"><%= locale === 'en' ? 'If the ticker has no manual items it automatically shows these.' : 'টিকারে ম্যানুয়াল আইটেম না থাকলে এগুলো স্বয়ংক্রিয়ভাবে দেখানো হয়।' %></p>
+      </div>
+    </div>
+  </div>
+</div>
+
+<%- include('_shell-close') %>
diff --git a/src/views/admin/two-factor.ejs b/src/views/admin/two-factor.ejs
new file mode 100644
index 0000000..781d898
--- /dev/null
+++ b/src/views/admin/two-factor.ejs
@@ -0,0 +1,29 @@
+<!doctype html>
+<html lang="bn">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="robots" content="noindex, nofollow">
+  <title>টু-ফ্যাক্টর যাচাই · নিউজপালস ২৪</title>
+  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'">
+  <link rel="stylesheet" href="/assets/css/admin.css?v=1.0.0">
+</head>
+<body>
+<div class="login-wrap">
+  <div class="login-card">
+    <div class="brand"><span class="mark">2FA</span><span><h1>দ্বি-স্তর যাচাই</h1><p class="sub">আপনার অথেনটিকেটর অ্যাপের ৬ সংখ্যার কোড দিন</p></span></div>
+    <% if (typeof error !== 'undefined' && error) { %><div class="flash flash--err">⚠ <%= error %></div><% } %>
+    <form method="post" action="/admin/2fa">
+      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
+      <div class="field">
+        <label for="token">কোড</label>
+        <input id="token" name="token" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autocomplete="one-time-code" autofocus
+               style="text-align:center;font-size:26px;letter-spacing:.4em;font-family:var(--font-en)">
+      </div>
+      <button class="btn" type="submit">যাচাই করুন</button>
+    </form>
+    <div class="foot"><a href="/admin/login" style="color:var(--red-700)">← অন্য অ্যাকাউন্টে লগইন</a></div>
+  </div>
+</div>
+</body>
+</html>
diff --git a/src/views/admin/users.ejs b/src/views/admin/users.ejs
new file mode 100644
index 0000000..25f9508
--- /dev/null
+++ b/src/views/admin/users.ejs
@@ -0,0 +1,111 @@
+<%- include('_shell-open') %>
+
+<div class="grid-side">
+  <div>
+    <div class="panel">
+      <div class="panel__head">👥 <%= locale === 'en' ? 'Team & roles' : 'দল ও ভূমিকা' %></div>
+      <div class="panel__body tight table-wrap">
+        <table class="tbl">
+          <thead><tr><th><%= locale === 'en' ? 'User' : 'ব্যবহারকারী' %></th><th><%= locale === 'en' ? 'Role' : 'ভূমিকা' %></th><th><%= locale === 'en' ? '2FA' : '২এফএ' %></th><th><%= locale === 'en' ? 'Sessions' : 'সেশন' %></th><th><%= locale === 'en' ? 'Last login' : 'শেষ লগইন' %></th><th></th></tr></thead>
+          <tbody>
+            <% rows.forEach(function (u) { %>
+              <tr>
+                <td>
+                  <b><%= u.name %></b>
+                  <div class="small muted"><%= u.email %><% if (u.locked_until) { %> · <span class="tag tag--err">locked</span><% } %></div>
+                </td>
+                <td>
+                  <form method="post" action="/admin/users/<%= u.id %>" class="row" style="gap:5px">
+                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
+                    <input type="hidden" name="name" value="<%= u.name %>">
+                    <input type="hidden" name="status" value="<%= u.status %>">
+                    <select name="role" style="padding:4px 6px;border:1px solid var(--line);border-radius:6px;font-size:13px">
+                      <% Object.keys(roles).forEach(function (r) { %>
+                        <option value="<%= r %>" <%= u.role === r ? 'selected' : '' %>><%= roles[r].label %></option>
+                      <% }); %>
+                    </select>
+                    <button class="btn btn--ghost btn--sm" type="submit"><%= locale === 'en' ? 'Save' : 'সংরক্ষণ' %></button>
+                  </form>
+                  <div class="small muted" style="margin-top:4px">
+                    <%= roles[u.role] ? roles[u.role].permissions.join(', ') : '' %>
+                  </div>
+                </td>
+                <td><span class="tag tag--<%= u.two_factor_on ? 'ok' : 'warn' %>"><%= u.two_factor_on ? (locale === 'en' ? 'on' : 'চালু') : (locale === 'en' ? 'off' : 'বন্ধ') %></span></td>
+                <td class="num"><%= h.bnNumber(u.active_sessions) %></td>
+                <td class="small muted"><%= u.last_login_at ? h.timeAgo(u.last_login_at, locale) : '—' %></td>
+                <td class="actions">
+                  <form method="post" action="/admin/users/<%= u.id %>/sessions/revoke" style="display:inline">
+                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
+                    <button class="btn btn--ghost btn--sm" type="submit"><%= locale === 'en' ? 'Sign out all' : 'সব সেশন বন্ধ' %></button>
+                  </form>
+                  <% if (u.id !== user.id) { %>
+                    <form method="post" action="/admin/users/<%= u.id %>/delete" data-confirm="<%= locale === 'en' ? 'Delete this user and their sessions?' : 'ব্যবহারকারী মুছে ফেলবেন?' %>" style="display:inline">
+                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
+                      <button class="btn btn--danger btn--sm" type="submit">✕</button>
+                    </form>
+                  <% } %>
+                </td>
+              </tr>
+            <% }); %>
+          </tbody>
+        </table>
+      </div>
+    </div>
+
+    <div class="panel">
+      <div class="panel__head">➕ <%= locale === 'en' ? 'Invite a team member' : 'নতুন সদস্য যোগ' %></div>
+      <div class="panel__body">
+        <form method="post" action="/admin/users">
+          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
+          <div class="field-row">
+            <div class="field"><label for="name"><%= locale === 'en' ? 'Full name *' : 'নাম *' %></label><input id="name" name="name" required maxlength="80"></div>
+            <div class="field"><label for="email"><%= locale === 'en' ? 'Email *' : 'ইমেইল *' %></label><input id="email" name="email" type="email" required maxlength="160"></div>
+          </div>
+          <div class="field-row">
+            <div class="field"><label for="password"><%= locale === 'en' ? 'Temporary password *' : 'অস্থায়ী পাসওয়ার্ড *' %></label><input id="password" name="password" type="text" required maxlength="200"><span class="hint"><%= locale === 'en' ? 'Min 10 chars, must include a letter and a number.' : 'কমপক্ষে ১০ অক্ষর, অক্ষর ও সংখ্যা থাকতে হবে।' %></span></div>
+            <div class="field">
+              <label for="role"><%= locale === 'en' ? 'Role' : 'ভূমিকা' %></label>
+              <select id="role" name="role">
+                <% Object.keys(roles).forEach(function (r) { %><option value="<%= r %>"><%= roles[r].label %></option><% }); %>
+              </select>
+            </div>
+          </div>
+          <div class="field-row">
+            <div class="field"><label for="designation"><%= locale === 'en' ? 'Designation' : 'পদবি' %></label><input id="designation" name="designation" maxlength="120"></div>
+            <div class="field"><label for="bio"><%= locale === 'en' ? 'Short bio' : 'সংক্ষিপ্ত পরিচয়' %></label><input id="bio" name="bio" maxlength="1000"></div>
+          </div>
+          <button class="btn" type="submit"><%= locale === 'en' ? 'Create account' : 'অ্যাকাউন্ট তৈরি' %></button>
+        </form>
+        <p class="small muted" style="margin-top:10px">
+          <%= locale === 'en'
+            ? 'An author profile is created automatically so stories can be bylined. Permissions come from the role, never from the individual account.'
+            : 'লেখক প্রোফাইল স্বয়ংক্রিয়ভাবে তৈরি হয়। অনুমতি ভূমিকা থেকে আসে, ব্যক্তিগত অ্যাকাউন্ট থেকে নয়।' %>
+        </p>
+      </div>
+    </div>
+  </div>
+
+  <div>
+    <div class="panel">
+      <div class="panel__head">🖥 <%= locale === 'en' ? 'Active sessions' : 'সক্রিয় সেশন' %></div>
+      <div class="panel__body tight table-wrap">
+        <table class="tbl">
+          <tbody>
+            <% sessions.forEach(function (s) { %>
+              <tr>
+                <td>
+                  <b class="small"><%= s.user_name %></b>
+                  <div class="small muted"><%= (s.user_agent || '').slice(0, 40) %></div>
+                  <div class="small muted"><%= h.timeAgo(s.last_seen_at, locale) %> · <%= locale === 'en' ? 'expires' : 'মেয়াদ' %> <%= h.timeAgo(s.expires_at, locale) %></div>
+                </td>
+              </tr>
+            <% }); %>
+            <% if (!sessions.length) { %><tr><td class="muted"><%= locale === 'en' ? 'No active sessions.' : 'কোনো সক্রিয় সেশন নেই।' %></td></tr><% } %>
+          </tbody>
+        </table>
+      </div>
+    </div>
+  </div>
+</div>
+
+<%- include('_shell-close') %>
diff --git a/src/views/advertise.ejs b/src/views/advertise.ejs
new file mode 100644
index 0000000..ea8bbe8
--- /dev/null
+++ b/src/views/advertise.ejs
@@ -0,0 +1,57 @@
+<%- include('partials/head') %>
+<%- include('partials/header') %>
+
+<div class="wrap layout layout--full">
+  <main id="main" style="max-width:900px;margin:0 auto;width:100%">
+    <article class="static-page">
+      <h1 style="font-size:30px"><%= locale === 'en' ? 'Advertise with NewsPulse 24' : 'নিউজপালস ২৪-এ বিজ্ঞাপন দিন' %></h1>
+      <p style="font-size:18px;color:var(--text-2)">
+        <%= locale === 'en'
+          ? 'Reach readers across Bangladesh and the diaspora with clean, viewable placements — never intrusive, always clearly labelled.'
+          : 'বাংলাদেশ ও প্রবাসে ছড়িয়ে থাকা পাঠকদের কাছে পৌঁছান পরিষ্কার ও দৃশ্যমান স্লটে — কখনোই বিরক্তিকর নয়, সবসময় স্পষ্টভাবে চিহ্নিত।' %>
+      </p>
+
+      <h2><%= locale === 'en' ? 'Available inventory' : 'উপলব্ধ স্লট' %></h2>
+      <table class="slot-table">
+        <thead><tr>
+          <th><%= locale === 'en' ? 'Slot' : 'স্লট' %></th>
+          <th><%= locale === 'en' ? 'Placement' : 'অবস্থান' %></th>
+          <th><%= locale === 'en' ? 'Devices' : 'ডিভাইস' %></th>
+        </tr></thead>
+        <tbody>
+          <% slots.forEach(function (s) { %>
+            <tr>
+              <td><code><%= s.id %></code></td>
+              <td><%= s.label %></td>
+              <td><%= s.group === 'all' ? (locale === 'en' ? 'All' : 'সব') : s.group %></td>
+            </tr>
+          <% }); %>
+        </tbody>
+      </table>
+
+      <h2><%= locale === 'en' ? 'What we offer' : 'আমরা যা দিই' %></h2>
+      <ul>
+        <li><%= locale === 'en' ? 'Direct-sold display, native sponsored cards and video placements.' : 'ডিসপ্লে, নেটিভ স্পনসরড কার্ড ও ভিডিও প্লেসমেন্ট।' %></li>
+        <li><%= locale === 'en' ? 'Targeting by device, country and news category.' : 'ডিভাইস, দেশ ও বিভাগ অনুযায়ী টার্গেটিং।' %></li>
+        <li><%= locale === 'en' ? 'Full impression, click and CTR reporting in the dashboard.' : 'ইমপ্রেশন, ক্লিক ও CTR-এর পূর্ণ রিপোর্ট।' %></li>
+        <li><%= locale === 'en' ? 'Every creative is labelled “Advertisement” — we do not disguise ads as news.' : 'প্রতিটি বিজ্ঞাপনে “বিজ্ঞাপন” লেখা থাকে — বিজ্ঞাপনকে সংবাদ সাজানো হয় না।' %></li>
+        <li><%= locale === 'en' ? 'Third-party scripts run in a sandboxed frame, so they cannot touch reader data.' : 'থার্ড-পার্টি স্ক্রিপ্ট স্যান্ডবক্সড ফ্রেমে চলে, পাঠকের তথ্যে প্রবেশ করতে পারে না।' %></li>
+      </ul>
+
+      <h2><%= locale === 'en' ? 'Get in touch' : 'যোগাযোগ' %></h2>
+      <p>
+        <a class="btn" href="mailto:<%= site.contact_email %>?subject=Advertising%20enquiry">
+          📧 <%= site.contact_email %>
+        </a>
+        <a class="btn btn--ghost" href="tel:<%= site.contact_phone.replace(/\s/g, '') %>">📞 <%= site.contact_phone %></a>
+      </p>
+      <p class="muted small">
+        <%= locale === 'en'
+          ? 'Programmatic buyers: our ads.txt is published at /ads.txt. Editorial staff never see advertiser data and advertisers never influence coverage.'
+          : 'প্রোগ্রাম্যাটিক ক্রেতারা: আমাদের ads.txt আছে /ads.txt ঠিকানায়। সম্পাদকীয় টিম বিজ্ঞাপনদাতার তথ্য দেখে না এবং বিজ্ঞাপনদাতা সংবাদে হস্তক্ষেপ করতে পারে না।' %>
+      </p>
+    </article>
+  </main>
+</div>
+
+<%- include('partials/footer') %>
diff --git a/src/views/article.ejs b/src/views/article.ejs
new file mode 100644
index 0000000..f6ebb38
--- /dev/null
+++ b/src/views/article.ejs
@@ -0,0 +1,228 @@
+<%- include('partials/head', { ogImage: article.cover ? (article.cover.startsWith('http') ? article.cover : publicUrl + article.cover) : '' }) %>
+<%- include('partials/header') %>
+
+<div class="wrap layout">
+  <main id="main">
+    <article class="article" data-font="md" itemscope itemtype="https://schema.org/NewsArticle">
+      <nav class="article__crumb" aria-label="Breadcrumb">
+        <a href="/"><%= locale === 'en' ? 'Home' : 'প্রচ্ছদ' %></a> ›
+        <% if (article.category) { %><a href="/category/<%= article.categorySlug %>"><%= article.category %></a> ›<% } %>
+        <span aria-current="page"><%= locale === 'en' ? 'Story' : 'সংবাদ' %></span>
+      </nav>
+
+      <div class="row" style="gap:7px;margin-bottom:10px">
+        <% if (article.category) { %><a href="/category/<%= article.categorySlug %>"><span class="badge-cat" <%= article.categoryColor ? 'style="background:' + article.categoryColor + '"' : '' %>><%= article.category %></span></a><% } %>
+        <% if (Number(article.is_breaking)) { %><span class="badge-cat badge-live"><%= locale === 'en' ? 'BREAKING' : 'ব্রেকিং' %></span><% } %>
+        <% if (Number(article.is_sponsored)) { %><span class="badge-cat badge-cat--dark"><%= article.sponsor_label || (locale === 'en' ? 'Sponsored' : 'স্পনসরড') %></span><% } %>
+        <% if (Number(article.is_demo)) { %><span class="chip-demo"><%= locale === 'en' ? 'Demo content — replace from Admin' : 'নমুনা কনটেন্ট — অ্যাডমিন থেকে বদলান' %></span><% } %>
+        <% if (article.corrected_at) { %><span class="badge-cat" style="background:var(--warn,#b26a00)"><%= locale === 'en' ? 'Corrected' : 'সংশোধিত' %></span><% } %>
+      </div>
+
+      <h1 itemprop="headline"><%= article.title %></h1>
+      <% if (article.subtitle) { %><p class="article__sub" itemprop="alternativeHeadline"><%= article.subtitle %></p><% } %>
+
+      <div class="article__meta">
+        <div class="article__author">
+          <span class="avatar" aria-hidden="true"><%= (article.author_name || 'NP').slice(0, 1).toUpperCase() %></span>
+          <span>
+            <% if (article.author_slug) { %>
+              <b><a href="/author/<%= article.author_slug %>" itemprop="author"><%= article.author_name %></a></b>
+            <% } else { %>
+              <b itemprop="author"><%= article.author_name || site.site_name_bn %></b>
+            <% } %>
+            <span class="small"><%= article.author_designation || (locale === 'en' ? 'Newsroom' : 'সংবাদ কক্ষ') %></span>
+          </span>
+        </div>
+        <span class="dot"></span>
+        <time datetime="<%= article.published_at || '' %>" itemprop="datePublished"><%= h.formatDateTime(article.published_at, locale) %></time>
+        <% if (article.updated_at && article.updated_at !== article.published_at) { %>
+          <span class="dot"></span>
+          <span><%= locale === 'en' ? 'Updated' : 'হালনাগাদ' %>: <time datetime="<%= article.updated_at %>" itemprop="dateModified"><%= h.timeAgo(article.updated_at, locale) %></time></span>
+        <% } %>
+        <span class="dot"></span>
+        <span><%= locale === 'en' ? h.bnNumber(article.read_minutes) + ' min read' : h.bnNumber(article.read_minutes) + ' মিনিট পড়া' %></span>
+        <span class="dot"></span>
+        <span>👁 <%= article.viewsLabel %></span>
+      </div>
+
+      <% if (corrections.length) { %>
+        <div class="correction-box" role="note">
+          <b><%= locale === 'en' ? 'Corrections & clarifications' : 'সংশোধনী ও স্পষ্টীকরণ' %></b>
+          <ul style="margin:8px 0 0">
+            <% corrections.forEach(function (c) { %>
+              <li><strong><%= c.kind %>:</strong> <%= c.note %> <span class="muted small">— <%= h.formatDate(c.created_at, locale) %><% if (c.editor_name) { %>, <%= c.editor_name %><% } %></span></li>
+            <% }); %>
+          </ul>
+        </div>
+      <% } %>
+
+      <% if (article.cover) { %>
+        <figure class="article__hero">
+          <img src="<%= article.cover %>" alt="<%= article.cover_caption || article.title %>" width="1200" height="675" fetchpriority="high" itemprop="image">
+          <% if (article.cover_caption || article.cover_credit) { %>
+            <figcaption class="article__caption">
+              <%= article.cover_caption %><% if (article.cover_credit) { %> <span class="muted">· <%= locale === 'en' ? 'Photo' : 'ছবি' %>: <%= article.cover_credit %></span><% } %>
+            </figcaption>
+          <% } %>
+        </figure>
+      <% } %>
+
+      <% if (article.embed) { %>
+        <div class="article__hero">
+          <iframe data-src="<%= article.embed %>" title="<%= article.title %>" loading="lazy" allowfullscreen
+                  allow="accelerometer; clipboard-write; encrypted-media; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin"></iframe>
+        </div>
+      <% } %>
+
+      <% if (article.gallery.length) { %>
+        <div class="grid grid--2 article__hero">
+          <% article.gallery.filter(function (g) { return g.src; }).forEach(function (g) { %>
+            <figure style="margin:0"><img src="<%= h.safeUrl(g.src) %>" alt="<%= g.alt || '' %>" loading="lazy"><figcaption class="article__caption"><%= g.alt %></figcaption></figure>
+          <% }); %>
+        </div>
+      <% } %>
+
+      <%- include('partials/ad-slot', { slotId: 'in-article', variantClass: 'ad--inline' }) %>
+
+      <div class="article__body" itemprop="articleBody">
+        <%- bodyHtml %>
+      </div>
+
+      <% if (article.source_name) { %>
+        <p class="muted small" style="margin-top:16px">
+          <%= locale === 'en' ? 'Source' : 'সূত্র' %>:
+          <% if (article.source_url) { %><a href="<%= h.safeUrl(article.source_url) %>" rel="nofollow noopener" target="_blank"><%= article.source_name %></a>
+          <% } else { %><%= article.source_name %><% } %>
+        </p>
+      <% } %>
+
+      <% const tagList = String(article.tags || '').split(',').map(function (t) { return t.trim(); }).filter(Boolean); %>
+      <% if (tagList.length) { %>
+        <div class="article__tags">
+          <% tagList.forEach(function (t) { %>
+            <a class="tag" href="/tag/<%= encodeURIComponent(t) %>" style="padding:5px 11px;border-radius:999px;border:1px solid var(--line);font-size:13px">#<%= t %></a>
+          <% }); %>
+        </div>
+      <% } %>
+
+      <div class="toolbar">
+        <button class="btn btn--ghost btn-like" type="button" data-id="<%= article.id %>">
+          👍 <%= locale === 'en' ? 'Useful' : 'ভালো লেগেছে' %> (<span class="count"><%= article.likes %></span>)
+        </button>
+        <span class="font-ctl" role="group" aria-label="<%= locale === 'en' ? 'Text size' : 'লেখার আকার' %>">
+          <span class="muted small">অ</span>
+          <button type="button" data-size="sm" aria-label="Small text">−</button>
+          <button type="button" data-size="md" aria-label="Normal text">অ</button>
+          <button type="button" data-size="lg" aria-label="Large text">+</button>
+        </span>
+        <button class="btn btn--ghost copy-link" type="button"><%= locale === 'en' ? 'Copy link' : 'লিংক কপি' %></button>
+        <span class="muted small" style="margin-left:auto"><%= locale === 'en' ? 'Share' : 'শেয়ার' %>:</span>
+        <span class="share-row">
+          <a class="fb" data-share="facebook" data-article="<%= article.id %>" rel="nofollow noopener" target="_blank"
+             href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(publicUrl + article.url) %>">Facebook</a>
+          <a class="x" data-share="x" data-article="<%= article.id %>" rel="nofollow noopener" target="_blank"
+             href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(publicUrl + article.url) %>&text=<%= encodeURIComponent(article.title) %>">X</a>
+          <a class="wa" data-share="whatsapp" data-article="<%= article.id %>" rel="nofollow noopener" target="_blank"
+             href="https://wa.me/?text=<%= encodeURIComponent(article.title + ' ' + publicUrl + article.url) %>">WhatsApp</a>
+          <a class="tg" data-share="telegram" data-article="<%= article.id %>" rel="nofollow noopener" target="_blank"
+             href="https://t.me/share/url?url=<%= encodeURIComponent(publicUrl + article.url) %>">Telegram</a>
+        </span>
+      </div>
+
+      <div class="correction-box" style="background:var(--paper-2);border-color:var(--line)">
+        <b><%= locale === 'en' ? 'Spotted an error?' : 'ভুল পেয়েছেন?' %></b>
+        <p style="margin:6px 0 0">
+          <%= locale === 'en'
+            ? 'We correct openly and keep the record. Write to corrections@newspulse24.com — see our '
+            : 'আমরা প্রকাশ্যে সংশোধন করি এবং রেকর্ড রাখি। লিখুন corrections@newspulse24.com — দেখুন আমাদের ' %>
+          <a href="/page/editorial-policy"><%= locale === 'en' ? 'corrections policy' : 'সংশোধন নীতিমালা' %></a>
+          · <a href="/corrections"><%= locale === 'en' ? 'all corrections' : 'সব সংশোধনী' %></a>
+        </p>
+      </div>
+
+      <%- include('partials/ad-slot', { slotId: 'after-article' }) %>
+
+      <% if (related.length) { %>
+        <div class="section-head"><h2><%= locale === 'en' ? 'Related news' : 'সম্পর্কিত সংবাদ' %></h2></div>
+        <div class="grid grid--3">
+          <% related.forEach(function (a) { %>
+            <%- include('partials/article-card', { a: a, isCompact: true }) %>
+          <% }); %>
+        </div>
+      <% } %>
+
+      <% if (commentsEnabled) { %>
+        <section class="comments" id="comments">
+          <div class="section-head">
+            <h2>💬 <%= locale === 'en' ? 'Comments' : 'মন্তব্য' %> (<%= h.bnNumber(comments.length) %>)</h2>
+          </div>
+
+          <% comments.forEach(function (c) { %>
+            <div class="comment">
+              <span class="avatar" aria-hidden="true"><%= String(c.name || '?').slice(0, 1).toUpperCase() %></span>
+              <div>
+                <b><%= c.name %></b><time datetime="<%= c.created_at %>"><%= h.timeAgo(c.created_at, locale) %></time>
+                <p><%- c.body %></p>
+              </div>
+            </div>
+          <% }); %>
+
+          <form class="form mt" id="commentForm" novalidate>
+            <input type="hidden" name="article_id" value="<%= article.id %>">
+            <div class="field-row">
+              <div>
+                <label for="cName"><%= locale === 'en' ? 'Your name' : 'আপনার নাম' %> *</label>
+                <input id="cName" name="name" required maxlength="60" autocomplete="name">
+              </div>
+              <div>
+                <label for="cEmail"><%= locale === 'en' ? 'Email (not published)' : 'ইমেইল (প্রকাশ করা হবে না)' %></label>
+                <input id="cEmail" name="email" type="email" maxlength="160" autocomplete="email">
+              </div>
+            </div>
+            <div>
+              <label for="cBody"><%= locale === 'en' ? 'Your comment' : 'আপনার মন্তব্য' %> *</label>
+              <textarea id="cBody" name="body" required maxlength="1500"></textarea>
+            </div>
+            <%# Honeypot — invisible to humans, irresistible to bots. %>
+            <div class="honeypot" aria-hidden="true">
+              <label for="cSite">Website</label>
+              <input id="cSite" name="website" tabindex="-1" autocomplete="off">
+            </div>
+            <div class="row">
+              <button class="btn" type="submit"><%= locale === 'en' ? 'Post comment' : 'মন্তব্য পাঠান' %></button>
+              <span class="form-note"><%= locale === 'en' ? 'Comments are reviewed before publishing.' : 'মন্তব্য প্রকাশের আগে পর্যালোচনা করা হয়।' %></span>
+            </div>
+            <div id="commentResult" role="status" aria-live="polite"></div>
+          </form>
+        </section>
+      <% } %>
+    </article>
+  </main>
+
+  <aside class="sidebar">
+    <%- include('partials/ad-slot', { slotId: 'sidebar-top' }) %>
+    <div class="widget">
+      <div class="widget__head">🔥 <span class="accent"><%= locale === 'en' ? 'Most read' : 'সর্বাধিক পঠিত' %></span></div>
+      <div class="widget__body">
+        <ol class="ranked">
+          <% mostRead.forEach(function (a) { %>
+            <li><a href="<%= a.url %>"><%= a.title %><span class="meta"><%= a.category || '' %> · 👁 <%= h.compactNumber(a.views) %></span></a></li>
+          <% }); %>
+        </ol>
+      </div>
+    </div>
+    <%- include('partials/ad-slot', { slotId: 'sidebar-sticky' }) %>
+    <% if (trending.length) { %>
+      <div class="widget">
+        <div class="widget__head">⚡ <%= locale === 'en' ? 'Trending' : 'ট্রেন্ডিং' %></div>
+        <div class="widget__body tagcloud">
+          <% trending.forEach(function (a) { %>
+            <a href="/news/<%= a.slug %>"><%= a.title_bn.slice(0, 28) %></a>
+          <% }); %>
+        </div>
+      </div>
+    <% } %>
+  </aside>
+</div>
+
+<%- include('partials/footer') %>
diff --git a/src/views/author.ejs b/src/views/author.ejs
new file mode 100644
index 0000000..9092ff8
--- /dev/null
+++ b/src/views/author.ejs
@@ -0,0 +1,32 @@
+<%- include('partials/head') %>
+<%- include('partials/header') %>
+
+<div class="wrap layout">
+  <main id="main">
+    <div class="static-page" style="padding:24px;margin-bottom:18px">
+      <div class="row" style="gap:16px">
+        <span class="article__author" style="gap:14px">
+          <span class="avatar" style="width:64px;height:64px;font-size:24px" aria-hidden="true"><%= author.name.slice(0, 1) %></span>
+        </span>
+        <div>
+          <h1 style="font-size:26px;margin-bottom:2px"><%= author.name %></h1>
+          <p class="muted" style="margin:0"><%= author.designation %></p>
+          <% if (author.bio) { %><p style="margin:8px 0 0;max-width:70ch"><%= author.bio %></p><% } %>
+        </div>
+      </div>
+    </div>
+
+    <div class="section-head"><h2><%= locale === 'en' ? 'Stories by this author' : 'এই লেখকের সংবাদ' %> (<%= h.bnNumber(articles.length) %>)</h2></div>
+    <div class="grid grid--3">
+      <% articles.forEach(function (a) { %>
+        <%- include('partials/article-card', { a: a }) %>
+      <% }); %>
+    </div>
+  </main>
+  <aside class="sidebar">
+    <%- include('partials/ad-slot', { slotId: 'sidebar-top' }) %>
+    <%- include('partials/ad-slot', { slotId: 'sidebar-sticky' }) %>
+  </aside>
+</div>
+
+<%- include('partials/footer') %>
diff --git a/src/views/category.ejs b/src/views/category.ejs
new file mode 100644
index 0000000..b97a463
--- /dev/null
+++ b/src/views/category.ejs
@@ -0,0 +1,47 @@
+<%- include('partials/head') %>
+<%- include('partials/header') %>
+<%- include('partials/ad-slot', { slotId: 'top-leaderboard' }) %>
+
+<div class="wrap layout">
+  <main id="main">
+    <div class="static-page" style="padding:22px 24px;margin-bottom:18px;border-left:5px solid <%= category.color %>">
+      <nav class="article__crumb" aria-label="Breadcrumb">
+        <a href="/"><%= locale === 'en' ? 'Home' : 'প্রচ্ছদ' %></a> › <span><%= locale === 'en' ? category.name_en : category.name_bn %></span>
+      </nav>
+      <h1 style="font-size:27px;margin-bottom:6px"><%= locale === 'en' ? category.name_en : category.name_bn %></h1>
+      <% if (category.description) { %><p class="muted" style="margin:0"><%= category.description %></p><% } %>
+      <p class="muted small" style="margin:8px 0 0"><%= locale === 'en' ? h.bnNumber(total) + ' stories' : h.bnNumber(total) + 'টি সংবাদ' %></p>
+    </div>
+
+    <%- include('partials/ad-slot', { slotId: 'below-ticker' }) %>
+
+    <% if (!articles.length) { %>
+      <div class="static-page"><p><%= locale === 'en' ? 'No stories published in this category yet.' : 'এই বিভাগে এখনো কোনো সংবাদ প্রকাশিত হয়নি।' %></p></div>
+    <% } else { %>
+      <div class="grid grid--3">
+        <% articles.forEach(function (a, i) { %>
+          <%- include('partials/article-card', { a: a }) %>
+          <% if (i === 5) { %><%- include('partials/ad-slot', { slotId: 'between-cards', variantClass: 'ad--inline' }) %><% } %>
+        <% }); %>
+      </div>
+      <%- include('partials/pagination', { page: page, totalPages: totalPages, baseUrl: '/category/' + category.slug }) %>
+    <% } %>
+  </main>
+
+  <aside class="sidebar">
+    <%- include('partials/ad-slot', { slotId: 'sidebar-top' }) %>
+    <div class="widget">
+      <div class="widget__head">🔥 <span class="accent"><%= locale === 'en' ? 'Most read' : 'সর্বাধিক পঠিত' %></span></div>
+      <div class="widget__body">
+        <ol class="ranked">
+          <% mostRead.forEach(function (a) { %>
+            <li><a href="<%= a.url %>"><%= a.title %><span class="meta"><%= a.category || '' %> · 👁 <%= h.compactNumber(a.views) %></span></a></li>
+          <% }); %>
+        </ol>
+      </div>
+    </div>
+    <%- include('partials/ad-slot', { slotId: 'sidebar-sticky' }) %>
+  </aside>
+</div>
+
+<%- include('partials/footer') %>
diff --git a/src/views/corrections.ejs b/src/views/corrections.ejs
new file mode 100644
index 0000000..9b40f27
--- /dev/null
+++ b/src/views/corrections.ejs
@@ -0,0 +1,46 @@
+<%- include('partials/head') %>
+<%- include('partials/header') %>
+
+<div class="wrap layout layout--full">
+  <main id="main" style="max-width:900px;margin:0 auto;width:100%">
+    <article class="static-page">
+      <h1 style="font-size:29px"><%= locale === 'en' ? 'Corrections & clarifications' : 'সংশোধনী ও স্পষ্টীকরণ' %></h1>
+      <p>
+        <%= locale === 'en'
+          ? 'NewsPulse 24 corrects errors openly. When we change a story we say what changed, when, and we keep the record here. We never quietly rewrite a published article.'
+          : 'নিউজপালস ২৪ ভুল প্রকাশ্যে সংশোধন করে। কোনো সংবাদ বদলালে আমরা বলি কী বদলেছে, কখন বদলেছে, এবং সেই রেকর্ড এখানে সংরক্ষিত থাকে। প্রকাশিত সংবাদ চুপচাপ বদলানো হয় না।' %>
+      </p>
+
+      <% if (!corrections.length) { %>
+        <div class="correction-box" style="background:var(--paper-2);border-color:var(--line)">
+          <b><%= locale === 'en' ? 'No corrections on record.' : 'কোনো সংশোধনী নেই।' %></b>
+          <p style="margin:6px 0 0"><%= locale === 'en' ? 'When a story is corrected it will appear here automatically.' : 'কোনো সংবাদ সংশোধন হলে তা স্বয়ংক্রিয়ভাবে এখানে দেখা যাবে।' %></p>
+        </div>
+      <% } else { %>
+        <ul style="list-style:none;padding:0;margin:20px 0 0">
+          <% corrections.forEach(function (c) { %>
+            <li style="border-left:4px solid var(--red);padding:12px 16px;margin-bottom:14px;background:var(--paper-2);border-radius:0 8px 8px 0">
+              <div class="row between">
+                <span class="badge-cat"><%= c.kind %></span>
+                <span class="muted small"><%= c.dateLabel %><% if (c.editor) { %> · <%= c.editor %><% } %></span>
+              </div>
+              <p style="margin:10px 0 6px"><%= c.note %></p>
+              <p class="small muted" style="margin:0"><%= locale === 'en' ? 'Story' : 'সংবাদ' %>: <a href="<%= c.url %>" style="color:var(--red-700)"><%= c.title %></a></p>
+            </li>
+          <% }); %>
+        </ul>
+      <% } %>
+
+      <div class="correction-box" style="margin-top:26px">
+        <b><%= locale === 'en' ? 'Report an error' : 'ভুল জানান' %></b>
+        <p style="margin:6px 0 0">
+          <%= locale === 'en' ? 'Email ' : 'ইমেইল করুন ' %><a href="mailto:corrections@newspulse24.com">corrections@newspulse24.com</a>
+          <%= locale === 'en' ? ' with the story link and what is wrong. We verify every report and reply.' : ' — সংবাদের লিংক ও ভুলটি উল্লেখ করুন। আমরা প্রতিটি অভিযোগ যাচাই করে উত্তর দিই।' %>
+        </p>
+        <p class="small muted" style="margin:8px 0 0"><a href="/page/editorial-policy"><%= locale === 'en' ? 'Read the full editorial & corrections policy →' : 'সম্পূর্ণ সম্পাদকীয় ও সংশোধন নীতিমালা পড়ুন →' %></a></p>
+      </div>
+    </article>
