+          </div>
+
+          <fieldset>
+            <legend><%= locale === 'en' ? 'Text / house ad' : 'টেক্সট / হাউজ অ্যাড' %></legend>
+            <div class="field"><label for="headline"><%= locale === 'en' ? 'Headline' : 'শিরোনাম' %></label><input id="headline" name="headline" maxlength="120" value="<%= val('headline') %>"></div>
+            <div class="field"><label for="body"><%= locale === 'en' ? 'Body' : 'বিবরণ' %></label><textarea id="body" name="body" maxlength="500" style="min-height:70px"><%= val('body') %></textarea></div>
+            <div class="field-row">
+              <div class="field"><label for="cta"><%= locale === 'en' ? 'Button text' : 'বাটনের লেখা' %></label><input id="cta" name="cta" maxlength="40" value="<%= val('cta') %>"></div>
+              <div class="field"><label for="link_url"><%= locale === 'en' ? 'Destination URL' : 'গন্তব্য লিংক' %></label><input id="link_url" name="link_url" maxlength="600" value="<%= val('link_url') %>"></div>
+            </div>
+          </fieldset>
+
+          <fieldset>
+            <legend><%= locale === 'en' ? 'Image / video' : 'ছবি / ভিডিও' %></legend>
+            <div class="field-row">
+              <div class="field"><label for="image_url"><%= locale === 'en' ? 'Image URL' : 'ছবির লিংক' %></label><input id="image_url" name="image_url" maxlength="600" value="<%= val('image_url') %>"></div>
+              <div class="field"><label for="video_url"><%= locale === 'en' ? 'Video URL' : 'ভিডিও লিংক' %></label><input id="video_url" name="video_url" maxlength="600" value="<%= val('video_url') %>"></div>
+            </div>
+            <% if (recentMedia.length) { %>
+              <details><summary class="small muted" style="cursor:pointer"><%= locale === 'en' ? 'Pick from media library' : 'মিডিয়া লাইব্রেরি থেকে বাছুন' %></summary>
+                <div class="media-grid" style="margin-top:10px">
+                  <% recentMedia.forEach(function (m) { %>
+                    <div class="media-item"><img src="<%= m.url %>" alt="" loading="lazy"><div class="meta"><code data-copy="<%= m.url %>"><%= m.url.slice(-16) %></code></div></div>
+                  <% }); %>
+                </div>
+              </details>
+            <% } %>
+          </fieldset>
+
+          <fieldset>
+            <legend><%= locale === 'en' ? 'Custom HTML / third-party script (sandboxed)' : 'কাস্টম HTML / থার্ড-পার্টি স্ক্রিপ্ট (স্যান্ডবক্সড)' %></legend>
+            <div class="field">
+              <label for="html"><%= locale === 'en' ? 'HTML creative' : 'HTML ক্রিয়েটিভ' %></label>
+              <textarea id="html" name="html" style="min-height:110px;font-family:ui-monospace,monospace;font-size:13px"><%= val('html') %></textarea>
+            </div>
+            <div class="field">
+              <label for="script_src"><%= locale === 'en' ? 'Script URL (allowlisted domains only)' : 'স্ক্রিপ্ট লিংক (শুধু অনুমোদিত ডোমেইন)' %></label>
+              <input id="script_src" name="script_src" maxlength="600" value="<%= val('script_src') %>">
+              <span class="hint">
+                🛡️ <%= locale === 'en'
+                  ? 'Rendered in a sandboxed frame with its own CSP — it cannot read our cookies or DOM. Only these hosts are accepted: '
+                  : 'স্যান্ডবক্সড ফ্রেমে রেন্ডার হয় — আমাদের কুকি বা DOM পড়তে পারে না। শুধু এই হোস্ট গ্রহণযোগ্য: ' %>
+                <code class="small">pagead2.googlesyndication.com, tpc.googlesyndication.com, cdn.ampproject.org</code>
+              </span>
+            </div>
+          </fieldset>
+        </div>
+      </div>
+    </div>
+
+    <div>
+      <div class="panel">
+        <div class="panel__head">🚀 <%= locale === 'en' ? 'Delivery' : 'ডেলিভারি' %></div>
+        <div class="panel__body">
+          <div class="field">
+            <label for="status"><%= locale === 'en' ? 'Status' : 'স্ট্যাটাস' %></label>
+            <select id="status" name="status">
+              <% ['active', 'paused', 'expired'].forEach(function (s) { %>
+                <option value="<%= s %>" <%= val('status', 'active') === s ? 'selected' : '' %>><%= s %></option>
+              <% }); %>
+            </select>
+          </div>
+          <div class="field-row">
+            <div class="field"><label for="priority"><%= locale === 'en' ? 'Priority (1 = first)' : 'অগ্রাধিকার' %></label><input id="priority" name="priority" type="number" min="1" max="1000" value="<%= val('priority', 50) %>"></div>
+            <div class="field"><label for="weight"><%= locale === 'en' ? 'Weight' : 'ওয়েট' %></label><input id="weight" name="weight" type="number" min="1" max="10000" value="<%= val('weight', 100) %>"></div>
+          </div>
+          <div class="field"><label for="daily_cap"><%= locale === 'en' ? 'Daily cap (0 = unlimited)' : 'দৈনিক সীমা (০ = অসীম)' %></label><input id="daily_cap" name="daily_cap" type="number" min="0" value="<%= val('daily_cap', 0) %>"></div>
+          <div class="field-row">
+            <div class="field"><label for="starts_at"><%= locale === 'en' ? 'Starts (UTC)' : 'শুরু' %></label><input id="starts_at" name="starts_at" placeholder="2026-01-01T00:00:00Z" value="<%= val('starts_at') %>"></div>
+            <div class="field"><label for="ends_at"><%= locale === 'en' ? 'Ends (UTC)' : 'শেষ' %></label><input id="ends_at" name="ends_at" placeholder="2026-12-31T23:59:59Z" value="<%= val('ends_at') %>"></div>
+          </div>
+          <button class="btn" type="submit" style="width:100%"><%= ad ? (locale === 'en' ? 'Save campaign' : 'সংরক্ষণ') : (locale === 'en' ? 'Create campaign' : 'ক্যাম্পেইন তৈরি') %></button>
+        </div>
+      </div>
+
+      <div class="panel">
+        <div class="panel__head">🎯 <%= locale === 'en' ? 'Targeting' : 'টার্গেটিং' %></div>
+        <div class="panel__body">
+          <div class="field">
+            <label for="target_devices"><%= locale === 'en' ? 'Devices (csv)' : 'ডিভাইস (কমা দিয়ে)' %></label>
+            <input id="target_devices" name="target_devices" maxlength="60" value="<%= val('target_devices') %>" placeholder="desktop,mobile,tablet">
+          </div>
+          <div class="field">
+            <label for="target_countries"><%= locale === 'en' ? 'Countries (ISO codes, csv)' : 'দেশ (ISO কোড)' %></label>
+            <input id="target_countries" name="target_countries" maxlength="200" value="<%= val('target_countries') %>" placeholder="BD,SA,AE,US">
+          </div>
+          <div class="field">
+            <label for="target_categories"><%= locale === 'en' ? 'Category slugs (csv)' : 'বিভাগ স্লাগ' %></label>
+            <input id="target_categories" name="target_categories" maxlength="400" value="<%= val('target_categories') %>" placeholder="sports,economy">
+            <span class="hint">
+              <% categories.forEach(function (c) { %><code class="small"><%= c.slug %></code> <% }); %>
+            </span>
+          </div>
+        </div>
+      </div>
+    </div>
+  </div>
+</form>
+
+<%- include('_shell-close') %>
diff --git a/src/views/admin/ads.ejs b/src/views/admin/ads.ejs
new file mode 100644
index 0000000..22bf351
--- /dev/null
+++ b/src/views/admin/ads.ejs
@@ -0,0 +1,105 @@
+<%- include('_shell-open') %>
+
+<div class="cards">
+  <div class="stat"><span class="label"><%= locale === 'en' ? 'Impressions (30d)' : 'ইমপ্রেশন (৩০দি)' %></span><span class="value"><%= h.bnNumber(stats.impressions) %></span></div>
+  <div class="stat"><span class="label"><%= locale === 'en' ? 'Clicks (30d)' : 'ক্লিক (৩০দি)' %></span><span class="value"><%= h.bnNumber(stats.clicks) %></span></div>
+  <div class="stat alt"><span class="label">CTR</span><span class="value"><%= stats.ctr.toFixed(2) %>%</span></div>
+  <div class="stat alt"><span class="label"><%= locale === 'en' ? 'Campaigns' : 'ক্যাম্পেইন' %></span><span class="value"><%= h.bnNumber(rows.length) %></span></div>
+</div>
+
+<div class="grid-2">
+  <div class="panel">
+    <div class="panel__head">📍 <%= locale === 'en' ? 'Impressions by slot' : 'স্লট অনুযায়ী ইমপ্রেশন' %></div>
+    <div class="panel__body">
+      <div class="donut">
+        <% const maxSlot = Math.max.apply(null, stats.bySlot.map(function (s) { return s.impressions; }).concat([1])); %>
+        <% stats.bySlot.forEach(function (s) { %>
+          <div class="row">
+            <span style="font-size:12px"><%= s.slot %></span>
+            <span class="track"><span class="fill" style="width:<%= Math.round((s.impressions / maxSlot) * 100) %>%"></span></span>
+            <span class="val"><%= h.bnNumber(s.impressions) %></span>
+          </div>
+        <% }); %>
+        <% if (!stats.bySlot.length) { %><p class="muted small" style="margin:0"><%= locale === 'en' ? 'No impressions recorded yet — publish a campaign to start.' : 'এখনো কোনো ইমপ্রেশন নেই।' %></p><% } %>
+      </div>
+    </div>
+  </div>
+  <div class="panel">
+    <div class="panel__head">🌍 <%= locale === 'en' ? 'Impressions by country' : 'দেশ অনুযায়ী ইমপ্রেশন' %></div>
+    <div class="panel__body">
+      <div class="donut">
+        <% const maxC = Math.max.apply(null, stats.byCountry.map(function (s) { return s.impressions; }).concat([1])); %>
+        <% stats.byCountry.forEach(function (s) { %>
+          <div class="row">
+            <span><%= s.country || '—' %></span>
+            <span class="track"><span class="fill" style="width:<%= Math.round((s.impressions / maxC) * 100) %>%"></span></span>
+            <span class="val"><%= h.bnNumber(s.impressions) %></span>
+          </div>
+        <% }); %>
+        <% if (!stats.byCountry.length) { %><p class="muted small" style="margin:0">—</p><% } %>
+      </div>
+    </div>
+  </div>
+</div>
+
+<div class="panel">
+  <div class="panel__head">
+    💰 <%= locale === 'en' ? 'Campaigns' : 'ক্যাম্পেইন' %>
+    <span class="spacer"></span>
+    <a class="btn btn--sm" href="/admin/ads/new">+ <%= locale === 'en' ? 'New campaign' : 'নতুন বিজ্ঞাপন' %></a>
+  </div>
+  <div class="panel__body tight table-wrap">
+    <table class="tbl">
+      <thead><tr>
+        <th><%= locale === 'en' ? 'Campaign' : 'ক্যাম্পেইন' %></th>
+        <th><%= locale === 'en' ? 'Slot' : 'স্লট' %></th>
+        <th><%= locale === 'en' ? 'Type' : 'টাইপ' %></th>
+        <th><%= locale === 'en' ? 'Status' : 'স্ট্যাটাস' %></th>
+        <th class="num"><%= locale === 'en' ? 'Impressions' : 'ইমপ্রেশন' %></th>
+        <th class="num"><%= locale === 'en' ? 'Clicks' : 'ক্লিক' %></th>
+        <th class="num">CTR</th>
+        <th></th>
+      </tr></thead>
+      <tbody>
+        <% rows.forEach(function (a) { %>
+          <tr>
+            <td>
+              <b><%= a.name %></b>
+              <div class="small muted"><%= a.advertiser || '—' %><% if (a.daily_cap) { %> · cap <%= h.bnNumber(a.daily_cap) %>/day (<%= h.bnNumber(a.served_today) %> today)<% } %></div>
+            </td>
+            <td><code class="small"><%= a.slot %></code></td>
+            <td><span class="tag"><%= a.kind %></span></td>
+            <td><span class="tag tag--<%= a.status === 'active' ? 'ok' : 'warn' %>"><%= a.status %></span></td>
+            <td class="num"><%= h.bnNumber(a.impressions) %></td>
+            <td class="num"><%= h.bnNumber(a.clicks) %></td>
+            <td class="num"><%= a.impressions ? ((a.clicks * 100 / a.impressions).toFixed(2) + '%') : '—' %></td>
+            <td class="actions">
+              <a class="btn btn--ghost btn--sm" href="/admin/ads/<%= a.id %>/edit"><%= locale === 'en' ? 'Edit' : 'সম্পাদনা' %></a>
+              <form method="post" action="/admin/ads/<%= a.id %>/delete" data-confirm="<%= locale === 'en' ? 'Delete this campaign?' : 'ক্যাম্পেইন মুছবেন?' %>" style="display:inline">
+                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
+                <button class="btn btn--danger btn--sm" type="submit">✕</button>
+              </form>
+            </td>
+          </tr>
+        <% }); %>
+        <% if (!rows.length) { %><tr><td colspan="8" class="muted"><%= locale === 'en' ? 'No campaigns yet.' : 'এখনো কোনো ক্যাম্পেইন নেই।' %></td></tr><% } %>
+      </tbody>
+    </table>
+  </div>
+</div>
+
+<div class="panel">
+  <div class="panel__head">🧾 <%= locale === 'en' ? 'Ad inventory reference' : 'বিজ্ঞাপন স্লট তালিকা' %></div>
+  <div class="panel__body tight table-wrap">
+    <table class="tbl">
+      <thead><tr><th>Slot ID</th><th><%= locale === 'en' ? 'Placement' : 'অবস্থান' %></th><th><%= locale === 'en' ? 'Devices' : 'ডিভাইস' %></th></tr></thead>
+      <tbody>
+        <% adSlots.forEach(function (s) { %>
+          <tr><td><code><%= s.id %></code></td><td><%= s.label %></td><td><%= s.group %></td></tr>
+        <% }); %>
+      </tbody>
+    </table>
+  </div>
+</div>
+
+<%- include('_shell-close') %>
diff --git a/src/views/admin/analytics.ejs b/src/views/admin/analytics.ejs
new file mode 100644
index 0000000..9dadbc4
--- /dev/null
+++ b/src/views/admin/analytics.ejs
@@ -0,0 +1,119 @@
+<%- include('_shell-open') %>
+<% const d = data; %>
+
+<div class="panel">
+  <div class="panel__head">
+    📈 <%= locale === 'en' ? 'Traffic over time' : 'সময়ের সঙ্গে ট্রাফিক' %>
+    <span class="spacer"></span>
+    <% [7, 30, 90, 180].forEach(function (n) { %>
+      <a class="btn btn--ghost btn--sm <%= Number(days) === n ? 'btn--ink' : '' %>" href="?days=<%= n %>"><%= h.bnNumber(n) %></a>
+    <% }); %>
+  </div>
+  <div class="panel__body">
+    <div class="chart" style="height:260px" data-series='<%- JSON.stringify(d.timeSeries.map(function (r) { return { l: r.day.slice(5), v: r.pageviews }; })) %>'></div>
+  </div>
+</div>
+
+<div class="grid-3">
+  <div class="panel">
+    <div class="panel__head">🌍 <%= locale === 'en' ? 'Countries' : 'দেশ' %></div>
+    <div class="panel__body tight table-wrap">
+      <table class="tbl">
+        <thead><tr><th><%= locale === 'en' ? 'Country' : 'দেশ' %></th><th class="num">Views</th><th class="num">UV</th></tr></thead>
+        <tbody>
+          <% d.countries.forEach(function (c) { %>
+            <tr><td><%= c.country %></td><td class="num"><%= h.bnNumber(c.pageviews) %></td><td class="num"><%= h.bnNumber(c.visitors) %></td></tr>
+          <% }); %>
+          <% if (!d.countries.length) { %><tr><td colspan="3" class="muted">—</td></tr><% } %>
+        </tbody>
+      </table>
+    </div>
+  </div>
+
+  <div class="panel">
+    <div class="panel__head">💻 <%= locale === 'en' ? 'Browser & OS' : 'ব্রাউজার ও ওএস' %></div>
+    <div class="panel__body tight table-wrap">
+      <table class="tbl">
+        <thead><tr><th>Browser</th><th>OS</th><th class="num">Views</th></tr></thead>
+        <tbody>
+          <% d.browsers.forEach(function (b) { %>
+            <tr><td><%= b.browser %></td><td><%= b.os %></td><td class="num"><%= h.bnNumber(b.n) %></td></tr>
+          <% }); %>
+          <% if (!d.browsers.length) { %><tr><td colspan="3" class="muted">—</td></tr><% } %>
+        </tbody>
+      </table>
+    </div>
+  </div>
+
+  <div class="panel">
+    <div class="panel__head">🔁 <%= locale === 'en' ? 'Return visits' : 'পুনরাগমন' %></div>
+    <div class="panel__body">
+      <div class="donut">
+        <% d.retention.forEach(function (r) { %>
+          <div class="row">
+            <span><%= h.bnNumber(r.visit_count) %> <%= locale === 'en' ? 'day(s)' : 'দিন' %></span>
+            <span class="track"><span class="fill" style="width:<%= Math.min(100, r.visitors * 10) %>%"></span></span>
+            <span class="val"><%= h.bnNumber(r.visitors) %></span>
+          </div>
+        <% }); %>
+        <% if (!d.retention.length) { %><p class="muted small" style="margin:0">—</p><% } %>
+      </div>
+    </div>
+  </div>
+</div>
+
+<div class="grid-2">
+  <div class="panel">
+    <div class="panel__head">📄 <%= locale === 'en' ? 'Top pages' : 'জনপ্রিয় পেজ' %></div>
+    <div class="panel__body tight table-wrap">
+      <table class="tbl">
+        <thead><tr><th>Path</th><th class="num">Views</th></tr></thead>
+        <tbody>
+          <% d.topPages.forEach(function (p) { %>
+            <tr><td><a href="<%= p.path %>" target="_blank" rel="noopener"><%= p.path %></a></td><td class="num"><%= h.bnNumber(p.views) %></td></tr>
+          <% }); %>
+          <% if (!d.topPages.length) { %><tr><td colspan="2" class="muted">—</td></tr><% } %>
+        </tbody>
+      </table>
+    </div>
+  </div>
+
+  <div class="panel">
+    <div class="panel__head">🔍 <%= locale === 'en' ? 'What readers search for' : 'পাঠকরা কী খোঁজেন' %></div>
+    <div class="panel__body tight table-wrap">
+      <table class="tbl">
+        <thead><tr><th><%= locale === 'en' ? 'Term' : 'শব্দ' %></th><th class="num"><%= locale === 'en' ? 'Searches' : 'অনুসন্ধান' %></th></tr></thead>
+        <tbody>
+          <% searches.forEach(function (s) { %>
+            <tr><td><%= s.term %></td><td class="num"><%= h.bnNumber(s.hits) %></td></tr>
+          <% }); %>
+          <% if (!searches.length) { %><tr><td colspan="2" class="muted"><%= locale === 'en' ? 'No searches yet.' : 'এখনো কোনো অনুসন্ধান নেই।' %></td></tr><% } %>
+        </tbody>
+      </table>
+    </div>
+  </div>
+</div>
+
+<div class="panel">
+  <div class="panel__head">🧾 <%= locale === 'en' ? 'Raw event log' : 'ইভেন্ট লগ' %></div>
+  <div class="panel__body tight table-wrap">
+    <table class="tbl">
+      <thead><tr><th><%= locale === 'en' ? 'Time' : 'সময়' %></th><th>Event</th><th>Path</th><th>Source</th><th><%= locale === 'en' ? 'Geo' : 'অবস্থান' %></th><th>Device</th></tr></thead>
+      <tbody>
+        <% recentEvents.forEach(function (e) { %>
+          <tr>
+            <td class="small muted"><%= h.timeAgo(e.ts, locale) %></td>
+            <td><span class="tag tag--<%= e.event_type === 'pageview' ? 'ink' : 'ok' %>"><%= e.event_type %></span></td>
+            <td class="small"><%= e.path || '—' %></td>
+            <td class="small"><%= e.source || '—' %></td>
+            <td class="small"><%= e.country || '—' %><% if (e.city) { %> · <%= e.city %><% } %></td>
+            <td class="small"><%= e.device %> / <%= e.browser %></td>
+          </tr>
+        <% }); %>
+        <% if (!recentEvents.length) { %><tr><td colspan="6" class="muted"><%= locale === 'en' ? 'No events yet.' : 'এখনো কোনো ইভেন্ট নেই।' %></td></tr><% } %>
+      </tbody>
+    </table>
+  </div>
+</div>
+
+<%- include('_shell-close') %>
diff --git a/src/views/admin/article-edit.ejs b/src/views/admin/article-edit.ejs
new file mode 100644
index 0000000..3f1a806
--- /dev/null
+++ b/src/views/admin/article-edit.ejs
@@ -0,0 +1,240 @@
+<%- include('_shell-open') %>
+<%
+  const v = values || {};
+  const action = article ? '/admin/articles/' + article.id : '/admin/articles';
+  const val = function (key, fallback) { return v && v[key] !== undefined && v[key] !== null ? v[key] : (fallback === undefined ? '' : fallback); };
+%>
+
+<form method="post" action="<%= action %>" id="articleForm">
+  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
+
+  <div class="grid-side">
+    <div>
+      <div class="panel">
+        <div class="panel__head">
+          ✍️ <%= locale === 'en' ? 'Story' : 'সংবাদ' %>
+          <span class="spacer"></span>
+          <% if (article) { %><a class="btn btn--ghost btn--sm" href="/news/<%= article.slug %>" target="_blank" rel="noopener"><%= locale === 'en' ? 'Preview' : 'প্রিভিউ' %> ↗</a><% } %>
+        </div>
+        <div class="panel__body">
+          <div class="field">
+            <label for="title_bn"><%= locale === 'en' ? 'Headline (Bangla) *' : 'শিরোনাম (বাংলা) *' %></label>
+            <input id="title_bn" name="title_bn" required maxlength="300" value="<%= val('title_bn') %>" data-slug-source>
+          </div>
