+      <% }); %>
+      <a class="navbar__live" href="/live" <%= currentPath === '/live' ? 'aria-current="page"' : '' %>>
+        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="2" fill="currentColor"/><path d="M7.8 16.2a6 6 0 0 1 0-8.4M16.2 7.8a6 6 0 0 1 0 8.4M4.9 19.1a10 10 0 0 1 0-14.2M19.1 4.9a10 10 0 0 1 0 14.2"/></svg>
+        <%= locale === 'en' ? 'Live TV' : 'লাইভ টিভি' %>
+      </a>
+    </div>
+  </div>
+</nav>
+
+<% if (tickerEnabled && ticker && ticker.length) { %>
+<div class="ticker" role="region" aria-label="<%= locale === 'en' ? 'Breaking news ticker' : 'ব্রেকিং নিউজ' %>">
+  <span class="ticker__label"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/></svg> <%= locale === 'en' ? 'BREAKING' : 'ব্রেকিং' %></span>
+  <div class="ticker__viewport">
+    <div class="ticker__track" data-duration="<%= site.ticker_speed || 45 %>">
+      <% ticker.forEach(function (t) { %>
+      <a href="<%= t.slug ? '/news/' + t.slug : '#' %>">
+        <% const cat = locale === 'en' ? (t.category_en || t.category_bn) : t.category_bn; %>
+        <% if (cat) { %><span class="tag"><%= cat %></span><% } %>
+        <%= locale === 'en' ? (t.text_en || t.text_bn) : (t.text_bn || t.text_en) %>
+      </a>
+      <% }); %>
+      <%# Rendered twice for a seamless infinite loop. %>
+      <% ticker.forEach(function (t) { %>
+      <a href="<%= t.slug ? '/news/' + t.slug : '#' %>" aria-hidden="true" tabindex="-1">
+        <% const cat = locale === 'en' ? (t.category_en || t.category_bn) : t.category_bn; %>
+        <% if (cat) { %><span class="tag"><%= cat %></span><% } %>
+        <%= locale === 'en' ? (t.text_en || t.text_bn) : (t.text_bn || t.text_en) %>
+      </a>
+      <% }); %>
+    </div>
+  </div>
+  <span class="ticker__date hide-sm"><%= locale === 'en' ? dateEn : dateBn %> <i>|</i> <%= timeStr %></span>
+</div>
+<% } %>
diff --git a/src/views/partials/pagination.ejs b/src/views/partials/pagination.ejs
new file mode 100644
index 0000000..b46c2a7
--- /dev/null
+++ b/src/views/partials/pagination.ejs
@@ -0,0 +1,16 @@
+<%# Pagination. Expects: page, totalPages, baseUrl (a function or string). %>
+<% if (totalPages > 1) { %>
+  <% const base = typeof baseUrl === 'function' ? baseUrl : function (p) { return baseUrl + (baseUrl.indexOf('?') > -1 ? '&' : '?') + 'page=' + p; }; %>
+  <nav class="pager" aria-label="Pagination">
+    <% if (page > 1) { %><a href="<%= base(page - 1) %>" rel="prev">‹ <%= locale === 'en' ? 'Prev' : 'পূর্ববর্তী' %></a><% } %>
+    <%
+      const from = Math.max(1, page - 2);
+      const to = Math.min(totalPages, from + 4);
+    %>
+    <% for (let p = from; p <= to; p++) { %>
+      <% if (p === page) { %><span class="current" aria-current="page"><%= h.bnNumber(p) %></span>
+      <% } else { %><a href="<%= base(p) %>"><%= h.bnNumber(p) %></a><% } %>
+    <% } %>
+    <% if (page < totalPages) { %><a href="<%= base(page + 1) %>" rel="next"><%= locale === 'en' ? 'Next' : 'পরবর্তী' %> ›</a><% } %>
+  </nav>
+<% } %>
