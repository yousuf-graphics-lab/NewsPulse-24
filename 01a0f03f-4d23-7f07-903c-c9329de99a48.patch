+
+  paths: { root: ROOT_DIR, data: DATA_DIR, uploads: UPLOAD_DIR, backups: BACKUP_DIR },
+  dbFile: path.resolve(ROOT_DIR, process.env.DB_FILE || './data/newspulse24.db'),
+
+  secrets: {
