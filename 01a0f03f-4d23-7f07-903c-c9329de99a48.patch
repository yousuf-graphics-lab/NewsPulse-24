+    <div class="panel__body tight table-wrap">
+      <table class="tbl">
+        <thead><tr><th>Kind</th><th>Severity</th><th class="num">Count</th><th><%= locale === 'en' ? 'Last' : 'শেষ' %></th></tr></thead>
+        <tbody>
+          <% kinds.forEach(function (k) { %>
+            <tr>
+              <td><code class="small"><%= k.kind %></code></td>
+              <td><span class="tag tag--<%= k.severity === 'critical' || k.severity === 'high' ? 'err' : k.severity === 'medium' ? 'warn' : 'ok' %>"><%= k.severity %></span></td>
+              <td class="num"><%= h.bnNumber(k.n) %></td>
+              <td class="small muted"><%= h.timeAgo(k.last, locale) %></td>
+            </tr>
+          <% }); %>
+          <% if (!kinds.length) { %><tr><td colspan="4" class="muted">✓ <%= locale === 'en' ? 'Nothing suspicious recorded.' : 'সন্দেহজনক কিছু নেই।' %></td></tr><% } %>
+        </tbody>
+      </table>
+    </div>
+  </div>
+
+  <div class="panel">
