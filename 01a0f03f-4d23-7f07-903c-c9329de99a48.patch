new file mode 100644
index 0000000..067bfc2
--- /dev/null
+++ b/src/public/css/admin.css
@@ -0,0 +1,251 @@
+/* ============================================================================
+   NewsPulse 24 — admin panel stylesheet
+   Same red/black identity, denser layout, no animation that gets in the way.
+   ========================================================================== */
+
+:root {
+  --red: #e11d2e; --red-600: #c8102e; --red-700: #a50d20;
+  --ink: #0b0b0d; --ink-2: #131318; --ink-3: #1c1c22;
+  --line: #e3e3e8; --paper: #fff; --paper-2: #f4f4f6;
+  --text: #17181d; --text-2: #4a4d57; --muted: #74777f;
+  --ok: #0f7b3f; --ok-bg: #e8f7ee; --warn: #9a6200; --warn-bg: #fff5e0;
+  --err: #a50d20; --err-bg: #fdecec;
+  --font-bn: 'Hind Siliguri', 'Noto Sans Bengali', system-ui, sans-serif;
+  --font-en: 'Inter', system-ui, sans-serif;
+  --side-w: 244px;
+}
+
+* { box-sizing: border-box; }
+body {
+  margin: 0; background: var(--paper-2); color: var(--text);
+  font-family: var(--font-bn); font-size: 15px; line-height: 1.65;
+}
+a { color: inherit; text-decoration: none; }
+h1, h2, h3, h4 { margin: 0 0 10px; line-height: 1.3; }
+img { max-width: 100%; }
+button { font: inherit; cursor: pointer; }
+input, select, textarea { font: inherit; }
+a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible {
+  outline: 3px solid rgba(225, 29, 46, .4); outline-offset: 2px;
+}
+
+/* ------------------------------------------------------------ shell ------ */
+.shell { display: grid; grid-template-columns: var(--side-w) 1fr; min-height: 100vh; }
+.side {
+  background: var(--ink); color: #c8c9d1; display: flex; flex-direction: column;
+  position: sticky; top: 0; height: 100vh; overflow-y: auto;
+}
+.side__brand { padding: 18px 18px 14px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid #1e1e25; }
+.side__brand .mark {
+  width: 36px; height: 36px; border-radius: 9px; background: linear-gradient(145deg, var(--red), var(--red-700));
+  color: #fff; display: grid; place-items: center; font-family: var(--font-en); font-weight: 800; font-size: 12px; flex: none;
+}
+.side__brand b { color: #fff; font-size: 15px; display: block; line-height: 1.2; }
+.side__brand small { color: #7f818b; font-size: 11px; }
+.side__nav { padding: 10px 0; flex: 1; }
+.side__group { padding: 14px 18px 6px; font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: #62646e; font-family: var(--font-en); }
+.side__nav a {
+  display: flex; align-items: center; gap: 10px; padding: 9px 18px; font-size: 14.5px;
+  color: #c8c9d1; border-left: 3px solid transparent; transition: .12s;
+}
+.side__nav a:hover { background: #17171d; color: #fff; }
+.side__nav a.active { background: #17171d; color: #fff; border-left-color: var(--red); }
+.side__nav a .ico { width: 18px; text-align: center; opacity: .85; }
+.side__nav a .count {
+  margin-left: auto; background: var(--red); color: #fff; font-size: 11px;
+  padding: 1px 7px; border-radius: 999px; font-family: var(--font-en);
+}
+.side__foot { padding: 14px 18px; border-top: 1px solid #1e1e25; font-size: 12.5px; color: #7f818b; }
+.side__foot form button {
+  background: none; border: 0; color: #c8c9d1; padding: 0; font-size: 13px; text-align: left;
+}
+.side__foot form button:hover { color: var(--red); }
+
+.main { min-width: 0; display: flex; flex-direction: column; }
+.topbar {
+  background: var(--paper); border-bottom: 1px solid var(--line); padding: 12px 22px;
+  display: flex; align-items: center; gap: 14px; position: sticky; top: 0; z-index: 40;
+}
+.topbar h1 { font-size: 19px; margin: 0; }
+.topbar .spacer { flex: 1; }
+.topbar .who { display: flex; align-items: center; gap: 9px; font-size: 13.5px; color: var(--text-2); }
+.topbar .who .avatar {
+  width: 32px; height: 32px; border-radius: 50%; background: var(--ink); color: #fff;
+  display: grid; place-items: center; font-weight: 700; font-size: 13px;
+}
+.topbar .role {
+  font-size: 11px; background: var(--red-100, #ffe4e7); color: var(--red-700);
+  padding: 1px 8px; border-radius: 999px; font-weight: 700;
+}
+.content { padding: 22px; max-width: 1500px; width: 100%; }
+.menu-toggle { display: none; }
+
+/* ------------------------------------------------------------ cards ------ */
+.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 14px; margin-bottom: 20px; }
+.stat {
+  background: var(--paper); border: 1px solid var(--line); border-radius: 10px; padding: 15px 16px;
+  display: flex; flex-direction: column; gap: 4px; position: relative; overflow: hidden;
+}
+.stat::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--red); }
+.stat .label { font-size: 12.5px; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; }
+.stat .value { font-size: 27px; font-weight: 800; font-family: var(--font-en); letter-spacing: -.02em; }
+.stat .delta { font-size: 12.5px; font-weight: 600; }
+.stat .delta.up { color: var(--ok); } .stat .delta.down { color: var(--red); }
+.stat.alt::before { background: var(--ink); }
+
+.panel { background: var(--paper); border: 1px solid var(--line); border-radius: 10px; margin-bottom: 18px; overflow: hidden; }
+.panel__head {
+  padding: 13px 16px; border-bottom: 1px solid var(--line); display: flex; align-items: center; gap: 10px;
+  font-weight: 700; font-size: 15.5px;
+}
+.panel__head .spacer { flex: 1; }
+.panel__head .sub { font-size: 12.5px; color: var(--muted); font-weight: 500; }
+.panel__body { padding: 16px; }
+.panel__body.tight { padding: 0; }
+.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
+.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
+.grid-side { display: grid; grid-template-columns: 1fr 340px; gap: 18px; align-items: start; }
+
+/* ------------------------------------------------------------ tables ----- */
+.table-wrap { overflow-x: auto; }
+table.tbl { width: 100%; border-collapse: collapse; font-size: 14px; }
+table.tbl th {
+  text-align: left; padding: 10px 12px; background: var(--paper-2); border-bottom: 1px solid var(--line);
+  font-size: 12.5px; text-transform: uppercase; letter-spacing: .04em; color: var(--text-2); white-space: nowrap;
+}
+table.tbl td { padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: middle; }
+table.tbl tr:hover td { background: #fafafb; }
+table.tbl .num { font-family: var(--font-en); text-align: right; white-space: nowrap; }
+table.tbl .actions { display: flex; gap: 6px; flex-wrap: wrap; }
+.thumb { width: 62px; height: 40px; object-fit: cover; border-radius: 5px; background: var(--paper-2); }
+
+/* ------------------------------------------------------------ badges ----- */
+.tag {
+  display: inline-block; font-size: 11.5px; font-weight: 700; padding: 2px 9px;
+  border-radius: 999px; background: var(--paper-2); color: var(--text-2); border: 1px solid var(--line);
+  white-space: nowrap;
+}
+.tag--ok { background: var(--ok-bg); color: var(--ok); border-color: #bfe6cd; }
+.tag--warn { background: var(--warn-bg); color: var(--warn); border-color: #f2dca6; }
+.tag--err { background: var(--err-bg); color: var(--err); border-color: #f6c9cd; }
+.tag--ink { background: var(--ink); color: #fff; border-color: var(--ink); }
+.tag--red { background: var(--red); color: #fff; border-color: var(--red); }
+
+/* ------------------------------------------------------------ buttons ---- */
+.btn {
+  display: inline-flex; align-items: center; gap: 7px; padding: 8px 15px; border-radius: 7px;
+  border: 1px solid transparent; background: var(--red); color: #fff; font-weight: 600; font-size: 14px;
+  transition: .13s; white-space: nowrap;
+}
+.btn:hover { background: var(--red-600); }
+.btn--ghost { background: var(--paper); border-color: var(--line); color: var(--text); }
+.btn--ghost:hover { border-color: var(--red); color: var(--red); }
+.btn--ink { background: var(--ink); } .btn--ink:hover { background: var(--ink-3); }
+.btn--ok { background: var(--ok); } .btn--sm { padding: 5px 10px; font-size: 13px; }
+.btn--danger { background: #b01020; }
+.btn[disabled] { opacity: .55; cursor: not-allowed; }
+
+/* ------------------------------------------------------------- forms ----- */
+.field { display: grid; gap: 5px; margin-bottom: 14px; }
+.field label { font-size: 13px; font-weight: 600; color: var(--text-2); }
+.field input, .field select, .field textarea {
+  width: 100%; padding: 9px 11px; border: 1px solid var(--line); border-radius: 7px;
+  background: var(--paper); color: var(--text); font-size: 14.5px;
+}
+.field input:focus, .field select:focus, .field textarea:focus { border-color: var(--red); outline: none; }
+.field textarea { min-height: 120px; resize: vertical; line-height: 1.7; }
+.field textarea.tall { min-height: 320px; font-family: inherit; }
+.field .hint { font-size: 12px; color: var(--muted); }
+.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
+.field-row-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
+.check { display: flex; align-items: center; gap: 8px; font-size: 14px; margin-bottom: 10px; }
+.check input { width: 17px; height: 17px; accent-color: var(--red); }
+fieldset { border: 1px solid var(--line); border-radius: 8px; padding: 14px; margin: 0 0 16px; }
+legend { font-size: 13px; font-weight: 700; padding: 0 8px; color: var(--text-2); }
+.form-errors { background: var(--err-bg); border: 1px solid #f6c9cd; color: var(--err); padding: 11px 14px; border-radius: 8px; margin-bottom: 14px; font-size: 14px; }
+.form-errors ul { margin: 6px 0 0; padding-left: 18px; }
+
+.flash { padding: 11px 15px; border-radius: 8px; margin-bottom: 16px; font-size: 14px; display: flex; align-items: center; gap: 8px; }
+.flash--ok { background: var(--ok-bg); color: var(--ok); border: 1px solid #bfe6cd; }
+.flash--err { background: var(--err-bg); color: var(--err); border: 1px solid #f6c9cd; }
+
+/* ------------------------------------------------------------ charts ----- */
+.chart { width: 100%; height: 220px; }
+.chart svg { width: 100%; height: 100%; overflow: visible; }
+.chart .bar { fill: var(--red); opacity: .85; }
+.chart .bar:hover { opacity: 1; }
+.chart .grid-line { stroke: var(--line); stroke-width: 1; }
+.chart .axis { font-size: 10px; fill: var(--muted); font-family: var(--font-en); }
+.spark { display: flex; align-items: flex-end; gap: 3px; height: 42px; }
+.spark i { flex: 1; background: var(--red); opacity: .75; border-radius: 2px 2px 0 0; min-height: 2px; }
+.donut { display: flex; flex-direction: column; gap: 8px; }
+.donut .row { display: grid; grid-template-columns: 110px 1fr 54px; align-items: center; gap: 10px; font-size: 13px; }
+.donut .track { height: 8px; background: var(--paper-2); border-radius: 99px; overflow: hidden; }
+.donut .fill { height: 100%; background: var(--red); border-radius: 99px; }
+.donut .val { text-align: right; font-family: var(--font-en); color: var(--text-2); }
+
+/* --------------------------------------------------------- media grid ---- */
+.media-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; }
+.media-item { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; background: var(--paper); }
+.media-item img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: var(--paper-2); }
+.media-item .meta { padding: 7px 8px; font-size: 11.5px; color: var(--muted); display: flex; justify-content: space-between; gap: 6px; align-items: center; }
+.media-item code { font-size: 10px; background: var(--paper-2); padding: 1px 4px; border-radius: 3px; cursor: pointer; }
+
+/* ------------------------------------------------------------ login ------ */
+.login-wrap {
+  min-height: 100vh; display: grid; place-items: center; padding: 20px;
+  background: radial-gradient(1200px 600px at 20% -10%, #2a0a10 0%, var(--ink) 55%);
+}
+.login-card {
+  width: 100%; max-width: 410px; background: var(--paper); border-radius: 14px;
+  padding: 30px 28px; box-shadow: 0 24px 70px rgba(0, 0, 0, .45);
+}
+.login-card .brand { display: flex; align-items: center; gap: 11px; margin-bottom: 20px; }
+.login-card .mark {
+  width: 42px; height: 42px; border-radius: 11px; background: linear-gradient(145deg, var(--red), var(--red-700));
+  color: #fff; display: grid; place-items: center; font-weight: 800; font-family: var(--font-en);
+}
+.login-card h1 { font-size: 21px; margin: 0; }
+.login-card p.sub { color: var(--muted); font-size: 13.5px; margin: 0; }
+.login-card .btn { width: 100%; justify-content: center; padding: 11px; margin-top: 6px; }
+.login-card .foot { margin-top: 16px; font-size: 12px; color: var(--muted); text-align: center; }
+.security-note {
+  margin-top: 18px; font-size: 11.5px; color: var(--muted); border-top: 1px solid var(--line); padding-top: 12px;
+}
+
+/* ------------------------------------------------------- editor toolbar -- */
+.editor { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
+.editor__tools { display: flex; flex-wrap: wrap; gap: 4px; padding: 7px; background: var(--paper-2); border-bottom: 1px solid var(--line); }
+.editor__tools button {
+  border: 1px solid transparent; background: none; padding: 5px 9px; border-radius: 5px; font-size: 13px; color: var(--text-2);
+}
+.editor__tools button:hover { background: var(--paper); border-color: var(--line); color: var(--red); }
+.editor textarea { border: 0; border-radius: 0; min-height: 380px; }
+.editor__foot { display: flex; justify-content: space-between; padding: 6px 10px; background: var(--paper-2); border-top: 1px solid var(--line); font-size: 12px; color: var(--muted); }
+
+.dropzone {
+  border: 2px dashed var(--line); border-radius: 10px; padding: 26px; text-align: center;
+  color: var(--muted); background: var(--paper); transition: .15s; cursor: pointer;
+}
+.dropzone:hover, .dropzone.drag { border-color: var(--red); background: #fffafa; color: var(--red); }
+
+/* --------------------------------------------------------- responsive ---- */
+@media (max-width: 1100px) {
+  .grid-side, .grid-2, .grid-3 { grid-template-columns: 1fr; }
+}
+@media (max-width: 900px) {
+  .shell { grid-template-columns: 1fr; }
+  .side {
+    position: fixed; inset: 0 auto 0 0; width: 264px; z-index: 100;
+    transform: translateX(-100%); transition: transform .2s;
+  }
+  .side[data-open='true'] { transform: none; box-shadow: 0 0 60px rgba(0, 0, 0, .5); }
+  .menu-toggle { display: inline-flex; }
+  .scrim { position: fixed; inset: 0; background: rgba(0, 0, 0, .45); z-index: 99; }
+  .content { padding: 16px; }
+  .field-row, .field-row-3 { grid-template-columns: 1fr; }
+}
+@media print {
+  .side, .topbar, .btn, form { display: none !important; }
+  .shell { grid-template-columns: 1fr; }
+}
diff --git a/src/public/css/site.css b/src/public/css/site.css
