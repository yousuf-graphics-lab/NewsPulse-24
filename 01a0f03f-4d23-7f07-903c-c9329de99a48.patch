+      <form method="post" action="/admin/security/block" class="row" style="gap:6px;margin-bottom:12px">
+        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
+        <input name="ip" required placeholder="203.0.113.45" style="flex:1;padding:8px 11px;border:1px solid var(--line);border-radius:7px">
+        <input name="reason" placeholder="<%= locale === 'en' ? 'reason' : 'কারণ' %>" style="flex:1;padding:8px 11px;border:1px solid var(--line);border-radius:7px">
