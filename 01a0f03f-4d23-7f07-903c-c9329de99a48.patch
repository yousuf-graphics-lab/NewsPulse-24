diff --git a/src/views/partials/ad-slot.ejs b/src/views/partials/ad-slot.ejs
new file mode 100644
index 0000000..12933b4
--- /dev/null
+++ b/src/views/partials/ad-slot.ejs
@@ -0,0 +1,66 @@
+<%# ----------------------------------------------------------------------
+    Ad slot renderer. Templates only describe markup; selection, targeting and
+    measurement live in services/ads.js. Every slot is labelled "বিজ্ঞাপন" so
+    readers can always tell journalism from advertising.
+   ---------------------------------------------------------------------- %>
+<%
+  const data = slot(slotId);
+  const ad = data.ad;
+  const meta = data.meta;
+  const variant = typeof variantClass !== 'undefined' ? variantClass : '';
+  const isSidebar = slotId.indexOf('sidebar') === 0;
+  const isMobileSticky = slotId === 'mobile-banner';
+  const showForDevice = !meta || meta.group === 'all'
+    || (meta.group === 'mobile' && (data.device === 'mobile' || data.device === 'tablet'))
+    || (meta.group === 'desktop' && data.device === 'desktop');
+%>
+<% if (adsEnabled && showForDevice) { %>
+  <div class="ad <%= isSidebar ? 'ad--sidebar' : '' %> <%= isMobileSticky ? 'ad--sticky-mobile' : '' %> <%= variant %>"
+       data-ad-slot="<%= slotId %>"
+       data-ad-id="<%= ad ? ad.id : '' %>"
+       <% if (typeof article !== 'undefined' && article) { %>data-article="<%= article.id %>"<% } %>>
+    <div class="ad__label"><%= locale === 'en' ? 'Advertisement' : 'বিজ্ঞাপন' %></div>
+
+    <% if (ad && ad.kind === 'image' && ad.image_url) { %>
+      <a class="ad__creative" href="<%= ad.link_url || '#' %>" target="_blank" rel="nofollow noopener sponsored"
+         data-ad-click data-ad-id="<%= ad.id %>" data-ad-slot="<%= slotId %>">
+        <img src="<%= h.safeUrl(ad.image_url) %>" alt="<%= ad.headline || 'Advertisement' %>" loading="lazy" decoding="async" width="970" height="90">
+      </a>
+
+    <% } else if (ad && (ad.kind === 'html' || ad.kind === 'script')) { %>
+      <%# Sandboxed: no allow-same-origin, so this frame cannot read our cookies or DOM. %>
+      <iframe src="/ads/frame/<%= ad.id %>" title="<%= ad.name %>" loading="lazy"
+              sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox"
+              referrerpolicy="no-referrer" scrolling="no"></iframe>
+
+    <% } else if (ad && ad.kind === 'video' && ad.video_url) { %>
+      <iframe data-src="<%= h.embedUrl(ad.video_url) %>" title="<%= ad.name %>" loading="lazy" allowfullscreen></iframe>
+
+    <% } else if (ad && ad.kind === 'text') { %>
+      <a class="ad__house" href="<%= ad.link_url || '#' %>" rel="nofollow noopener sponsored"
+         data-ad-click data-ad-id="<%= ad.id %>" data-ad-slot="<%= slotId %>">
+        <div>
+          <h4><%= ad.headline || ad.name %></h4>
+          <p><%= ad.body %></p>
+        </div>
+        <% if (ad.cta) { %><span class="cta"><%= ad.cta %></span><% } %>
+      </a>
+
+    <% } else { %>
+      <div class="ad__frame">
+        <%# House fallback so the layout never collapses when inventory is empty. %>
+        <a class="ad__house" href="/advertise" style="border:0;max-width:100%">
+          <div>
+            <h4><%= locale === 'en' ? 'Advertise with NewsPulse 24' : 'নিউজপালস ২৪-এ বিজ্ঞাপন দিন' %></h4>
+            <p><%= locale === 'en' ? 'This ' + slotId + ' slot is available — see the rate card.' : 'এই ' + slotId + ' স্লটটি খালি আছে — রেট কার্ড দেখুন।' %></p>
+          </div>
+          <span class="cta"><%= locale === 'en' ? 'Rate card' : 'রেট কার্ড' %></span>
+        </a>
+      </div>
+    <% } %>
+
+    <% if (isMobileSticky) { %>
+      <button class="ad__close" type="button" aria-label="<%= locale === 'en' ? 'Close ad' : 'বিজ্ঞাপন বন্ধ করুন' %>">×</button>
+    <% } %>
+  </div>
+<% } %>
diff --git a/src/views/partials/article-card.ejs b/src/views/partials/article-card.ejs
new file mode 100644
index 0000000..441a8fd
--- /dev/null
+++ b/src/views/partials/article-card.ejs
@@ -0,0 +1,35 @@
+<%# Compact news card. `a` is a decorated article; `compact` hides the excerpt. %>
+<%
+  const compact = typeof isCompact !== 'undefined' ? isCompact : false;
+  const cover = a.cover || '';
+%>
+<article class="card">
+  <a class="card__media" href="<%= a.url %>" tabindex="-1" aria-hidden="true">
+    <% if (cover) { %>
+      <img src="<%= cover %>" alt="" loading="lazy" decoding="async" width="640" height="360">
+    <% } else { %>
+      <span class="placeholder">NP24</span>
+    <% } %>
+    <% if (a.media_type === 'video' || a.embed) { %>
+      <span class="card__play"><span>▶</span></span>
+    <% } %>
+  </a>
+  <div class="card__body">
+    <div class="row" style="gap:7px">
+      <% if (a.category) { %>
+        <a href="/category/<%= a.categorySlug %>"><span class="badge-cat" <%= a.categoryColor ? 'style="background:' + a.categoryColor + '"' : '' %>><%= a.category %></span></a>
+      <% } %>
+      <% if (Number(a.is_breaking)) { %><span class="badge-cat badge-live"><%= locale === 'en' ? 'BREAKING' : 'ব্রেকিং' %></span><% } %>
+      <% if (Number(a.is_sponsored)) { %><span class="badge-cat badge-cat--dark"><%= a.sponsor_label || (locale === 'en' ? 'Sponsored' : 'স্পনসরড') %></span><% } %>
+      <% if (Number(a.is_demo)) { %><span class="chip-demo"><%= locale === 'en' ? 'Demo' : 'নমুনা' %></span><% } %>
+    </div>
+    <h3 class="card__title"><a href="<%= a.url %>"><%= a.title %></a></h3>
+    <% if (!compact && a.excerpt) { %><p class="card__excerpt"><%= a.excerpt %></p><% } %>
+    <div class="card__meta">
+      <time datetime="<%= a.published_at || '' %>"><%= a.timeAgo %></time>
+      <span class="dot"></span>
+      <span><%= locale === 'en' ? a.read_minutes + ' min read' : h.bnNumber(a.read_minutes) + ' মিনিট' %></span>
+      <% if (a.views) { %><span class="dot"></span><span>👁 <%= a.viewsLabel %></span><% } %>
+    </div>
+  </div>
+</article>
diff --git a/src/views/partials/assistant.ejs b/src/views/partials/assistant.ejs
new file mode 100644
index 0000000..8f44629
--- /dev/null
+++ b/src/views/partials/assistant.ejs
@@ -0,0 +1,67 @@
+<%# -----------------------------------------------------------------------
+    AI assistant widget — bottom-right on every page.
+    The markup ships from the server so it works even if /api/assistant/config
+    is unreachable; JS only upgrades it with live suggestions and streaming.
+   ----------------------------------------------------------------------- %>
+<% const assistantOn = site.assistant_enabled === '1'; %>
+<% if (assistantOn) { %>
+<button class="ai-fab" id="aiFab" type="button" aria-label="<%= locale === 'en' ? 'Open AI assistant' : 'এআই অ্যাসিস্ট খুলুন' %>" aria-expanded="false" aria-controls="aiPanel">
+  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
+    <path d="M12 3l1.9 4.6L18.5 9.5 13.9 11.4 12 16l-1.9-4.6L5.5 9.5l4.6-1.9z"/>
+    <path d="M18.5 15.5l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/>
