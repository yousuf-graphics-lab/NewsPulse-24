+/* ============================================================================
+   NewsPulse 24 — public stylesheet
+   ----------------------------------------------------------------------------
+   Written by hand, no framework, no build step. One file, ~14 KB gzipped,
+   cached immutably. Red + black identity, light reading surface, dark mode.
+   Breakpoints: 1200 / 992 / 768 / 560.
+   ========================================================================== */
+
+/* ------------------------------------------------------------- tokens ---- */
+:root {
+  --red: #e11d2e;
+  --red-600: #c8102e;
+  --red-700: #a50d20;
+  --red-100: #ffe4e7;
+  --ink: #0b0b0d;
+  --ink-2: #131318;
+  --ink-3: #1c1c22;
+  --line: #e3e3e8;
+  --paper: #ffffff;
+  --paper-2: #f5f5f7;
+  --text: #17181d;
+  --text-2: #4a4d57;
+  --muted: #74777f;
+  --ok: #0f7b3f;
+  --warn: #b26a00;
+
+  --font-bn: 'Hind Siliguri', 'Noto Sans Bengali', 'SolaimanLipi', system-ui, -apple-system, 'Segoe UI', sans-serif;
+  --font-en: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
+
+  --maxw: 1240px;
+  --radius: 10px;
+  --radius-sm: 6px;
+  --shadow-1: 0 1px 2px rgba(11, 11, 13, .06), 0 2px 8px rgba(11, 11, 13, .05);
+  --shadow-2: 0 8px 30px rgba(11, 11, 13, .12);
+  --header-h: 118px;
+}
+
+[data-theme='dark'] {
+  --paper: #0f0f13;
+  --paper-2: #16161b;
+  --text: #e8e8ec;
+  --text-2: #b4b6bd;
+  --muted: #8b8e97;
+  --line: #26262d;
+  --shadow-1: 0 1px 2px rgba(0, 0, 0, .4);
+  --shadow-2: 0 10px 40px rgba(0, 0, 0, .5);
+}
+
+/* ------------------------------------------------------------- reset ----- */
+*, *::before, *::after { box-sizing: border-box; }
+html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
+body {
+  margin: 0;
+  background: var(--paper-2);
+  color: var(--text);
+  font-family: var(--font-bn);
+  font-size: 16px;
+  line-height: 1.75;
+  font-feature-settings: 'kern' 1;
+  -webkit-font-smoothing: antialiased;
+  text-rendering: optimizeLegibility;
+}
+img, video, iframe { max-width: 100%; height: auto; display: block; }
+a { color: inherit; text-decoration: none; }
+a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible {
+  outline: 3px solid rgba(225, 29, 46, .45);
+  outline-offset: 2px;
+}
+button { font: inherit; cursor: pointer; }
+h1, h2, h3, h4 { line-height: 1.35; margin: 0 0 .5rem; font-weight: 700; letter-spacing: -.01em; }
+p { margin: 0 0 1rem; }
+ul { margin: 0 0 1rem; padding-left: 1.2rem; }
+
+.wrap { width: 100%; max-width: var(--maxw); margin: 0 auto; padding: 0 16px; }
+.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+.skip-link {
+  position: absolute; left: -9999px; top: 0; z-index: 200;
+  background: var(--red); color: #fff; padding: 10px 16px; border-radius: 0 0 8px 0;
+}
+.skip-link:focus { left: 0; }
+
+/* ------------------------------------------------------- top strip ------- */
+.topstrip {
+  background: var(--ink);
+  color: #cfcfd6;
+  font-size: 13px;
+  border-bottom: 1px solid #1f1f26;
+}
+.topstrip__in { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 36px; }
+.topstrip__date { display: flex; align-items: center; gap: 8px; white-space: nowrap; }
+.topstrip__date b { color: #fff; font-weight: 600; }
+.topstrip__links { display: flex; align-items: center; gap: 14px; }
+.topstrip__links a { color: #cfcfd6; transition: color .15s; }
+.topstrip__links a:hover { color: var(--red); }
+.pill-live {
+  display: inline-flex; align-items: center; gap: 6px;
+  background: rgba(225, 29, 46, .14); color: #ff8a95;
+  padding: 2px 8px; border-radius: 999px; font-weight: 700; font-size: 12px;
+}
+.pill-live i { width: 7px; height: 7px; border-radius: 50%; background: var(--red); animation: pulse 1.6s infinite; }
+@keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: .35; transform: scale(.7); } }
+
+/* --------------------------------------------------------- masthead ------ */
+.masthead { background: var(--ink); color: #fff; }
+.masthead__in { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 14px 0; }
+.brand { display: flex; align-items: center; gap: 12px; }
+.brand__mark {
+  width: 44px; height: 44px; border-radius: 10px; flex: none;
+  background: linear-gradient(145deg, var(--red) 0%, var(--red-700) 100%);
+  display: grid; place-items: center; color: #fff; font-weight: 800; font-size: 15px;
+  box-shadow: 0 4px 14px rgba(225, 29, 46, .35);
+  font-family: var(--font-en);
+}
+.brand__text { line-height: 1.15; }
+.brand__name { font-size: 24px; font-weight: 800; letter-spacing: -.02em; font-family: var(--font-en); }
+.brand__name span { color: var(--red); }
+.brand__sub { font-size: 12px; color: #9b9da6; letter-spacing: .06em; }
+.masthead__right { display: flex; align-items: center; gap: 10px; }
+.masthead__search { position: relative; }
+.masthead__search input {
+  width: 220px; padding: 9px 34px 9px 12px; border-radius: 999px;
+  border: 1px solid #2b2b33; background: #15151a; color: #fff; font-size: 14px;
+  transition: width .2s, border-color .2s;
+}
+.masthead__search input::placeholder { color: #7d808a; }
+.masthead__search input:focus { width: 260px; border-color: var(--red); outline: none; }
+.masthead__search button {
+  position: absolute; right: 6px; top: 50%; transform: translateY(-50%);
+  background: none; border: 0; color: #9b9da6; padding: 6px;
+}
+.icon-btn {
+  width: 38px; height: 38px; border-radius: 999px; border: 1px solid #2b2b33;
+  background: #15151a; color: #cfcfd6; display: grid; place-items: center; transition: .15s;
+}
+.icon-btn:hover { border-color: var(--red); color: #fff; background: var(--red-700); }
+.btn-admin {
+  background: var(--red); color: #fff; padding: 9px 16px; border-radius: 999px;
+  font-weight: 700; font-size: 14px; border: 0; transition: .15s;
+}
+.btn-admin:hover { background: var(--red-600); }
+.burger { display: none; }
+
+/* ------------------------------------------------------------ navbar ----- */
+.navbar { background: var(--ink-2); border-top: 1px solid #22222a; position: sticky; top: 0; z-index: 60; }
+.navbar.scrolled { box-shadow: 0 4px 18px rgba(0, 0, 0, .35); }
+.navbar__in { display: flex; align-items: stretch; gap: 4px; overflow-x: auto; scrollbar-width: none; }
+.navbar__in::-webkit-scrollbar { display: none; }
+.navbar a {
+  display: inline-flex; align-items: center; gap: 6px;
+  padding: 13px 14px; color: #d6d6dd; font-weight: 600; font-size: 15px;
+  border-bottom: 3px solid transparent; white-space: nowrap; transition: .15s;
+}
+.navbar a:hover, .navbar a[aria-current='page'] { color: #fff; border-bottom-color: var(--red); background: rgba(225, 29, 46, .08); }
+.navbar__home { color: var(--red) !important; font-weight: 800; }
+
+/* ------------------------------------------------------------- ticker ---- */
+.ticker { background: var(--red); color: #fff; display: flex; align-items: stretch; overflow: hidden; }
+.ticker__label {
+  display: inline-flex; align-items: center; gap: 7px; flex: none;
+  background: var(--ink); padding: 0 16px; font-weight: 800; font-size: 13px;
+  letter-spacing: .04em; text-transform: uppercase; position: relative;
+}
+.ticker__label::after {
+  content: ''; position: absolute; right: -12px; top: 0; bottom: 0; width: 14px;
+  background: var(--ink); transform: skewX(-14deg);
+}
+.ticker__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--red); animation: pulse 1.4s infinite; }
+.ticker__viewport { flex: 1; overflow: hidden; position: relative; }
+.ticker__track {
+  display: inline-flex; align-items: center; white-space: nowrap;
+  animation: ticker-scroll var(--ticker-duration, 45s) linear infinite;
+  padding-left: 16px;
+}
+.ticker__viewport:hover .ticker__track, .ticker__track:focus-within { animation-play-state: paused; }
+.ticker__track a {
+  color: #fff; padding: 9px 22px 9px 0; font-weight: 600; font-size: 14.5px;
+  border-right: 1px solid rgba(255, 255, 255, .28); margin-right: 22px;
+}
+.ticker__track a:hover { text-decoration: underline; }
+.ticker__track .tag { background: rgba(0, 0, 0, .35); padding: 1px 7px; border-radius: 4px; font-size: 12px; margin-right: 7px; }
+@keyframes ticker-scroll { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(-50%, 0, 0); } }
+
+/* ------------------------------------------------------------- ads ------- */
+.ad {
+  margin: 18px 0; display: flex; flex-direction: column; align-items: center;
+  min-height: 60px; position: relative;
+}
+.ad__label {
+  font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase;
+  color: var(--muted); margin-bottom: 6px; font-family: var(--font-en);
+}
+.ad__frame {
+  width: 100%; max-width: 970px; min-height: 90px; display: grid; place-items: center;
+  background: repeating-linear-gradient(45deg, var(--paper) 0 10px, var(--paper-2) 10px 20px);
+  border: 1px dashed var(--line); border-radius: var(--radius-sm); overflow: hidden;
+}
+.ad__frame iframe { border: 0; width: 100%; height: 90px; }
+[data-theme='dark'] .ad__frame { background: repeating-linear-gradient(45deg, #131318 0 10px, #0f0f13 10px 20px); }
+.ad--sidebar .ad__frame { max-width: 300px; min-height: 250px; }
+.ad--sidebar .ad__frame iframe { height: 250px; }
+.ad--sticky-mobile {
+  position: fixed; left: 0; right: 0; bottom: 0; z-index: 70; margin: 0;
+  background: var(--paper); border-top: 1px solid var(--line); padding: 6px 8px;
+  box-shadow: 0 -4px 16px rgba(0, 0, 0, .1);
+}
+.ad--sticky-mobile .ad__frame { max-width: 320px; min-height: 50px; margin: 0 auto; }
+.ad--sticky-mobile .ad__frame iframe { height: 50px; }
+.ad--sticky-mobile .ad__close {
+  position: absolute; right: 8px; top: 4px; background: none; border: 0; color: var(--muted);
+  font-size: 18px; line-height: 1; padding: 4px;
+}
+.ad--sticky-mobile.hidden { display: none; }
+.ad--inline .ad__frame { max-width: 100%; }
+.ad__creative { width: 100%; display: block; }
+.ad__creative img { width: 100%; border-radius: var(--radius-sm); }
+.ad__house {
+  width: 100%; max-width: 970px; display: flex; align-items: center; gap: 14px;
+  padding: 14px 16px; border: 1px solid var(--line); border-left: 4px solid var(--red);
+  border-radius: var(--radius-sm); background: var(--paper);
+}
+.ad__house h4 { margin: 0 0 2px; font-size: 16px; }
+.ad__house p { margin: 0; font-size: 13.5px; color: var(--text-2); }
+.ad__house .cta {
+  margin-left: auto; flex: none; background: var(--red); color: #fff;
+  padding: 8px 14px; border-radius: 999px; font-size: 13px; font-weight: 700;
+}
+.ad--sidebar .ad__house { flex-direction: column; align-items: flex-start; gap: 8px; max-width: 300px; }
+.ad--sidebar .ad__house .cta { margin-left: 0; }
+
+/* ------------------------------------------------------------ layout ----- */
+.layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 28px; padding: 22px 0 40px; }
+.layout--full { grid-template-columns: minmax(0, 1fr); }
+main { min-width: 0; }
+.sidebar { display: flex; flex-direction: column; gap: 22px; min-width: 0; }
+
+/* ------------------------------------------------------------- cards ----- */
+.section-head { display: flex; align-items: center; gap: 12px; margin: 30px 0 16px; }
+.section-head h2 {
+  margin: 0; font-size: 21px; position: relative; padding-left: 14px;
+}
+.section-head h2::before {
+  content: ''; position: absolute; left: 0; top: 6px; bottom: 6px; width: 5px;
+  background: var(--red); border-radius: 2px;
+}
+.section-head .more {
+  margin-left: auto; font-size: 13.5px; color: var(--red); font-weight: 700;
+}
+.section-head .more:hover { text-decoration: underline; }
+.badge-cat {
+  display: inline-block; background: var(--red); color: #fff;
+  padding: 2px 9px; border-radius: 4px; font-size: 12px; font-weight: 700; line-height: 1.6;
+}
+.badge-cat--dark { background: var(--ink); }
+.badge-live { background: var(--red); }
+.badge-video { background: #7c1d2b; }
+
+.grid { display: grid; gap: 18px; }
+.grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+.grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+
+.card {
+  background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius);
+  overflow: hidden; display: flex; flex-direction: column; transition: transform .18s, box-shadow .18s;
+}
+.card:hover { transform: translateY(-3px); box-shadow: var(--shadow-2); }
+.card__media { position: relative; aspect-ratio: 16 / 9; background: var(--paper-2); overflow: hidden; }
+.card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
+.card:hover .card__media img { transform: scale(1.05); }
+.card__media .placeholder {
+  position: absolute; inset: 0; display: grid; place-items: center;
+  background: linear-gradient(135deg, var(--ink-2), var(--red-700));
+  color: rgba(255, 255, 255, .55); font-family: var(--font-en); font-weight: 800; letter-spacing: .1em;
+}
+.card__play {
+  position: absolute; inset: 0; display: grid; place-items: center;
+  background: linear-gradient(to top, rgba(11, 11, 13, .6), transparent 60%);
+}
+.card__play span {
+  width: 48px; height: 48px; border-radius: 50%; background: rgba(225, 29, 46, .92);
+  display: grid; place-items: center; color: #fff; font-size: 18px;
+}
+.card__body { padding: 13px 14px 16px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
+.card__title { font-size: 17px; margin: 0; line-height: 1.45; }
+.card__title a:hover { color: var(--red); }
+.card__excerpt { font-size: 14px; color: var(--text-2); margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
+.card__meta { display: flex; align-items: center; gap: 10px; font-size: 12.5px; color: var(--muted); margin-top: auto; }
+.card__meta .dot { width: 3px; height: 3px; border-radius: 50%; background: currentColor; opacity: .5; }
+.chip-demo {
+  font-size: 11px; background: #fff4d6; color: #7a5600; border: 1px solid #f0d68a;
+  padding: 1px 7px; border-radius: 999px;
+}
+[data-theme='dark'] .chip-demo { background: #3a2f10; color: #f0d68a; border-color: #5c4a17; }
+
+/* --------------------------------------------------------- hero block ---- */
+.hero { display: grid; grid-template-columns: 1.65fr 1fr; gap: 18px; }
+.hero__lead {
+  position: relative; border-radius: var(--radius); overflow: hidden; min-height: 420px;
+  display: flex; align-items: flex-end; color: #fff; background: var(--ink);
+}
+.hero__lead img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
+.hero__lead::after {
+  content: ''; position: absolute; inset: 0;
+  background: linear-gradient(to top, rgba(6, 6, 8, .95) 4%, rgba(6, 6, 8, .55) 42%, rgba(6, 6, 8, .05) 78%);
+}
+.hero__lead .hero__content { position: relative; z-index: 1; padding: 26px; width: 100%; }
+.hero__lead h1 { font-size: 30px; margin: 10px 0 8px; line-height: 1.3; }
+.hero__lead h1 a:hover { color: #ffb3ba; }
+.hero__lead p { color: #d5d5dc; margin: 0; font-size: 15px; }
+.hero__side { display: grid; gap: 14px; grid-template-rows: repeat(2, 1fr); }
+.hero__side .card { flex-direction: row; align-items: stretch; }
+.hero__side .card__media { width: 38%; aspect-ratio: auto; flex: none; }
+.hero__side .card__body { padding: 12px 14px; }
+.hero__side .card__title { font-size: 16px; }
+
+/* ------------------------------------------------------- most read ------- */
+.ranked { list-style: none; margin: 0; padding: 0; counter-reset: rank; }
+.ranked li { counter-increment: rank; display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); }
+.ranked li:last-child { border-bottom: 0; }
+.ranked li::before {
+  content: counter(rank);
+  font-family: var(--font-en); font-weight: 800; font-size: 26px; line-height: 1;
+  color: var(--red); opacity: .85; flex: none; width: 30px;
+}
+.ranked a { font-size: 15px; line-height: 1.5; }
+.ranked a:hover { color: var(--red); }
+.ranked .meta { display: block; font-size: 12px; color: var(--muted); margin-top: 3px; }
+
+/* --------------------------------------------------------- widgets ------- */
+.widget { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
+.widget__head {
+  padding: 12px 14px; border-bottom: 1px solid var(--line); font-weight: 800; font-size: 16px;
+  display: flex; align-items: center; gap: 8px; background: var(--ink); color: #fff;
+}
+.widget__head .accent { color: var(--red); }
+.widget__body { padding: 14px; }
+.widget--sticky { position: sticky; top: 78px; }
+.tagcloud { display: flex; flex-wrap: wrap; gap: 8px; }
+.tagcloud a {
+  font-size: 13px; padding: 5px 11px; border: 1px solid var(--line); border-radius: 999px;
+  color: var(--text-2); transition: .15s;
+}
+.tagcloud a:hover { background: var(--red); color: #fff; border-color: var(--red); }
+
+/* ------------------------------------------------------- article page ---- */
+.progress { position: fixed; top: 0; left: 0; height: 3px; width: 0; background: var(--red); z-index: 90; transition: width .1s linear; }
+.article { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); padding: 26px 28px 34px; }
+.article__crumb { font-size: 13px; color: var(--muted); margin-bottom: 14px; display: flex; flex-wrap: wrap; gap: 6px; }
+.article__crumb a:hover { color: var(--red); }
+.article h1 { font-size: 32px; line-height: 1.32; margin-bottom: 12px; }
+.article__sub { font-size: 18px; color: var(--text-2); margin: 0 0 16px; }
+.article__meta {
+  display: flex; flex-wrap: wrap; align-items: center; gap: 12px; padding: 12px 0;
+  border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); font-size: 13.5px; color: var(--muted);
+}
+.article__author { display: flex; align-items: center; gap: 10px; }
+.article__author .avatar {
+  width: 38px; height: 38px; border-radius: 50%; background: var(--ink); color: #fff;
+  display: grid; place-items: center; font-weight: 700; font-size: 15px;
+}
+.article__author b { color: var(--text); display: block; font-size: 14.5px; }
+.article__hero { margin: 20px 0 8px; border-radius: var(--radius); overflow: hidden; }
+.article__hero img { width: 100%; }
+.article__caption { font-size: 13px; color: var(--muted); padding: 8px 2px 0; }
+.article__body { font-size: 17.5px; line-height: 1.95; color: var(--text); margin-top: 20px; }
+.article__body h2 { font-size: 23px; margin: 28px 0 12px; }
+.article__body h3 { font-size: 20px; margin: 24px 0 10px; }
+.article__body p { margin-bottom: 18px; }
+.article__body a { color: var(--red-700); text-decoration: underline; text-underline-offset: 3px; }
+[data-theme='dark'] .article__body a { color: #ff8a95; }
+.article__body blockquote {
+  margin: 22px 0; padding: 6px 20px; border-left: 4px solid var(--red);
+  background: var(--paper-2); font-size: 19px; line-height: 1.7; color: var(--text);
+}
+.article__body figure { margin: 24px 0; }
+.article__body figcaption { font-size: 13px; color: var(--muted); padding-top: 8px; }
+.article__body ul, .article__body ol { margin: 0 0 18px; }
+.article__body li { margin-bottom: 8px; }
+.article__body table { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: 15px; }
+.article__body th, .article__body td { border: 1px solid var(--line); padding: 9px 11px; text-align: left; }
+.article__body .demo-note {
+  background: #fff4d6; border: 1px solid #f0d68a; color: #6b4b00;
+  padding: 12px 14px; border-radius: var(--radius-sm); font-size: 14.5px; line-height: 1.7;
+}
+[data-theme='dark'] .article__body .demo-note { background: #3a2f10; color: #f0d68a; border-color: #5c4a17; }
+.article__body .note { font-size: 13.5px; color: var(--muted); font-style: italic; }
+.article__body iframe { width: 100%; aspect-ratio: 16 / 9; height: auto; border: 0; border-radius: var(--radius-sm); }
+.article__tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0 6px; }
+
+.correction-box {
+  background: #fff7f7; border: 1px solid #ffd6d9; border-left: 4px solid var(--red);
+  padding: 14px 16px; border-radius: var(--radius-sm); margin: 20px 0; font-size: 14.5px;
+}
+[data-theme='dark'] .correction-box { background: #2a1416; border-color: #5c2226; }
+.correction-box b { color: var(--red-700); }
+[data-theme='dark'] .correction-box b { color: #ff8a95; }
+
+.toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 22px 0; }
+.toolbar button, .toolbar a {
+  border: 1px solid var(--line); background: var(--paper); color: var(--text-2);
+  padding: 8px 13px; border-radius: 999px; font-size: 13.5px; font-weight: 600; transition: .15s;
+}
+.toolbar button:hover, .toolbar a:hover { border-color: var(--red); color: var(--red); }
+.toolbar .btn-like.is-liked { background: var(--red); border-color: var(--red); color: #fff; }
+.toolbar .font-ctl { display: inline-flex; gap: 4px; align-items: center; border: 1px solid var(--line); border-radius: 999px; padding: 4px 8px; }
+.toolbar .font-ctl button { border: 0; padding: 2px 6px; font-size: 14px; }
+.share-row { display: flex; gap: 8px; flex-wrap: wrap; }
+.share-row a { padding: 8px 12px; border-radius: 999px; font-size: 13px; color: #fff; font-weight: 600; }
+.share-row .fb { background: #1877f2; } .share-row .x { background: #0b0b0d; }
+.share-row .wa { background: #25d366; } .share-row .tg { background: #229ed9; }
+.share-row .cp { background: var(--ink-3); }
+
+.article[data-font='lg'] .article__body { font-size: 19.5px; }
+.article[data-font='sm'] .article__body { font-size: 16px; }
+
+/* ----------------------------------------------------------- comments ---- */
+.comments { margin-top: 34px; }
+.comment { border-top: 1px solid var(--line); padding: 14px 0; display: flex; gap: 12px; }
+.comment .avatar {
+  width: 36px; height: 36px; border-radius: 50%; background: var(--ink-2); color: #fff;
+  display: grid; place-items: center; font-weight: 700; flex: none; font-size: 14px;
+}
+.comment b { font-size: 14.5px; }
+.comment time { font-size: 12px; color: var(--muted); margin-left: 8px; }
+.comment p { margin: 4px 0 0; font-size: 15px; color: var(--text-2); }
+
+.form { display: grid; gap: 12px; }
+.form label { font-size: 13.5px; font-weight: 600; color: var(--text-2); }
+.form input, .form textarea, .form select {
+  width: 100%; padding: 11px 13px; border: 1px solid var(--line); border-radius: var(--radius-sm);
+  background: var(--paper); color: var(--text); font: inherit; font-size: 15px; transition: border-color .15s;
+}
+.form input:focus, .form textarea:focus, .form select:focus { border-color: var(--red); outline: none; }
+.form textarea { min-height: 110px; resize: vertical; }
+.btn {
+  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
+  background: var(--red); color: #fff; border: 0; padding: 11px 20px; border-radius: 999px;
+  font-weight: 700; font-size: 15px; transition: .15s;
+}
+.btn:hover { background: var(--red-600); }
+.btn[disabled] { opacity: .6; cursor: not-allowed; }
+.btn--ghost { background: transparent; color: var(--text); border: 1px solid var(--line); }
+.btn--ghost:hover { border-color: var(--red); color: var(--red); background: transparent; }
+.btn--dark { background: var(--ink); }
+.honeypot { position: absolute !important; left: -9999px !important; width: 1px; height: 1px; overflow: hidden; }
+.form-note { font-size: 12.5px; color: var(--muted); }
+.alert { padding: 11px 14px; border-radius: var(--radius-sm); font-size: 14px; margin: 12px 0; }
+.alert--ok { background: #e8f7ee; color: #0b5c30; border: 1px solid #b7e3c8; }
+.alert--err { background: #fdecec; color: #8a1420; border: 1px solid #f6c3c7; }
+[data-theme='dark'] .alert--ok { background: #0f2a1b; color: #8ee3b0; border-color: #1d4c31; }
+[data-theme='dark'] .alert--err { background: #2c1315; color: #ff9aa4; border-color: #5c2226; }
+
+/* --------------------------------------------------------- newsletter ---- */
+.newsletter {
+  background: linear-gradient(120deg, var(--ink) 0%, var(--ink-3) 55%, var(--red-700) 130%);
+  color: #fff; border-radius: var(--radius); padding: 26px; display: grid; gap: 14px;
+  grid-template-columns: 1fr auto; align-items: center; margin: 28px 0;
+}
+.newsletter h3 { font-size: 22px; margin: 0 0 6px; }
+.newsletter p { margin: 0; color: #c9c9d1; font-size: 14.5px; }
+.newsletter form { display: flex; gap: 8px; min-width: 300px; }
+.newsletter input {
+  flex: 1; padding: 12px 14px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, .2);
+  background: rgba(255, 255, 255, .08); color: #fff; font: inherit;
+}
+.newsletter input::placeholder { color: #a8a8b2; }
+
+/* -------------------------------------------------------------- poll ----- */
+.poll { display: grid; gap: 10px; }
+.poll__opt {
+  display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid var(--line);
+  border-radius: var(--radius-sm); background: var(--paper); cursor: pointer; font-size: 14.5px;
+  transition: .15s; position: relative; overflow: hidden;
+}
+.poll__opt:hover { border-color: var(--red); }
+.poll__opt .bar {
+  position: absolute; inset: 0 auto 0 0; background: rgba(225, 29, 46, .12); width: 0; transition: width .5s;
+}
+.poll__opt .pct { margin-left: auto; font-weight: 700; font-family: var(--font-en); font-size: 13px; }
+.poll__opt span { position: relative; }
+
+/* ------------------------------------------------------------- footer ---- */
+.footer { background: var(--ink); color: #b9bbc4; margin-top: 40px; padding: 44px 0 0; }
+.footer__grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1.2fr; gap: 30px; padding-bottom: 30px; }
+.footer h4 { color: #fff; font-size: 16px; margin-bottom: 14px; position: relative; padding-bottom: 8px; }
+.footer h4::after { content: ''; position: absolute; left: 0; bottom: 0; width: 32px; height: 3px; background: var(--red); border-radius: 2px; }
+.footer a { color: #b9bbc4; font-size: 14px; }
+.footer a:hover { color: var(--red); }
+.footer ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 9px; }
+.footer__about p { font-size: 14px; line-height: 1.8; }
+.socials { display: flex; gap: 9px; margin-top: 14px; }
+.socials a {
+  width: 36px; height: 36px; border-radius: 9px; border: 1px solid #2c2c34;
+  display: grid; place-items: center; color: #cfcfd6; transition: .15s; font-size: 14px;
+}
+.socials a:hover { background: var(--red); border-color: var(--red); color: #fff; }
+.footer__bottom {
+  border-top: 1px solid #23232b; padding: 16px 0; display: flex; flex-wrap: wrap;
+  gap: 12px; justify-content: space-between; font-size: 13px; color: #8b8d97;
+}
+
+/* ------------------------------------------------- AI assistant widget --- */
+.ai-fab {
+  position: fixed; right: 20px; bottom: 20px; z-index: 95;
+  width: 58px; height: 58px; border-radius: 50%; border: 0;
+  background: linear-gradient(145deg, var(--red) 0%, var(--red-700) 100%);
+  color: #fff; box-shadow: 0 8px 26px rgba(225, 29, 46, .45);
+  display: grid; place-items: center; transition: transform .18s, box-shadow .18s;
+}
+.ai-fab:hover { transform: translateY(-2px) scale(1.04); }
+.ai-fab svg { width: 26px; height: 26px; }
+.ai-fab__badge {
+  position: absolute; top: -2px; right: -2px; width: 18px; height: 18px; border-radius: 50%;
+  background: #fff; color: var(--red); font-size: 11px; font-weight: 800; display: grid; place-items: center;
+  border: 2px solid var(--red);
+}
+.ai-fab[hidden] { display: none; }
+
+.ai-panel {
+  position: fixed; right: 20px; bottom: 88px; z-index: 96;
+  width: min(392px, calc(100vw - 28px)); height: min(580px, calc(100vh - 130px));
+  background: var(--paper); border: 1px solid var(--line); border-radius: 16px;
+  box-shadow: 0 18px 60px rgba(11, 11, 13, .28); display: flex; flex-direction: column; overflow: hidden;
+  transform: translateY(12px) scale(.97); opacity: 0; pointer-events: none; transition: .2s;
+}
+.ai-panel[data-open='true'] { transform: none; opacity: 1; pointer-events: auto; }
+.ai-panel__head {
+  background: var(--ink); color: #fff; padding: 13px 15px; display: flex; align-items: center; gap: 11px;
+}
+.ai-panel__head .avatar {
+  width: 36px; height: 36px; border-radius: 10px; background: linear-gradient(145deg, var(--red), var(--red-700));
+  display: grid; place-items: center; flex: none;
+}
+.ai-panel__head b { display: block; font-size: 15px; }
+.ai-panel__head small { color: #9ea0a9; font-size: 11.5px; display: flex; align-items: center; gap: 5px; }
+.ai-panel__head small i { width: 6px; height: 6px; border-radius: 50%; background: #2ecc71; }
+.ai-panel__head .actions { margin-left: auto; display: flex; gap: 6px; }
+.ai-panel__head .actions button { background: none; border: 0; color: #b9bbc4; padding: 4px; border-radius: 6px; }
+.ai-panel__head .actions button:hover { color: #fff; background: rgba(255, 255, 255, .1); }
+.ai-panel__body { flex: 1; overflow-y: auto; padding: 15px; display: flex; flex-direction: column; gap: 12px; background: var(--paper-2); }
+.ai-msg { max-width: 86%; padding: 10px 13px; border-radius: 14px; font-size: 14.5px; line-height: 1.7; white-space: pre-wrap; word-break: break-word; }
+.ai-msg--bot { background: var(--paper); border: 1px solid var(--line); border-bottom-left-radius: 4px; align-self: flex-start; }
+.ai-msg--user { background: var(--red); color: #fff; border-bottom-right-radius: 4px; align-self: flex-end; }
+.ai-msg a { color: var(--red-700); text-decoration: underline; }
+[data-theme='dark'] .ai-msg a { color: #ff8a95; }
+.ai-msg--bot.typing::after { content: '▋'; animation: blink 1s steps(2) infinite; }
+@keyframes blink { 50% { opacity: 0; } }
+.ai-chips { display: flex; flex-wrap: wrap; gap: 7px; padding: 0 15px 10px; background: var(--paper-2); }
+.ai-chips button {
+  font-size: 12.5px; padding: 6px 11px; border-radius: 999px; border: 1px solid var(--line);
+  background: var(--paper); color: var(--text-2);
+}
+.ai-chips button:hover { border-color: var(--red); color: var(--red); }
+.ai-panel__foot { padding: 11px; border-top: 1px solid var(--line); background: var(--paper); }
+.ai-panel__foot form { display: flex; gap: 8px; }
+.ai-panel__foot textarea {
+  flex: 1; resize: none; border: 1px solid var(--line); border-radius: 999px; padding: 10px 14px;
+  font: inherit; font-size: 14.5px; max-height: 96px; background: var(--paper-2); color: var(--text);
+}
+.ai-panel__foot button {
+  width: 40px; height: 40px; border-radius: 50%; border: 0; background: var(--red); color: #fff;
+  display: grid; place-items: center; flex: none;
+}
+.ai-panel__foot button[disabled] { opacity: .5; }
+.ai-panel__lang { font-size: 11px; color: var(--muted); text-align: center; padding: 4px 0 0; }
+
+/* --------------------------------------------------------- back to top --- */
+.to-top {
+  position: fixed; right: 22px; bottom: 88px; z-index: 94; width: 42px; height: 42px;
+  border-radius: 50%; border: 1px solid var(--line); background: var(--paper); color: var(--text);
+  display: grid; place-items: center; box-shadow: var(--shadow-1); opacity: 0; pointer-events: none; transition: .2s;
+}
+.to-top[data-show='true'] { opacity: 1; pointer-events: auto; }
+body.ai-open .to-top { opacity: 0; pointer-events: none; }
+
+/* ------------------------------------------------------- pagination ------ */
+.pager { display: flex; gap: 6px; justify-content: center; margin: 30px 0; flex-wrap: wrap; }
+.pager a, .pager span {
+  min-width: 38px; height: 38px; padding: 0 10px; display: grid; place-items: center;
+  border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--paper); font-size: 14px;
+}
+.pager a:hover { border-color: var(--red); color: var(--red); }
+.pager .current { background: var(--red); border-color: var(--red); color: #fff; font-weight: 700; }
+
+/* ------------------------------------------------------- static pages ---- */
+.static-page, .error-page { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px 30px 36px; }
+.static-page h2 { font-size: 22px; margin: 26px 0 10px; }
+.static-page h3 { font-size: 18px; margin: 22px 0 8px; }
+.static-page p { font-size: 16.5px; line-height: 1.9; }
+
+/* ------------------------------------------------------- slot tables ----- */
+.slot-table { width: 100%; border-collapse: collapse; font-size: 14px; }
+.slot-table th, .slot-table td { border: 1px solid var(--line); padding: 10px 12px; text-align: left; }
+.slot-table th { background: var(--ink); color: #fff; font-weight: 600; }
+.slot-table tr:nth-child(even) td { background: var(--paper-2); }
+
+/* ------------------------------------------------------- video grid ------ */
+.video-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
+
+/* ------------------------------------------------------- responsive ------ */
+@media (max-width: 1200px) {
+  .layout { grid-template-columns: minmax(0, 1fr) 290px; gap: 22px; }
+  .grid--4, .video-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+}
+
+@media (max-width: 992px) {
+  .layout { grid-template-columns: minmax(0, 1fr); }
+  .sidebar { order: 2; }
+  .widget--sticky { position: static; }
+  .hero { grid-template-columns: 1fr; }
+  .hero__lead { min-height: 340px; }
+  .hero__side { grid-template-rows: none; grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .footer__grid { grid-template-columns: 1fr 1fr; }
+  .grid--3, .grid--4, .video-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .newsletter { grid-template-columns: 1fr; }
+  .newsletter form { min-width: 0; }
+  .article { padding: 22px 20px 30px; }
+  .article h1 { font-size: 27px; }
+}
+
+@media (max-width: 768px) {
+  :root { --header-h: 104px; }
+  .topstrip__links .optional { display: none; }
+  .masthead__search { display: none; }
+  .brand__name { font-size: 20px; }
+  .brand__mark { width: 38px; height: 38px; font-size: 13px; }
+  .burger { display: grid; place-items: center; }
+  .navbar__in { padding: 0 4px; }
+  .navbar a { padding: 12px 11px; font-size: 14px; }
+  .hero__side { grid-template-columns: 1fr; }
+  .hero__side .card__media { width: 34%; }
+  .grid--2, .grid--3, .grid--4, .video-grid { grid-template-columns: 1fr; }
+  .hero__lead h1 { font-size: 24px; }
+  .hero__lead { min-height: 300px; }
+  .article { padding: 18px 15px 26px; border-radius: 8px; }
+  .article h1 { font-size: 23px; }
+  .article__sub { font-size: 16px; }
+  .article__body { font-size: 16.5px; line-height: 1.9; }
+  .footer__grid { grid-template-columns: 1fr; gap: 22px; }
+  .footer { padding-top: 32px; }
+  .ai-panel { right: 8px; left: 8px; bottom: 8px; width: auto; height: min(72vh, 620px); border-radius: 14px; }
+  .ai-fab { right: 14px; bottom: 14px; width: 52px; height: 52px; }
+  .to-top { bottom: 76px; right: 14px; }
+  body.has-sticky-ad { padding-bottom: 62px; }
+  .section-head h2 { font-size: 19px; }
+}
+
+@media (max-width: 560px) {
+  .masthead__in { padding: 10px 0; gap: 10px; }
+  .brand__sub { display: none; }
+  .btn-admin { padding: 8px 12px; font-size: 13px; }
+  .ticker__label { padding: 0 11px; font-size: 12px; }
+  .ticker__track a { font-size: 13.5px; }
+  .newsletter { padding: 20px 16px; }
+  .newsletter form { flex-direction: column; }
+  .newsletter .btn { width: 100%; }
+  .toolbar { gap: 7px; }
+  .share-row a { padding: 7px 10px; font-size: 12px; }
+}
+
+/* --------------------------------------------------------- utilities ----- */
+.row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
+.between { justify-content: space-between; }
+.muted { color: var(--muted); }
+.small { font-size: 13px; }
+.center { text-align: center; }
+.mt { margin-top: 18px; } .mb { margin-bottom: 18px; }
+.hide-sm { display: initial; }
+@media (max-width: 768px) { .hide-sm { display: none !important; } .show-sm { display: block !important; } }
+.show-sm { display: none; }
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; scroll-behavior: auto !important; }
+  .ticker__track { animation: none; }
+  .ticker__viewport { overflow-x: auto; }
+}
+
+@media print {
+  .navbar, .topstrip, .ticker, .sidebar, .footer, .ai-fab, .ai-panel, .to-top, .ad, .toolbar, .share-row, .comments, .newsletter, .progress { display: none !important; }
+  body { background: #fff; color: #000; }
+  .article { border: 0; padding: 0; }
+  .article__body { font-size: 12pt; }
+}
+
+/* ============================================================================
+   2026 newsroom redesign — dark, red-accented, per the channel brand.
+   Appended last so these rules win the cascade. Dark is the default theme.
+   ========================================================================== */
+
+/* brand: circular red globe, "24" in red */
+.brand__mark { border-radius: 50%; width: 46px; height: 46px; }
+.brand__name em { color: var(--red); font-style: normal; }
+.brand__sub { text-transform: uppercase; letter-spacing: .14em; font-size: 10.5px; }
+
+/* masthead: logo | centered search | actions */
+.masthead__in { padding: 16px 0; }
+.masthead__search { flex: 1; max-width: 560px; margin: 0 auto; }
+.masthead__search input { width: 100%; background: #17171d; border-color: #2a2a33; }
+.masthead__search input:focus { width: 100%; box-shadow: 0 0 0 3px rgba(225, 29, 46, .22); }
+.signin { color: #d6d6dd; font-weight: 600; font-size: 14.5px; padding: 8px 4px; }
+.signin:hover { color: #fff; }
+.bell { position: relative; }
+.bell__dot { position: absolute; top: 7px; right: 8px; width: 7px; height: 7px; border-radius: 50%; background: var(--red); box-shadow: 0 0 0 2px #15151a; animation: pulse 1.8s infinite; }
+
+/* navbar: active item is a solid red pill; live button pinned right */
+.navbar { background: #101015; }
+.navbar a { border-bottom: 0; border-radius: 999px; padding: 9px 16px; margin: 7px 2px; }
+.navbar a:hover { background: rgba(225, 29, 46, .14); color: #fff; }
+.navbar a[aria-current='page'] { background: var(--red); color: #fff; }
+.navbar__home[aria-current='page'] { background: var(--red); }
+.navbar__live { margin-left: auto; background: var(--red); color: #fff; font-weight: 700; }
+.navbar__live:hover { background: var(--red-600); }
+
+/* ticker: dark bar, red chip label, date on the right */
+.ticker { background: #0d0d11; border-top: 1px solid #1f1f26; border-bottom: 1px solid #1f1f26; }
+.ticker__label { background: var(--red); border-radius: 4px; margin: 7px 12px 7px 14px; padding: 5px 12px; display: inline-flex; align-items: center; gap: 7px; }
+.ticker__label::after { content: none; }
+.ticker__track a { color: #e6e6ec; }
+.ticker__track .tag { background: rgba(225, 29, 46, .18); color: #ff9aa4; }
+.ticker__date { flex: none; padding: 0 16px; display: inline-flex; align-items: center; gap: 8px; color: #8b8e97; font-size: 13px; white-space: nowrap; border-left: 1px solid #22222a; }
+.ticker__date i { font-style: normal; color: var(--red); }
+
+/* hero side rail: three stacked compact cards */
+.hero__side { grid-template-rows: repeat(3, 1fr); }
+
+/* category filter pills */
+.pills { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 18px; }
+.pill {
+  font-size: 13.5px; font-weight: 600; padding: 6px 16px; border-radius: 999px;
+  border: 1px solid var(--line); color: var(--text-2); background: var(--paper); transition: .15s;
+}
+.pill:hover { border-color: var(--red); color: var(--red); }
+.pill--on { background: var(--red); border-color: var(--red); color: #fff; }
+
+/* trending: red square numerals */
+.ranked li { align-items: flex-start; }
+.ranked li::before {
+  content: counter(rank);
+  width: 30px; height: 30px; border-radius: 8px; flex: none;
+  background: linear-gradient(145deg, var(--red), var(--red-700)); color: #fff;
+  display: grid; place-items: center; font-size: 15px; opacity: 1; margin-top: 2px;
+}
+
+/* live TV widget */
+.live-widget {
+  position: relative; display: grid; gap: 6px; padding: 18px; border-radius: var(--radius);
+  background: linear-gradient(135deg, #1a0507 0%, var(--red-700) 120%);
+  border: 1px solid rgba(225, 29, 46, .4); color: #fff; overflow: hidden;
+}
+.live-widget::after {
+  content: ''; position: absolute; inset: 0;
+  background: radial-gradient(120% 90% at 100% 0%, rgba(225, 29, 46, .35), transparent 55%);
+  pointer-events: none;
+}
+.live-widget__badge {
+  justify-self: start; display: inline-flex; align-items: center; gap: 6px;
+  background: var(--red); padding: 3px 10px; border-radius: 4px; font-weight: 800; font-size: 12px; letter-spacing: .06em;
+}
+.live-widget__badge i { width: 7px; height: 7px; border-radius: 50%; background: #fff; animation: pulse 1.4s infinite; }
+.live-widget__play {
+  width: 54px; height: 54px; border-radius: 50%; background: rgba(255, 255, 255, .12);
+  border: 1px solid rgba(255, 255, 255, .28); display: grid; place-items: center;
+  font-size: 18px; margin: 8px 0 4px; backdrop-filter: blur(2px); transition: .18s;
+}
+.live-widget:hover .live-widget__play { background: var(--red); transform: scale(1.06); }
+.live-widget__title { font-weight: 800; font-size: 17px; }
+.live-widget__sub { color: #e8c9cc; font-size: 12.5px; }
+
+/* cards & widgets: subtle dark elevation to read like the mock */
+[data-theme='dark'] .card, [data-theme='dark'] .widget { background: #14141a; border-color: #23232b; }
+[data-theme='dark'] .card:hover { border-color: rgba(225, 29, 46, .45); }
+[data-theme='dark'] .pill { background: #14141a; }
